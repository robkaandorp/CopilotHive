@page "/releases/{ReleaseId}"
@using CopilotHive.Dashboard
@using CopilotHive.Goals
@using Markdig
@inject CopilotHive.Security.CircuitUserPrincipalAccessor CircuitPrincipal
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IReleaseFacade ReleaseFacade
@inject CopilotHive.Configuration.HiveConfigFile? HiveConfig
@inject PageHeaderState PageHeader
@using CopilotHive.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@* A DENIED OR FAILED READ is surfaced as a SAFE message and presents NOTHING that was previously
   loaded. "Release not found." below stays the NOT-FOUND answer only. *@
@if (!string.IsNullOrEmpty(_loadError))
{
    <p class="error-msg" style="margin-top:1rem">@_loadError</p>
}
else if (_release is not null)
{
    <!-- Header -->
    <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1rem">
        @foreach (var repo in _release.RepositoryNames)
        {
            <span class="repo-tag">@repo</span>
        }
        <span class="badge @ReleaseBadge(_release.Status)">@_release.Status</span>
        @if (_release.Status == ReleaseStatus.Planning)
        {
            <button class="approve-btn" @onclick="ValidateReleaseAsync" disabled="@_isValidating">
                @(_isValidating ? "Validating..." : "Validate")
            </button>
            <button class="approve-btn" @onclick="MarkAsReleased" disabled="@(!_isValid || _isReleasing)">
                ✅ Mark as Released
            </button>
            @if (!_isValid && _validationErrors.Count == 0 && !_isValidating && !_isReleasing)
            {
                <span style="color:var(--text-muted);font-size:0.8rem">↑ Click Validate first</span>
            }
            @if (_isReleasing)
            {
                <span style="color:var(--text-muted);font-size:0.85rem">Releasing...</span>
            }
            @if (_goals.Count == 0 && _release.ExecutionState != ReleaseExecutionState.Executing)
            {
                <button class="danger-btn" @onclick="DeleteReleaseAsync" disabled="@_isDeleting">
                    @(_isDeleting ? "Deleting..." : "🗑 Delete Release")
                </button>
                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <span class="error-msg" style="margin-left:0.5rem">@_deleteError</span>
                }
            }
        }
        else if (_release.Status == ReleaseStatus.Released)
        {
            <button class="danger-btn" disabled title="Cannot unrelease — git operations are irreversible">
                🔒 Unrelease
            </button>
            <span style="color:var(--text-muted);font-size:0.8rem">Git operations cannot be undone</span>
        }
    </div>

    @if (_validationErrors.Count > 0)
    {
        <div class="card" style="margin-top:0.5rem;border-color:var(--red)">
            <h3 style="color:var(--red)">Validation Issues</h3>
            <ul style="margin:0.5rem 0 0 0;padding-left:1.5rem">
                @foreach (var err in _validationErrors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @if (_isValid && _validationErrors.Count == 0)
    {
        <div class="card" style="margin-top:0.5rem;border-color:var(--green)">
            <span style="color:var(--green)">✅ Validation passed — ready to release</span>
        </div>
    }

    @if (_releaseResult is not null)
    {
        <div class="card" style="margin-top:1rem">
            <h3>Release Results</h3>
            <table style="width:100%;font-size:0.85rem;border-collapse:collapse">
                <thead>
                    <tr style="text-align:left;border-bottom:1px solid var(--border)">
                        <th style="padding:0.4rem">Repository</th>
                        <th style="padding:0.4rem">Status</th>
                        <th style="padding:0.4rem">Merged To</th>
                        <th style="padding:0.4rem">Merge SHA</th>
                        <th style="padding:0.4rem">Tag Branch</th>
                        <th style="padding:0.4rem">Tag Created</th>
                        <th style="padding:0.4rem">Error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _releaseResult.Results)
                    {
                        <tr style="border-bottom:1px solid var(--border)">
                            <td style="padding:0.4rem">@r.RepoName</td>
                            <td style="padding:0.4rem">
                                @if (r.Skipped) { <span style="color:var(--text-muted)">Skipped</span> }
                                else if (r.Success) { <span style="color:var(--green)">✓ Success</span> }
                                else { <span style="color:var(--red)">✗ Failed</span> }
                            </td>
                            <td style="padding:0.4rem">@(r.MergedTo ?? "—")</td>
                            <td style="padding:0.4rem;font-family:monospace;font-size:0.8rem">@(r.MergeSha?[..Math.Min(7, r.MergeSha.Length)] ?? "—")</td>
                            <td style="padding:0.4rem">@(r.TaggedBranch ?? "—")</td>
                            <td style="padding:0.4rem">@(r.TagCreated ? "✓" : "—")</td>
                            <td style="padding:0.4rem;color:var(--red)">@(r.Error ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_releaseError is not null)
    {
        <div class="card" style="margin-top:1rem;border-color:var(--red)">
            <h3 style="color:var(--red)">⚠️ Release Failed</h3>
            <p>@_releaseError</p>
            @if (_executionFailed)
            {
                <p style="color:var(--text-muted);font-size:0.85rem">
                    Tags created for previous repositories have been rolled back (attempted). Merges are NOT reverted.
                    The release remains in Planning status.
                </p>
            }
        </div>
    }

    <!-- Edit controls (Planning only) -->
    @if (_release.Status == ReleaseStatus.Planning)
    {
        <!-- Tag editor -->
        <div class="card" style="margin-bottom:1rem">
            <div class="label" style="margin-bottom:0.5rem">Tag</div>
            <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap">
                <input type="text" @bind="_editTag" style="flex:1;min-width:12rem;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.9rem;padding:0.4rem 0.6rem" placeholder="e.g. v1.2.0" />
                <button class="approve-btn" @onclick="SaveTag">Save Tag</button>
                @if (!string.IsNullOrEmpty(_tagError))
                {
                    <span class="error-msg">@_tagError</span>
                }
                @if (_tagSaved)
                {
                    <span style="color:var(--green);font-size:0.85rem">✓ Saved</span>
                }
            </div>
        </div>

        <!-- Repositories editor -->
        <div class="card" style="margin-bottom:1rem">
            <div class="label" style="margin-bottom:0.5rem">Repositories</div>
            <div style="display:flex;flex-direction:column;gap:0.4rem;margin-bottom:0.5rem">
                @foreach (var repo in _configuredRepoNames)
                {
                    <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer">
                        <input type="checkbox"
                               checked="@_selectedRepos.Contains(repo)"
                               @onchange="@(e => ToggleRepo(repo, (bool)(e.Value ?? false)))" />
                        <span>@repo</span>
                    </label>
                }
            </div>
            <div style="display:flex;gap:0.5rem;align-items:center;flex-wrap:wrap">
                <button class="approve-btn" @onclick="SaveRepositories">Save Repositories</button>
                @if (!string.IsNullOrEmpty(_repositoriesError))
                {
                    <span class="error-msg">@_repositoriesError</span>
                }
                @if (_repositoriesSaved)
                {
                    <span style="color:var(--green);font-size:0.85rem">✓ Saved</span>
                }
            </div>
        </div>
    }

    <!-- Metadata card -->
    <div class="card" style="margin-bottom:1rem;font-size:0.85rem;color:var(--text-muted)">
        <div style="display:flex;gap:1.5rem;flex-wrap:wrap">
            <span>Created: <strong style="color:var(--text)">@_release.CreatedAt.ToString("yyyy-MM-dd HH:mm")</strong> UTC</span>
            @if (_release.ReleasedAt.HasValue)
            {
                <span>Released: <strong style="color:var(--text)">@_release.ReleasedAt.Value.ToString("yyyy-MM-dd HH:mm")</strong> UTC</span>
            }
            <span>Goals: <strong style="color:var(--text)">@_goals.Count</strong></span>
        </div>
    </div>

    <!-- Editable Notes (Planning only) -->
    @if (_release.Status == ReleaseStatus.Planning)
    {
        <div class="card" style="margin-bottom:1rem">
            <div class="label" style="margin-bottom:0.5rem">Notes</div>
            <textarea @bind="_editNotes" rows="4"
                      style="width:100%;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.9rem;padding:0.5rem;font-family:inherit;resize:vertical"
                      placeholder="Release notes…"></textarea>
            <div style="margin-top:0.5rem;display:flex;gap:0.5rem">
                <button class="approve-btn" @onclick="SaveNotes">Save Notes</button>
                @if (!string.IsNullOrEmpty(_notesError))
                {
                    <span class="error-msg">@_notesError</span>
                }
                @if (_notesSaved)
                {
                    <span style="color:var(--green);font-size:0.85rem">✓ Saved</span>
                }
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_release.Notes))
    {
        <div class="card" style="margin-bottom:1rem">
            <div class="label" style="margin-bottom:0.5rem">Notes</div>
            <div class="chat-msg-content">@((MarkupString)RenderMarkdown(_release.Notes))</div>
        </div>
    }

    <!-- Goals grouped by scope -->
    @if (_goals.Count > 0)
    {
        var breaking = _goals.Where(g => g.Scope == GoalScope.Breaking).ToList();
        var features = _goals.Where(g => g.Scope == GoalScope.Feature).ToList();
        var patches = _goals.Where(g => g.Scope == GoalScope.Patch).ToList();

        <h2 style="margin-top:1rem;margin-bottom:0.75rem">Goals</h2>

        @if (breaking.Count > 0)
        {
            <div class="release-scope-section">
                <div class="release-scope-header">💥 Breaking Changes</div>
                @foreach (var g in breaking)
                {
                    <div class="release-goal-row">
                        <a href="/goals/@g.Id" class="goal-link">@g.Id</a>
                        <span class="goal-desc" style="flex:1">@Truncate(g.Description, 120)</span>
                        <span class="badge @StatusBadge(g.Status)">@g.Status</span>
                    </div>
                }
            </div>
        }

        @if (features.Count > 0)
        {
            <div class="release-scope-section">
                <div class="release-scope-header">✨ Features</div>
                @foreach (var g in features)
                {
                    <div class="release-goal-row">
                        <a href="/goals/@g.Id" class="goal-link">@g.Id</a>
                        <span class="goal-desc" style="flex:1">@Truncate(g.Description, 120)</span>
                        <span class="badge @StatusBadge(g.Status)">@g.Status</span>
                    </div>
                }
            </div>
        }

        @if (patches.Count > 0)
        {
            <div class="release-scope-section">
                <div class="release-scope-header">🔧 Fixes</div>
                @foreach (var g in patches)
                {
                    <div class="release-goal-row">
                        <a href="/goals/@g.Id" class="goal-link">@g.Id</a>
                        <span class="goal-desc" style="flex:1">@Truncate(g.Description, 120)</span>
                        <span class="badge @StatusBadge(g.Status)">@g.Status</span>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p style="color:var(--text-muted);margin-top:0.5rem">No goals assigned to this release yet.</p>
    }

    <!-- Changelog preview -->
    <h2 style="margin-top:1.5rem;margin-bottom:0.5rem">Changelog Preview</h2>
    <div style="display:flex;gap:0.5rem;margin-bottom:0.5rem">
        <button class="chat-action-btn" @onclick="CopyChangelog">📋 Copy Changelog</button>
    </div>
    <details class="collapsible-output" open>
        <summary>Markdown Changelog</summary>
        <div class="changelog-preview">
            <pre>@BuildChangelog()</pre>
        </div>
    </details>
}
else if (_loaded)
{
    <p style="color:var(--text-muted)">Release not found.</p>
}

@code {
    [Parameter] public string ReleaseId { get; set; } = "";

    private ReleaseDto? _release;
    private List<Goal> _goals = [];
    private bool _loaded;
    private string _editNotes = "";
    private bool _notesSaved;
    private string? _notesError;

    // Release validation / execution state
    private bool _isValid;
    private bool _isValidating;
    private List<string> _validationErrors = [];
    private ReleaseExecutionResultDto? _releaseResult;
    private string? _releaseError;
    private bool _isReleasing;
    private bool _executionFailed; // set only for 500 execution failures

    // Tag edit state
    private string _editTag = "";
    private bool _tagSaved;
    private string? _tagError;

    // Repositories edit state
    private HashSet<string> _selectedRepos = new(StringComparer.OrdinalIgnoreCase);
    private bool _repositoriesSaved;
    private string? _repositoriesError;

    // Delete state
    private bool _isDeleting;
    private string? _deleteError;

    /// <summary>
    /// A SAFE error/denial message for the INITIAL load. Empty while the release rendered normally and
    /// for a genuine <see cref="FacadeErrorKind.NotFound"/> (which keeps the page's own
    /// "Release not found." message); populated with the facade's sanitized text for a refusal or any
    /// other failed read, in which case NOTHING previously loaded is presented.
    /// </summary>
    private string? _loadError;

    /// <summary>
    /// The SANITIZED page error for a THROWN release-DETAIL read. A thrown store/facade exception's own
    /// message is never rendered — it can carry internal detail — so the page reports only that the read
    /// failed. Distinct from the goals text so the failing read site is identifiable.
    /// </summary>
    private const string ReleaseReadFailureMessage = "The release could not be loaded.";

    /// <summary>The SANITIZED page error for a THROWN goal-by-release read.</summary>
    private const string ReleaseGoalsReadFailureMessage = "The release's goals could not be loaded.";

    /// <summary>
    /// Monotonic generation of the detail read most recently STARTED. Only the newest read may publish
    /// the loaded state, so an older AUTHORIZED read that completes late can never restore content a
    /// newer denied/failed read (or a newer route parameter) already cleared.
    /// </summary>
    private int _loadGeneration;

    /// <summary>The release id the CURRENT load was started for, so a parameter reload is detected.</summary>
    private string? _loadedReleaseId;

    /// <summary>
    /// The circuit's cascading authentication state, handed to EVERY identity-aware facade call.
    /// ABSENT in open mode — <c>Program.cs</c> registers <c>AddCascadingAuthenticationState</c> only
    /// when authentication is enabled — in which case no cascade arrives, the helper yields a null
    /// identity and the resolver answers with the open-mode local operator, so backward
    /// compatibility is unchanged and nothing throws.
    /// </summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>
    /// The identity to hand to one identity-aware facade call: this circuit's authenticated
    /// principal, or null when no cascade exists (open mode / signed out). It is an IDENTITY only —
    /// the facade re-resolves current role/enabled state on every operation, so a demoted, disabled
    /// or deleted account is refused on its very next call. This is also the page's MINIMAL circuit
    /// identity acquisition: the scoped <see cref="CopilotHive.Security.CircuitUserPrincipalAccessor"/> is initialised
    /// from the same cascading state exactly once per circuit.
    /// </summary>
    private ValueTask<ClaimsPrincipal?> ActingUserAsync() =>
        ComponentActingUser.AcquireAsync(AuthenticationState, CircuitPrincipal);

    /// <summary>
    /// Loads on the FIRST parameter set and again whenever the route parameter changes, so a
    /// navigation from one release to another (or any reload that sets a different <see cref="ReleaseId"/>)
    /// starts from a CLEARED page rather than the previously loaded release, its goals, its validation
    /// and execution results and its edit state.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedReleaseId is not null && string.Equals(_loadedReleaseId, ReleaseId, StringComparison.Ordinal))
            return; // same release — the loaded state belongs to it

        await LoadAsync();
    }

    /// <summary>
    /// Loads this release and its goals through the AUTHORIZED <see cref="IReleaseFacade"/> reads, both
    /// of which re-resolve this circuit user's CURRENT role/enabled state and require shared read. A
    /// direct <c>IGoalStore</c> read would be an identity-free bypass of the covered release-read
    /// surface, and the configured-repository display comes from the in-memory <c>HiveConfig</c> — no
    /// <c>GlobalAdmin</c> config read is added to this shared-read page.
    /// <para>
    /// EVERY PREVIOUSLY RETAINED VALUE IS CLEARED FIRST (see <see cref="ClearDetailState"/>), so a
    /// parameter reload never renders the previous release while the new reads are in flight.
    /// </para>
    /// <para>
    /// A DENIED OR FAILED READ CLEARS EVERYTHING AGAIN and surfaces a SAFE error/denial message — never
    /// the misleading "Release not found." text, and never the retained release, goals or edit state.
    /// "Release not found." is kept for a genuine <see cref="FacadeErrorKind.NotFound"/>.
    /// </para>
    /// <para>
    /// THE SHARED HEADER IS CLEARED BEFORE THE AWAIT (see <see cref="SetNeutralHeader"/>), so a pending
    /// A → B reload never shows the previous release's tag, and a THROWN read from EITHER site is handled by
    /// <see cref="FailLoad"/>: the generation is re-checked so a stale throw cannot overwrite a newer load,
    /// and only the SANITIZED constant is published — never the exception's own message.
    /// </para>
    /// <para>
    /// PUBLICATION IS GENERATION-GUARDED: the generation is taken when the read STARTS and re-checked
    /// after every await, so an older read that completes late publishes nothing and cannot overwrite
    /// the newer denied/cleared state.
    /// </para>
    /// </summary>
    private async Task LoadAsync()
    {
        var generation = Interlocked.Increment(ref _loadGeneration);
        var decoded = Uri.UnescapeDataString(ReleaseId);
        _loadedReleaseId = decoded;

        // A reload starts from a CLEARED page: no previous release, goals or edit state may survive it.
        ClearDetailState();
        _loaded = false;

        // THE SHARED HEADER IS CLEARED BEFORE THE AWAIT TOO. The title is a SHARED, circuit-scoped state
        // the layout renders OUTSIDE this component, so clearing only the body would leave the PREVIOUS
        // release's tag on screen for the whole pending window of an A → B reload. A neutral,
        // non-tag title makes the pending window honest: nothing is claimed while nothing is loaded.
        SetNeutralHeader();

        // AUTHORIZED READS: both the release and its goals go through IReleaseFacade, which
        // re-resolves this circuit user's CURRENT role/enabled state on every call and requires
        // shared read.
        FacadeResult<ReleaseDto> releaseResult;
        try
        {
            releaseResult = await ReleaseFacade.GetReleaseAsync(
                decoded, await ActingUserAsync(), CancellationToken.None);
        }
        catch (OperationCanceledException)
        {
            // Cancellation is the CALLER'S outcome, never a load failure: it is not converted into one.
            throw;
        }
        catch (Exception)
        {
            // A THROWN read is a failure like any other: generation-aware clearing plus a SANITIZED
            // message. The exception's own text is never rendered.
            FailLoad(generation, ReleaseReadFailureMessage);
            return;
        }

        if (generation != _loadGeneration)
            return; // stale — a newer read owns the published state

        var release = releaseResult.Success ? releaseResult.Value : null;
        var goals = new List<Goal>();
        string? loadError = null;

        if (release is null)
        {
            // A genuine NOT FOUND keeps the page's own "Release not found." message; every other
            // failure (a FORBIDDEN refusal included) reports the facade's sanitized text instead of
            // claiming the release does not exist.
            loadError = releaseResult.Kind == FacadeErrorKind.NotFound
                ? null
                : releaseResult.Error ?? ReleaseReadFailureMessage;
        }
        else
        {
            FacadeResult<IReadOnlyList<Goal>> goalsResult;
            try
            {
                goalsResult = await ReleaseFacade.GetGoalsByReleaseAsync(
                    decoded, await ActingUserAsync(), CancellationToken.None);
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception)
            {
                FailLoad(generation, ReleaseGoalsReadFailureMessage);
                return;
            }

            if (generation != _loadGeneration)
                return; // stale — a newer read owns the published state

            if (!goalsResult.Success || goalsResult.Value is null)
            {
                // A refused/failed GOALS read clears the release too: the page must not present a
                // release whose goals it is not allowed to read.
                release = null;
                loadError = goalsResult.Error ?? ReleaseGoalsReadFailureMessage;
            }
            else
            {
                goals = goalsResult.Value.ToList();
            }
        }

        // PUBLISH — reached only when EVERY read succeeded, or with a fully cleared page.
        if (release is null)
        {
            ClearDetailState();
            _loadError = loadError;

            // The HEADER is honest too: only a genuine not-found says so; a refusal or another failure
            // announces an unavailable release, so no surface claims the release does not exist.
            PageHeader.SetTitle(loadError is null ? "Release Not Found" : "Release Unavailable");
            PageHeader.SetBack("/releases");
        }
        else
        {
            _release = release;
            _goals = goals;
            _loadError = null;
            _editNotes = release.Notes ?? "";
            _editTag = release.Tag;
            _selectedRepos = new HashSet<string>(release.RepositoryNames, StringComparer.OrdinalIgnoreCase);
            PageHeader.SetTitle($"📦 {release.Tag}");
            PageHeader.SetBack("/releases");
        }

        _loaded = true;
    }

    /// <summary>
    /// Applies ONE THROWN read failure to the page: the state is cleared and a SANITIZED message is
    /// published — but ONLY by the generation that is still active, so a stale throw cannot overwrite the
    /// newer load's state or its message.
    /// </summary>
    /// <param name="generation">The generation the failing read belongs to.</param>
    /// <param name="message">The sanitized page error to surface.</param>
    private void FailLoad(int generation, string message)
    {
        if (generation != _loadGeneration)
            return; // stale — a newer load owns the published state and its message

        ClearDetailState();
        _loadError = message;
        _loaded = true;

        // The header announces the failure and names NO release, so neither the previous release's tag
        // nor the requested one is claimed.
        PageHeader.SetTitle("Release Unavailable");
        PageHeader.SetBack("/releases");
    }

    /// <summary>
    /// Puts the SHARED page header into a neutral, non-tag state. Used before every load so a pending
    /// (or superseded) read cannot leave the PREVIOUS release's tag in the layout's header — which renders
    /// outside this component and would otherwise keep showing the old release for the whole window.
    /// </summary>
    private void SetNeutralHeader()
    {
        PageHeader.SetTitle("Release");
        PageHeader.SetBack("/releases");
    }

    /// <summary>
    /// Clears EVERY value this page retains from a load: the release, its goals, the notes/tag/
    /// repository edit state (and the "saved" flags), the validation and execution results, the
    /// per-operation errors and the load error. Called before a load and on a denied/failed read, so
    /// neither a parameter reload nor a refusal can present (or resurrect) previously loaded state.
    /// </summary>
    private void ClearDetailState()
    {
        _release = null;
        _goals = [];
        _editNotes = "";
        _editTag = "";
        _selectedRepos = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        _notesSaved = false;
        _notesError = null;
        _tagSaved = false;
        _tagError = null;
        _repositoriesSaved = false;
        _repositoriesError = null;
        _isValid = false;
        _validationErrors = [];
        _releaseResult = null;
        _releaseError = null;
        _executionFailed = false;
        _deleteError = null;
        _loadError = null;
    }

    private async Task ValidateReleaseAsync()
    {
        _isValidating = true;
        _isValid = false;
        _validationErrors = [];
        _releaseError = null;
        try
        {
            var result = await ReleaseFacade.ValidateReleaseAsync(
                _release!.Id, await ActingUserAsync(), CancellationToken.None);
            if (result.Success && result.Value is not null)
            {
                _isValid = result.Value.Valid;
                _validationErrors = result.Value.Errors.ToList();
            }
            else
            {
                _isValid = false;
                _validationErrors = ["Validation request failed."];
            }
        }
        catch
        {
            _isValid = false;
            _validationErrors = ["Validation request failed."];
        }
        finally
        {
            _isValidating = false;
        }
    }

    private async Task MarkAsReleased()
    {
        _isReleasing = true;
        _releaseError = null;
        _releaseResult = null;
        _executionFailed = false;
        _validationErrors = [];
        try
        {
            var outcome = await ReleaseFacade.UpdateReleaseStatusAsync(
                _release!.Id, new UpdateReleaseStatusRequest("Released"),
                await ActingUserAsync(), CancellationToken.None);
            switch (outcome)
            {
                case PlanningNoOpOutcome noOp:
                    _release = noOp.Release;
                    break;
                case ExecutionSuccessOutcome success:
                    _release = success.Release;
                    _releaseResult = success.Result;
                    break;
                case StatusFailureOutcome failure:
                    switch (failure.Kind)
                    {
                        case FacadeErrorKind.NotFound:
                        case FacadeErrorKind.BadRequest when failure.Errors.Length == 0:
                        case FacadeErrorKind.Conflict:
                            _releaseError = failure.Error;
                            break;
                        case FacadeErrorKind.BadRequest:
                            _validationErrors = failure.Errors.Select(e => e ?? "").ToList();
                            _isValid = false;
                            break;
                        case FacadeErrorKind.Internal:
                            _releaseResult = new ReleaseExecutionResultDto(
                                Success: false,
                                Results: failure.Results,
                                Error: failure.Detail,
                                Failure: ReleaseExecutionFailure.Execution);
                            _releaseError = failure.Detail ?? "Release failed.";
                            _executionFailed = true;
                            break;
                        case FacadeErrorKind.ServiceUnavailable:
                            _releaseError = failure.Detail;
                            break;
                        default:
                            throw new InvalidOperationException($"Unexpected release status failure kind: {failure.Kind}.");
                    }
                    break;
                default:
                    throw new InvalidOperationException($"Unexpected release status outcome: {outcome.GetType().Name}.");
            }
        }
        catch (Exception ex) { _releaseError = ex.Message; }
        finally { _isReleasing = false; }
    }

    private async Task DeleteReleaseAsync()
    {
        _deleteError = null;
        bool confirmed;
        try
        {
            confirmed = await JS.InvokeAsync<bool>("confirm",
                $"Are you sure you want to delete release '{_release?.Tag}' ({_release?.Id})? This cannot be undone.");
        }
        catch (Exception ex)
        {
            _deleteError = $"Failed to show confirmation dialog: {ex.Message}";
            return;
        }

        if (!confirmed) return;

        _isDeleting = true;
        try
        {
            var result = await ReleaseFacade.DeleteReleaseAsync(
                _release!.Id, await ActingUserAsync(), CancellationToken.None);
            if (result.Success)
            {
                Nav.NavigateTo("/releases");
            }
            else
            {
                _deleteError = result.Error ?? "";
            }
        }
        catch (Exception ex)
        {
            _deleteError = $"Failed to delete release: {ex.Message}";
        }
        finally
        {
            _isDeleting = false;
        }
    }

    private async Task SaveNotes()
    {
        _notesError = null;
        _notesSaved = false;
        var result = await ReleaseFacade.UpdateReleaseNotesAsync(
            ReleaseId, new UpdateReleaseNotesRequest(_editNotes), await ActingUserAsync());
        if (result.Success && result.Value is not null)
        {
            _release = result.Value;
            _notesSaved = true;
            _isValid = false;
            _validationErrors = [];
            StateHasChanged();
        }
        else
        {
            _notesError = result.Error ?? "";
        }
    }

    private async Task SaveTag()
    {
        _tagError = null;
        _tagSaved = false;
        if (string.IsNullOrWhiteSpace(_editTag))
        {
            _tagError = "Tag cannot be empty.";
            return;
        }
        var result = await ReleaseFacade.UpdateReleaseTagAsync(
            ReleaseId, new UpdateReleaseTagRequest(_editTag.Trim()), await ActingUserAsync());
        if (result.Success && result.Value is not null)
        {
            _release = result.Value;
            _tagSaved = true;
            _isValid = false;
            _validationErrors = [];
            PageHeader.SetTitle($"📦 {_release.Tag}");
            PageHeader.SetBack("/releases");
            StateHasChanged();
        }
        else
        {
            _tagError = result.Error ?? "";
        }
    }

    /// <summary>
    /// Combined list of repository names from config plus any orphaned repos
    /// that are in the release but not in the current HiveConfig.
    /// </summary>
    private IEnumerable<string> _configuredRepoNames =>
        (HiveConfig?.Repositories.Select(r => r.Name) ?? [])
            .Union(_release?.RepositoryNames.Where(r =>
                HiveConfig?.Repositories.All(c => !c.Name.Equals(r, StringComparison.OrdinalIgnoreCase)) ?? true) ?? [],
                StringComparer.OrdinalIgnoreCase);

    private void ToggleRepo(string repo, bool selected)
    {
        if (selected)
            _selectedRepos.Add(repo);
        else
            _selectedRepos.Remove(repo);
    }

    private async Task SaveRepositories()
    {
        _repositoriesError = null;
        _repositoriesSaved = false;
        var repos = _selectedRepos.ToList();
        var result = await ReleaseFacade.UpdateReleaseRepositoriesAsync(
            ReleaseId, new UpdateReleaseRepositoriesRequest(repos), await ActingUserAsync());
        if (result.Success && result.Value is not null)
        {
            _release = result.Value;
            _repositoriesSaved = true;
            _isValid = false;
            _validationErrors = [];
            StateHasChanged();
        }
        else
        {
            _repositoriesError = result.Error ?? "";
        }
    }

    private async Task CopyChangelog()
    {
        var changelog = BuildChangelog();
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", changelog);
    }

    private string BuildChangelog()
    {
        if (_release is null) return "";

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"## {_release.Tag}");
        sb.AppendLine();

        if (_release.ReleasedAt.HasValue)
            sb.AppendLine($"_Released {_release.ReleasedAt.Value:yyyy-MM-dd}_");
        else
            sb.AppendLine($"_Created {_release.CreatedAt:yyyy-MM-dd} · Status: {_release.Status}_");
        sb.AppendLine();

        var breaking = _goals.Where(g => g.Scope == GoalScope.Breaking).ToList();
        var features = _goals.Where(g => g.Scope == GoalScope.Feature).ToList();
        var patches = _goals.Where(g => g.Scope == GoalScope.Patch).ToList();

        if (breaking.Count > 0)
        {
            sb.AppendLine("### 💥 Breaking Changes");
            sb.AppendLine();
            foreach (var g in breaking)
                sb.AppendLine($"- {g.Description}");
            sb.AppendLine();
        }

        if (features.Count > 0)
        {
            sb.AppendLine("### ✨ Features");
            sb.AppendLine();
            foreach (var g in features)
                sb.AppendLine($"- {g.Description}");
            sb.AppendLine();
        }

        if (patches.Count > 0)
        {
            sb.AppendLine("### 🔧 Fixes");
            sb.AppendLine();
            foreach (var g in patches)
                sb.AppendLine($"- {g.Description}");
            sb.AppendLine();
        }

        if (!string.IsNullOrEmpty(_release.Notes))
        {
            sb.AppendLine("### Notes");
            sb.AppendLine();
            sb.AppendLine(_release.Notes);
        }

        return sb.ToString().TrimEnd();
    }

    private static string ReleaseBadge(ReleaseStatus s) => s switch
    {
        ReleaseStatus.Planning => "badge-yellow",
        ReleaseStatus.Released => "badge-green",
        _ => "badge-muted",
    };

    private static string StatusBadge(GoalStatus s) => s switch
    {
        GoalStatus.Completed => "badge-green",
        GoalStatus.Failed => "badge-red",
        GoalStatus.InProgress => "badge-blue",
        GoalStatus.Pending => "badge-yellow",
        GoalStatus.Cancelled => "badge-muted",
        _ => "badge-muted",
    };

    private static string Truncate(string s, int max) =>
        s.Length <= max ? s : s[..max] + "…";

    private static readonly MarkdownPipeline MdPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private static string RenderMarkdown(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return Markdown.ToHtml(content, MdPipeline);
    }
}
