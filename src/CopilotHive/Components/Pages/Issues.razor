@page "/issues"
@using CopilotHive.Dashboard
@using CopilotHive.Goals
@using CopilotHive.Services
@using Markdig
@using System.Text.Json
@inject IIssueFacade IssueFacade
@inject NavigationManager Nav
@inject PageHeaderState PageHeader

<!-- Filter Bar -->
<div class="filter-bar">
    <select @bind="_typeFilter" @bind:after="LoadIssues">
        <option value="">All types</option>
        <option value="code_quality">Code Quality</option>
        <option value="bug">Bug</option>
        <option value="suggestion">Suggestion</option>
        <option value="concern">Concern</option>
        <option value="workflow">Workflow</option>
    </select>

    <select @bind="_severityFilter" @bind:after="LoadIssues">
        <option value="">All severities</option>
        <option value="low">Low</option>
        <option value="medium">Medium</option>
        <option value="high">High</option>
    </select>

    <select @bind="_statusFilter" @bind:after="LoadIssues">
        <option value="">Active (excl. closed)</option>
        <option value="open">Open</option>
        <option value="triaged">Triaged</option>
        <option value="acknowledged">Acknowledged</option>
        <option value="in_progress">In Progress</option>
        <option value="resolved">Resolved</option>
        <option value="closed">Closed</option>
    </select>

    <input type="text" placeholder="Filter by repository…" @bind="_repoFilter" @bind:event="oninput" @bind:after="LoadIssues" />

    <span class="filter-count">@_issues.Count issue(s)</span>

    <button class="approve-btn" style="margin-left:auto" @onclick="() => _showCreateForm = !_showCreateForm">
        + New Issue
    </button>
</div>

<!-- Inline Create Form -->
@if (_showCreateForm)
{
    <div class="card" style="margin-bottom:1rem">
        <div class="label" style="margin-bottom:0.5rem">New Issue</div>
        <div style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:flex-end">
            <div>
                <div style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem">Type</div>
                <select @bind="_createType" style="padding:0.5rem 0.75rem;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.9rem">
                    @foreach (var t in Enum.GetValues<IssueType>())
                    {
                        <option value="@t">@t</option>
                    }
                </select>
            </div>
            <div>
                <div style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem">Title</div>
                <input type="text" placeholder="Short summary" @bind="_createTitle"
                       style="padding:0.5rem 0.75rem;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.9rem;min-width:220px" />
            </div>
            <div>
                <div style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem">Severity</div>
                <select @bind="_createSeverity" style="padding:0.5rem 0.75rem;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.9rem">
                    @foreach (var s in Enum.GetValues<IssueSeverity>())
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div>
                <div style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem">Repositories (comma-separated)</div>
                <input type="text" placeholder="e.g. CopilotHive, docs" @bind="_createRepos"
                       style="padding:0.5rem 0.75rem;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.9rem;min-width:200px" />
            </div>
        </div>
        <div style="margin-top:0.75rem">
            <div style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem">Description</div>
            <textarea @bind="_createDescription" placeholder="Detailed markdown description"
                      style="width:100%;min-height:100px;padding:0.5rem 0.75rem;background:var(--bg);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.9rem;font-family:inherit;resize:vertical"></textarea>
        </div>
        <div style="margin-top:0.75rem;display:flex;gap:0.5rem;align-items:center">
            <button class="approve-btn" @onclick="CreateIssue">Create</button>
            <button style="background:var(--bg-card);border:1px solid var(--border);color:var(--text-muted);padding:0.4rem 0.85rem;border-radius:6px;cursor:pointer;font-size:0.85rem"
                    @onclick="() => _showCreateForm = false">Cancel</button>
            @if (!string.IsNullOrEmpty(_createError))
            {
                <span class="error-msg">@_createError</span>
            }
        </div>
    </div>
}

<!-- Issues Table -->
@if (_issues.Count > 0)
{
    <div class="goals-table-wrap">
        <table class="goals-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Severity</th>
                    <th>Status</th>
                    <th>Repositories</th>
                    <th>Source</th>
                    <th>Created</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var issue in _issues)
                {
                    var isExpanded = _expandedIssueId == issue.Id;
                    <tr style="cursor:pointer" @onclick="() => ToggleDetail(issue.Id, issue)">
                        <td>
                            <div style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500" title="@issue.Title">@issue.Title</div>
                            <div style="max-width:300px;font-size:0.75rem;color:var(--text-muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@issue.Id</div>
                        </td>
                        <td><span class="badge @TypeBadge(issue.Type)">@issue.Type</span></td>
                        <td><span class="badge @SeverityBadge(issue.Severity)">@issue.Severity</span></td>
                        <td><span class="badge @StatusBadge(issue.Status)">@issue.Status</span></td>
                        <td>
                            @if (issue.RepositoryNames.Count > 0)
                            {
                                <div class="goal-repos">
                                    @foreach (var repo in issue.RepositoryNames)
                                    {
                                        <span class="repo-tag">@repo</span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span style="color:var(--text-muted)">—</span>
                            }
                        </td>
                        <td style="color:var(--text-muted);font-size:0.85rem">@FormatSource(issue)</td>
                        <td style="color:var(--text-muted);white-space:nowrap">@issue.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                    @if (isExpanded)
                    {
                        <tr>
                            <td colspan="7" style="background:var(--bg);padding:1rem">
                                <!-- Triage controls -->
                                <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:0.75rem;align-items:flex-end">
                                    <div>
                                        <div style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem">Status</div>
                                        <select @bind="_editStatus" @bind:after="() => UpdateStatus(issue)"
                                                style="padding:0.4rem 0.6rem;background:var(--bg-card);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.85rem">
                                            @foreach (var s in Enum.GetValues<IssueStatus>())
                                            {
                                                <option value="@ToSnakeCase(s)">@s</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <div style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem">Severity</div>
                                        <select @bind="_editSeverity" @bind:after="() => UpdateSeverity(issue)"
                                                style="padding:0.4rem 0.6rem;background:var(--bg-card);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.85rem">
                                            @foreach (var s in Enum.GetValues<IssueSeverity>())
                                            {
                                                <option value="@ToSnakeCase(s)">@s</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <div style="font-size:0.8rem;color:var(--text-muted);margin-bottom:0.25rem">Type</div>
                                        <select @bind="_editType" @bind:after="() => UpdateType(issue)"
                                                style="padding:0.4rem 0.6rem;background:var(--bg-card);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.85rem">
                                            @foreach (var t in Enum.GetValues<IssueType>())
                                            {
                                                <option value="@ToSnakeCase(t)">@t</option>
                                            }
                                        </select>
                                    </div>
                                    <div style="margin-left:auto">
                                        <button class="danger-btn" @onclick="() => DeleteIssue(issue)">🗑 Delete</button>
                                    </div>
                                </div>

                                @if (_errors.TryGetValue(issue.Id, out var error))
                                {
                                    <span class="error-msg" style="margin-bottom:0.5rem">@error</span>
                                }

                                <!-- Issue details -->
                                <div style="font-size:0.95rem;font-weight:600;margin-bottom:0.5rem">@issue.Title</div>
                                <div class="chat-msg-content" style="margin-bottom:0.75rem">
                                    @((MarkupString)RenderMarkdown(issue.Description))
                                </div>
                                <div style="display:flex;flex-wrap:wrap;gap:0.5rem 1.5rem;font-size:0.8rem;color:var(--text-muted)">
                                    <span><strong>ID:</strong> @issue.Id</span>
                                    <span><strong>Type:</strong> @issue.Type</span>
                                    <span><strong>Severity:</strong> @issue.Severity</span>
                                    <span><strong>Status:</strong> @issue.Status</span>
                                    @if (issue.RepositoryNames.Count > 0)
                                    {
                                        <span><strong>Repositories:</strong> @string.Join(", ", issue.RepositoryNames)</span>
                                    }
                                    @if (issue.SourceGoalId is not null)
                                    {
                                        <span><strong>Source Goal:</strong> <a href="/goals/@Uri.EscapeDataString(issue.SourceGoalId)">@issue.SourceGoalId</a></span>
                                    }
                                    @if (!string.IsNullOrEmpty(issue.SourceRole))
                                    {
                                        <span><strong>Source Role:</strong> @issue.SourceRole</span>
                                    }
                                    @if (issue.SourceIteration.HasValue)
                                    {
                                        <span><strong>Source Iteration:</strong> @issue.SourceIteration.Value</span>
                                    }
                                    <span><strong>Created:</strong> @issue.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                                    @if (issue.UpdatedAt.HasValue)
                                    {
                                        <span><strong>Updated:</strong> @issue.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                    }
                                    @if (issue.ResolvedAt.HasValue)
                                    {
                                        <span><strong>Resolved:</strong> @issue.ResolvedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
                                    }
                                    @if (!string.IsNullOrEmpty(issue.LinkedGoalId))
                                    {
                                        <span><strong>Linked Goal:</strong> <a href="/goals/@Uri.EscapeDataString(issue.LinkedGoalId)">@issue.LinkedGoalId</a></span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
else if (_loaded)
{
    <p style="color:var(--text-muted);margin-top:1rem">No issues found.</p>
}

@code {
    private List<LinkedIssueDto> _issues = [];
    private string _typeFilter = "";
    private string _severityFilter = "";
    private string _statusFilter = "";
    private string _repoFilter = "";
    private string? _expandedIssueId;
    private string _editStatus = "";
    private string _editSeverity = "";
    private string _editType = "";
    private readonly Dictionary<string, string> _errors = new(StringComparer.Ordinal);
    private bool _showCreateForm;
    private string _createError = "";
    private bool _loaded;
    private int _loadGeneration;

    private IssueType _createType = IssueType.Suggestion;
    private string _createTitle = "";
    private string _createDescription = "";
    private IssueSeverity _createSeverity = IssueSeverity.Low;
    private string _createRepos = "";

    protected override async Task OnInitializedAsync()
    {
        PageHeader.SetTitle("🐛 Issues");
        await LoadIssues();
    }

    private async Task LoadIssues()
    {
        var generation = Interlocked.Increment(ref _loadGeneration);
        var result = await IssueFacade.GetIssuesAsync(new IssueFilter(
            Status: string.IsNullOrEmpty(_statusFilter) ? null : _statusFilter,
            Type: string.IsNullOrEmpty(_typeFilter) ? null : _typeFilter,
            Severity: string.IsNullOrEmpty(_severityFilter) ? null : _severityFilter,
            Repository: string.IsNullOrEmpty(_repoFilter) ? null : _repoFilter), CancellationToken.None);
        if (result.Success)
        {
            var issues = result.Value!.ToList();
            if (generation != _loadGeneration)
                return; // stale — discard
            if (string.IsNullOrEmpty(_statusFilter))
                issues = issues.Where(i => i.Status != IssueStatus.Closed).ToList();
            _issues = issues;
            _loaded = true;
            if (_expandedIssueId is not null)
            {
                var issue = _issues.FirstOrDefault(i => i.Id == _expandedIssueId);
                if (issue is not null)
                {
                    _editStatus = ToSnakeCase(issue.Status);
                    _editSeverity = ToSnakeCase(issue.Severity);
                    _editType = ToSnakeCase(issue.Type);
                }
            }
        }
    }

    private void ToggleDetail(string id, LinkedIssueDto issue)
    {
        _expandedIssueId = _expandedIssueId == id ? null : id;
        if (_expandedIssueId is not null)
        {
            _editStatus = ToSnakeCase(issue.Status);
            _editSeverity = ToSnakeCase(issue.Severity);
            _editType = ToSnakeCase(issue.Type);
        }
    }

    private async Task UpdateStatus(LinkedIssueDto issue)
        => await UpdateField(issue, "status", _editStatus);

    private async Task UpdateSeverity(LinkedIssueDto issue)
        => await UpdateField(issue, "severity", _editSeverity);

    private async Task UpdateType(LinkedIssueDto issue)
        => await UpdateField(issue, "type", _editType);

    private async Task UpdateField(LinkedIssueDto issue, string field, string newValue)
    {
        _errors.Remove(issue.Id);

        UpdateIssueRequest request;
        try
        {
            request = field switch
            {
                "status" => new UpdateIssueRequest(Status: ParseSnakeCase<IssueStatus>(newValue)),
                "severity" => new UpdateIssueRequest(Severity: ParseSnakeCase<IssueSeverity>(newValue)),
                "type" => new UpdateIssueRequest(Type: ParseSnakeCase<IssueType>(newValue)),
                _ => throw new InvalidOperationException($"Unknown field: {field}"),
            };
        }
        catch (ArgumentException)
        {
            _errors[issue.Id] = $"Invalid {field} value: {newValue}";
            return;
        }

        var result = await IssueFacade.UpdateIssueAsync(issue.Id, request, CancellationToken.None);
        if (result.Success)
        {
            // Re-query with the active filters so the list only shows issues
            // that still match (e.g. triaging an open issue to resolved while
            // filtering by status=open must remove it from the view).
            await LoadIssues();

            if (_expandedIssueId == issue.Id)
            {
                var refreshed = _issues.FirstOrDefault(i => i.Id == issue.Id);
                if (refreshed is not null)
                {
                    _editStatus = ToSnakeCase(refreshed.Status);
                    _editSeverity = ToSnakeCase(refreshed.Severity);
                    _editType = ToSnakeCase(refreshed.Type);
                }
            }
        }
        else
        {
            _errors[issue.Id] = result.Error ?? "";

            if (_expandedIssueId == issue.Id)
            {
                var current = _issues.FirstOrDefault(i => i.Id == issue.Id);
                if (current is not null)
                {
                    _editStatus = ToSnakeCase(current.Status);
                    _editSeverity = ToSnakeCase(current.Severity);
                    _editType = ToSnakeCase(current.Type);
                }
            }
        }
    }

    private async Task DeleteIssue(LinkedIssueDto issue)
    {
        _errors.Remove(issue.Id);
        var result = await IssueFacade.DeleteIssueAsync(issue.Id, CancellationToken.None);
        if (result.Success)
        {
            _issues.RemoveAll(i => i.Id == issue.Id);
            if (_expandedIssueId == issue.Id)
                _expandedIssueId = null;
        }
        else
        {
            _errors[issue.Id] = result.Error ?? "";
        }
    }

    private async Task CreateIssue()
    {
        _createError = "";
        if (string.IsNullOrWhiteSpace(_createTitle))
        {
            _createError = "Title is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_createDescription))
        {
            _createError = "Description is required.";
            return;
        }

        var result = await IssueFacade.CreateIssueAsync(new CreateIssueRequest(
            Id: null,
            Type: _createType,
            Title: _createTitle.Trim(),
            Description: _createDescription,
            Severity: _createSeverity,
            RepositoryNames: _createRepos
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList()), CancellationToken.None);
        if (result.Success)
        {
            // Re-query with the active filters so the created issue only appears
            // if it matches the current filter state (e.g. creating a low/suggestion
            // issue while filtering by high/bug must not show it).
            await LoadIssues();
            _createTitle = "";
            _createDescription = "";
            _createRepos = "";
            _createType = IssueType.Suggestion;
            _createSeverity = IssueSeverity.Low;
            _showCreateForm = false;
        }
        else
        {
            _createError = result.Error ?? "";
        }
    }

    private static string FormatSource(LinkedIssueDto issue)
    {
        if (issue.SourceGoalId is null) return "—";
        var parts = new List<string> { issue.SourceGoalId };
        if (!string.IsNullOrEmpty(issue.SourceRole)) parts.Add(issue.SourceRole);
        if (issue.SourceIteration.HasValue) parts.Add($"iter {issue.SourceIteration.Value}");
        return string.Join(" · ", parts);
    }

    private static string ToSnakeCase<T>(T value) where T : struct, Enum =>
        JsonSerializer.Serialize(value, ReasoningEffortOptions.JsonOptions).Trim('"');

    private static T ParseSnakeCase<T>(string value) where T : struct, Enum =>
        Enum.Parse<T>(value.Replace("_", ""), ignoreCase: true);

    private static string TypeBadge(IssueType t) => t switch
    {
        IssueType.Bug => "badge-red",
        IssueType.CodeQuality => "badge-blue",
        IssueType.Suggestion => "badge-green",
        IssueType.Concern => "badge-yellow",
        IssueType.Workflow => "badge-muted",
        _ => "badge-muted",
    };

    private static string SeverityBadge(IssueSeverity s) => s switch
    {
        IssueSeverity.High => "badge-red",
        IssueSeverity.Medium => "badge-yellow",
        IssueSeverity.Low => "badge-muted",
        _ => "badge-muted",
    };

    private static string StatusBadge(IssueStatus s) => s switch
    {
        IssueStatus.Open => "badge-yellow",
        IssueStatus.Triaged => "badge-blue",
        IssueStatus.Acknowledged => "badge-muted",
        IssueStatus.InProgress => "badge-blue",
        IssueStatus.Resolved => "badge-green",
        IssueStatus.Closed => "badge-muted",
        _ => "badge-muted",
    };

    private static readonly MarkdownPipeline MdPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private static string RenderMarkdown(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return Markdown.ToHtml(content, MdPipeline);
    }
}
