            return;
        }
        try
        {
            var branch = string.IsNullOrWhiteSpace(_newRepoDefaultBranch) ? "main" : _newRepoDefaultBranch;
            ReleaseRepoConfig? release = null;
            if (!string.IsNullOrWhiteSpace(_newRepoMergeTo) || !string.IsNullOrWhiteSpace(_newRepoTagBranch))
            {
                release = new ReleaseRepoConfig
                {
                    MergeTo = string.IsNullOrWhiteSpace(_newRepoMergeTo) ? null : _newRepoMergeTo,
                    TagBranch = string.IsNullOrWhiteSpace(_newRepoTagBranch) ? null : _newRepoTagBranch,
                };
            }
            var result = await ConfigFacade.AddRepositoryAsync(new RepositoryRequest(
                Name: _newRepoName,
                Url: _newRepoUrl,
                DefaultBranch: branch,
                Release: release,
                MonitorCi: _newRepoMonitorCi,
                CiTimeoutMinutes: _newRepoMonitorCi ? _newRepoCiTimeout : (int?)null));
            if (result.Success)
            {
                _newRepoName = ""; _newRepoUrl = ""; _newRepoDefaultBranch = "main"; _newRepoMergeTo = ""; _newRepoTagBranch = "";
                _newRepoMonitorCi = false; _newRepoCiTimeout = 30;
                _showAddRepoForm = false;
                await LoadRepositoriesAsync();
                _repoSuccess = "✅ Repository added and cloned";
                await Task.Delay(3000);
                _repoSuccess = null;
            }
            else
            {
                _repoError = $"Add failed: {result.Error}";
            }
        }
        catch (Exception ex)
        {
            _repoError = $"Add failed: {ex.Message}";
        }
        finally { _repoSaving = false; StateHasChanged(); }
    }

    private async Task StartEditRepo(RepositoryDto repo)
    {
        _editingRepoName = repo.Name;
        _editRepoUrl = repo.Url;
        _editRepoDefaultBranch = repo.DefaultBranch;
        _editRepoMergeTo = repo.Release?.MergeTo ?? "";
        _editRepoTagBranch = repo.Release?.TagBranch ?? "";
        _editRepoMonitorCi = repo.MonitorCi;
        _editRepoCiTimeout = repo.CiTimeoutMinutes == 0 ? 30 : repo.CiTimeoutMinutes;
        _repoError = null; _repoSuccess = null;

        _repoBranches = null;
        _loadingBranches = true;
        _branchLoadError = false;
        _branchFetchCts?.Cancel();
        _branchFetchCts?.Dispose();
        _branchFetchCts = new CancellationTokenSource();
        var token = _branchFetchCts.Token;
        var generation = ++_branchFetchGeneration;
        try
        {
            // The repository routes never unescaped the name, so the facade receives it raw.
            var result = await ConfigFacade.GetBranchesAsync(repo.Name, token);
            if (generation == _branchFetchGeneration)
            {
                if (result.Success)
                {
                    _repoBranches = result.Value?.ToList();
                }
                else if (!token.IsCancellationRequested)
                {
                    // A cancelled fetch is a stale request and must stay silent — the facade
                    // reports cancellation as a failed result instead of throwing, so the token
                    // is what distinguishes "superseded" from a real failure.
                    _branchLoadError = true;
                }
            }
        }
        catch (OperationCanceledException) { /* stale request */ }
        catch
        {
            if (generation == _branchFetchGeneration)
                _branchLoadError = true;
        }
        finally
        {
            if (generation == _branchFetchGeneration)
                _loadingBranches = false;
        }
    }

    private void CancelEditRepo()
    {
        _branchFetchCts?.Cancel();
        _branchFetchCts?.Dispose();
        _branchFetchCts = null;
        _editingRepoName = null;
    }

    private async Task SaveEditRepoAsync()
    {
        if (_editingRepoName is null) return;
        _repoSaving = true;
        _repoError = null;
        _repoSuccess = null;
        try
        {
            var branch = string.IsNullOrWhiteSpace(_editRepoDefaultBranch) ? "main" : _editRepoDefaultBranch;
            // Always send a non-null release object on the edit path so clearing both
            // fields replaces (and removes) any existing release config. UpdateRepositoryAsync
            // normalizes an empty object to null, effectively disabling release automation.
            var release = new ReleaseRepoConfig
            {
                MergeTo = string.IsNullOrWhiteSpace(_editRepoMergeTo) ? null : _editRepoMergeTo,
                TagBranch = string.IsNullOrWhiteSpace(_editRepoTagBranch) ? null : _editRepoTagBranch,
            };
            var result = await ConfigFacade.UpdateRepositoryAsync(_editingRepoName, new RepositoryRequest(
                Name: _editingRepoName,
                Url: _editRepoUrl,
                DefaultBranch: branch,
                Release: release,
                MonitorCi: _editRepoMonitorCi,
                CiTimeoutMinutes: _editRepoMonitorCi ? _editRepoCiTimeout : (int?)null));
            if (result.Success)
            {
                _editingRepoName = null;
                await LoadRepositoriesAsync();
                _repoSuccess = "✅ Repository updated";
                await Task.Delay(3000);
                _repoSuccess = null;
            }
            else
            {
