                    </div>

                    <div style="margin-top:1.5rem;padding:1rem 1.25rem;background:var(--bg-card);border:1px solid var(--border);border-radius:6px;max-width:600px">
                        <h3 style="font-size:1rem;font-weight:600;margin-bottom:0.75rem">Event Notifications</h3>
                        <div style="display:grid;grid-template-columns:14rem 1fr;gap:0.75rem 1rem;align-items:center">
                            <label style="color:var(--text-muted);font-size:0.9rem">Mode</label>
                            <select @bind="_composerNotifMode"
                                    style="padding:0.5rem 0.75rem;background:var(--bg-card);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.9rem;cursor:pointer;width:100%">
                                <option value="passive">Passive</option>
                                <option value="active">Active</option>
                                <option value="off">Off</option>
                            </select>

                            <label style="color:var(--text-muted);font-size:0.9rem">Throttle (seconds)</label>
                            <input type="number" min="1" max="300" @bind="_composerNotifThrottle"
                                   style="padding:0.5rem 0.75rem;background:var(--bg-card);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:0.9rem;width:100%" />

                            <label style="color:var(--text-muted);font-size:0.9rem">Active Events</label>
                            <div style="display:flex;flex-direction:column;gap:0.4rem">
                                <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;cursor:pointer">
                                    <input type="checkbox" checked="@_composerNotifActiveEvents.Contains("goal_completed")"
                                           @onchange='(e) => ToggleComposerNotifEvent("goal_completed", (bool)(e.Value ?? false))' />
                                    Goal Completed
                                </label>
                                <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;cursor:pointer">
                                    <input type="checkbox" checked="@_composerNotifActiveEvents.Contains("goal_failed")"
                                           @onchange='(e) => ToggleComposerNotifEvent("goal_failed", (bool)(e.Value ?? false))' />
                                    Goal Failed
                                </label>
                                <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;cursor:pointer">
                                    <input type="checkbox" checked="@_composerNotifActiveEvents.Contains("ci_failed")"
                                           @onchange='(e) => ToggleComposerNotifEvent("ci_failed", (bool)(e.Value ?? false))' />
                                    CI Failed
                                </label>
                                <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;cursor:pointer">
                                    <input type="checkbox" checked="@_composerNotifActiveEvents.Contains("issue_raised")"
                                           @onchange='(e) => ToggleComposerNotifEvent("issue_raised", (bool)(e.Value ?? false))' />
                                    Issue Raised
                                </label>
                                <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;cursor:pointer">
                                    <input type="checkbox" checked="@_composerNotifActiveEvents.Contains("package_published")"
                                           @onchange='(e) => ToggleComposerNotifEvent("package_published", (bool)(e.Value ?? false))' />
                                    Package Published
                                </label>
                                <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;cursor:pointer">
                                    <input type="checkbox" checked="@_composerNotifActiveEvents.Contains("ci_succeeded")"
                                           @onchange='(e) => ToggleComposerNotifEvent("ci_succeeded", (bool)(e.Value ?? false))' />
                                    CI Succeeded
                                </label>
                                <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;cursor:pointer">
                                    <input type="checkbox" checked="@_composerNotifActiveEvents.Contains("release_completed")"
                                           @onchange='(e) => ToggleComposerNotifEvent("release_completed", (bool)(e.Value ?? false))' />
                                    Release Completed
                                </label>
                                <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;cursor:pointer">
                                    <input type="checkbox" checked="@_composerNotifActiveEvents.Contains("goal_dispatched")"
                                           @onchange='(e) => ToggleComposerNotifEvent("goal_dispatched", (bool)(e.Value ?? false))' />
                                    Goal Dispatched
                                </label>
                                <label style="display:flex;align-items:center;gap:0.5rem;font-size:0.9rem;cursor:pointer">
                                    <input type="checkbox" checked="@_composerNotifActiveEvents.Contains("issue_resolved")"
                                           @onchange='(e) => ToggleComposerNotifEvent("issue_resolved", (bool)(e.Value ?? false))' />
                                    Issue Resolved
                                </label>
                                @if (_composerNotifActiveEvents.Count == 0)
                                {
                                    <span style="color:var(--red);font-size:0.8rem">At least one active event is required.</span>
                                }
                                <div style="display:flex;gap:0.75rem;margin-top:0.25rem">
                                    <button class="approve-btn" style="padding:0.25rem 0.75rem;font-size:0.8rem"
                                            @onclick="() => ApplyActiveEventPreset(ActiveEventPresets.AutopilotEvents)">
                                        Autopilot
                                    </button>
                                    <button class="approve-btn" style="padding:0.25rem 0.75rem;font-size:0.8rem"
                                            @onclick="() => ApplyActiveEventPreset(ActiveEventPresets.NormalEvents)">
                                        Normal
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="margin-top:1.25rem;display:flex;align-items:center;gap:1rem">
                        <button class="approve-btn" disabled="@_composerSaving" @onclick="SaveComposerAsync">
                            @(_composerSaving ? "Saving…" : "💾 Save")
                        </button>
                        @if (_composerSaveSuccess is not null)
                        {
                            <span style="color:var(--accent);font-size:0.9rem">@_composerSaveSuccess</span>
                        }
                        @if (_composerSaveError is not null)
                        {
                            <span style="color:var(--red);font-size:0.9rem">@_composerSaveError</span>
                        }
                    </div>
                }
            </div>
        }
        else if (ActiveTab?.EndsWith(".md") == true)
        {
            <div class="config-markdown">
                @((MarkupString)RenderMarkdown(GetActiveContent() ?? ""))
            </div>
        }
        else if (ActiveTab?.Contains("hive-config.yaml") == true)
        {
            <pre class="yaml-highlighted"><code>@((MarkupString)HighlightYaml(GetActiveContent() ?? ""))</code></pre>
        }
        else
        {
            <pre><code>@GetActiveContent()</code></pre>
        }
    </div>
}

@code {
    private const string ModelsTabName = "Models";
    private const string AvailableModelsTabName = "Available Models";
    private const string SubAgentModelsTabName = "Sub-Agent Models";
    private const string BackupTabName = "Backup";
    private const string RepositoriesTabName = "Repositories";
    private const string OrchestratorTabName = "Orchestrator";
    private const string WorkersTabName = "Workers";
    private const string ComposerTabName = "Composer";

    /// <summary>
    /// Converts a dropdown wire value (<c>"none"</c>, <c>"extra_high"</c>, …) into a
    /// <see cref="ReasoningEffort"/>. Empty input means "unset" and maps to <c>null</c>.
    /// </summary>
    private static ReasoningEffort? ParseReasoning(string? value) =>
        string.IsNullOrEmpty(value) ? null : ReasoningEffortConverter.Parse(value);

    /// <summary>
    /// Sentinel wire value bound by the Models-tab selects when an assignment is unset.
    /// An empty value must NEVER map to a catalog model or to <see cref="ReasoningEffort.None"/> —
    /// <see cref="ParseReasoning"/> maps it to <c>null</c> (leave-unchanged) on save.
    /// </summary>
    internal const string UnsetSentinel = "";

    // The page consumes the shared facade DTOs from CopilotHive.Services (FacadeDtos.cs)
    // directly — ModelsConfigDto, AvailableModelDto, ConfigSubAgentModelDto, DiscoveredModelDto,
    // RepositoryDto, OrchestratorConfigDto, WorkersConfigDto, ComposerConfigDto and
    // BackupInfoDto. They carry exactly the shapes this page used to deserialize from JSON,
    // so no local response records are needed.

    private bool _loading = true;
    private string? _error;
    private string _activeTab = ModelsTabName;
    private readonly Dictionary<string, string> _files = [];
    private List<string> _tabs = [];

    private ModelsConfigDto? _modelsData;
    private bool _modelsLoading;
    private bool _modelsSaving;
    private bool _saveSuccess;
    private string? _saveError;

    // Per-field binding. Primary selects bind the empty sentinel when the stored assignment is
    // unset; premium/compaction selects bind "" for their existing '(none)' / '(use main model)'.
    private string _orchestratorModel = UnsetSentinel;
    private string _composerModel = UnsetSentinel;
    private string _compactionModel = UnsetSentinel;
    private string _coderModel = UnsetSentinel;
    private string _testerModel = UnsetSentinel;
    private string _reviewerModel = UnsetSentinel;
    private string _docwriterModel = UnsetSentinel;
    private string _improverModel = UnsetSentinel;
    private string _coderPremiumModel = UnsetSentinel;
    private string _testerPremiumModel = UnsetSentinel;
    private string _reviewerPremiumModel = UnsetSentinel;
    private string _docwriterPremiumModel = UnsetSentinel;
    private string _improverPremiumModel = UnsetSentinel;

    // Per-assignment reasoning effort. The empty sentinel means "not configured" (a no-op on
    // save); "none" is a real persisted level and must round-trip as such.
    private string _orchestratorReasoningEffort = UnsetSentinel;
    private string _composerReasoningEffort = UnsetSentinel;
    private string _coderReasoningEffort = UnsetSentinel;
    private string _testerReasoningEffort = UnsetSentinel;
    private string _reviewerReasoningEffort = UnsetSentinel;
    private string _docwriterReasoningEffort = UnsetSentinel;
    private string _improverReasoningEffort = UnsetSentinel;
    private string _coderPremiumReasoningEffort = UnsetSentinel;
    private string _testerPremiumReasoningEffort = UnsetSentinel;
    private string _reviewerPremiumReasoningEffort = UnsetSentinel;
    private string _docwriterPremiumReasoningEffort = UnsetSentinel;
    private string _improverPremiumReasoningEffort = UnsetSentinel;

    private IReadOnlyList<BackupInfoDto> _backups = [];
    private bool _backupsLoading;
    private bool _backupCreating;
    private string? _backupError;
    private bool _backupSuccess;

    // Available Models tab state
    private IReadOnlyList<DiscoveredModelDto> _discoveredModels = [];
    private bool _discoveringModels;
    private bool _showDiscoveryModal;
    private HashSet<string> _selectedDiscoveredIds = [];
    private bool _showAddModelForm;
    private string _newModelName = "";
    private int? _newModelContextWindow;
    private string _newModelDescription = "";
    private bool? _newModelSupportsVision;
    private string? _editingModelName;
    private int? _editModelContextWindow;
    private string _editModelDescription = "";
    private bool? _editModelSupportsVision;
    private string? _availableModelsError;
    private string? _availableModelsSuccess;

    // Sub-Agent Models tab state
    private bool _showAddSubAgentModelForm;
    private string _newSubAgentModelName = "";
    private int? _newSubAgentModelContextWindow;
    private string _newSubAgentModelReasoningEffort = "none";
    private string _newSubAgentModelDescription = "";
    private bool? _newSubAgentModelSupportsVision;
    private string? _editingSubAgentModelName;
    private int? _editSubAgentModelContextWindow;
    private string _editSubAgentModelReasoningEffort = "none";
    private string _editSubAgentModelDescription = "";
    private bool? _editSubAgentModelSupportsVision;
    private string? _subAgentModelsError;
    private string? _subAgentModelsSuccess;

    // Repositories tab
    private IReadOnlyList<RepositoryDto> _repositories = [];
    private bool _reposLoading;
    private bool _repoSaving;
    private string? _repoError;
    private string? _repoSuccess;
    private bool _showAddRepoForm;
    private string _newRepoName = "";
    private string _newRepoUrl = "";
    private string _newRepoDefaultBranch = "main";
    private string _newRepoMergeTo = "";
    private string _newRepoTagBranch = "";
    private bool _newRepoMonitorCi = false;
    private int _newRepoCiTimeout = 30;
    private string? _editingRepoName;
    private string _editRepoUrl = "";
    private string _editRepoDefaultBranch = "main";
    private string _editRepoMergeTo = "";
    private string _editRepoTagBranch = "";
    private bool _editRepoMonitorCi = false;
    private int _editRepoCiTimeout = 30;
    private List<string>? _repoBranches;
    private bool _loadingBranches;
    private bool _branchLoadError;
    private CancellationTokenSource? _branchFetchCts;
    private int _branchFetchGeneration;

    // Orchestrator tab
    private OrchestratorConfigDto? _orchestratorData;
    private bool _orchestratorLoading;
    private bool _orchestratorSaving;
    private string? _orchestratorSaveError;
    private string? _orchestratorSaveSuccess;
    private int _orchMaxIterations;
    private int _orchMaxRetriesPerTask;
    private int _orchMaxParallelGoals;
    private bool _orchVerboseLogging;
    private int _orchBrainMaxSteps;
    private int _orchBranchCleanupDelayHours;

    // Workers tab
    private WorkersConfigDto? _workersData;
    private bool _workersLoading;
    private bool _workersSaving;
    private string? _workersSaveError;
    private string? _workersSaveSuccess;
    private int _coderContextWindow;
    private int _testerContextWindow;
    private int _reviewerContextWindow;
    private int _docwriterContextWindow;
    private int _improverContextWindow;

    // Composer tab
    private ComposerConfigDto? _composerData;
    private bool _composerLoading;
    private bool _composerSaving;
    private string? _composerSaveError;
    private string? _composerSaveSuccess;
    private int _composerMaxSteps;
    private string _composerNotifMode = "passive";
    private int _composerNotifThrottle = 30;
    private readonly HashSet<string> _composerNotifActiveEvents = [];

    protected override async Task OnInitializedAsync()
    {
        PageHeader.SetTitle("⚙️ Configuration");
        try
        {
            await LoadFilesAsync();
            await LoadModelsAsync();
            await LoadBackupsAsync();
            await LoadRepositoriesAsync();
            await LoadOrchestratorAsync();
            await LoadWorkersAsync();
            await LoadComposerAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadFilesAsync()
    {
        var basePath = ConfigRepo.LocalPath;

        // Load hive-config.yaml
        var configPath = Path.Combine(basePath, "hive-config.yaml");
        if (File.Exists(configPath))
            _files["hive-config.yaml"] = await File.ReadAllTextAsync(configPath);

        // Load agents/*.agents.md
        var agentsDir = Path.Combine(basePath, "agents");
        if (Directory.Exists(agentsDir))
        {
            foreach (var file in Directory.GetFiles(agentsDir, "*.agents.md").OrderBy(f => f))
            {
                var name = Path.GetFileName(file);
                _files[name] = await File.ReadAllTextAsync(file);
            }
        }

        _tabs = [.. _files.Keys];
        _tabs.Insert(0, ModelsTabName);
        _tabs.Insert(1, AvailableModelsTabName);
        _tabs.Insert(2, SubAgentModelsTabName);
        _tabs.Insert(3, BackupTabName);
        _tabs.Insert(4, RepositoriesTabName);
        _tabs.Insert(5, OrchestratorTabName);
        _tabs.Insert(6, WorkersTabName);
        _tabs.Insert(7, ComposerTabName);
    }

    // Load methods that only read through the synchronous facade projections return a completed
    // Task rather than being `async`: they keep the awaited call-site shape the page already
    // uses while carrying no await (which would be a CS1998 warning under TreatWarningsAsErrors).
    // Reads go through the synchronous IConfigFacade projections, so this method carries no
    // await. It stays Task-returning (rather than `async`) to keep the awaited call sites
    // unchanged without tripping CS1998 under TreatWarningsAsErrors.
    private Task LoadModelsAsync()
    {
        _modelsLoading = true;
        try
        {
            var result = ConfigFacade.GetModels();
            if (!result.Success)
            {
                // Same inner message the endpoint body carried, without an HTTP status prefix.
                _saveError = $"Failed to load model config: {result.Error}";
                return Task.CompletedTask;
            }

            _modelsData = result.Value;
            if (_modelsData is not null)
            {
                PopulateModelEditorFields(_modelsData);
            }
        }
        catch (Exception ex)
        {
            _saveError = $"Failed to load model config: {ex.Message}";
        }
        finally
        {
            _modelsLoading = false;
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Populates the Models-tab binding fields from the loaded <see cref="ModelsConfigDto"/>.
    /// NULL-PRESERVING: each of the seven primary selects displays ONLY its own assignment —
    /// an unset (null) assignment binds the empty sentinel so the disabled '(not configured)'
    /// placeholder is shown. No orchestrator fallback is applied to Composer or the five primary
    /// worker roles (the old fallbacks materialized the orchestrator's model on open+save).
    /// </summary>
    internal void PopulateModelEditorFields(ModelsConfigDto data)
    {
        _orchestratorModel = data.Orchestrator ?? UnsetSentinel;
        _composerModel = data.Composer ?? UnsetSentinel;
        _compactionModel = data.Compaction ?? UnsetSentinel;
        _coderModel = data.Workers.GetValueOrDefault("coder")?.Model ?? UnsetSentinel;
        _testerModel = data.Workers.GetValueOrDefault("tester")?.Model ?? UnsetSentinel;
        _reviewerModel = data.Workers.GetValueOrDefault("reviewer")?.Model ?? UnsetSentinel;
        _docwriterModel = data.Workers.GetValueOrDefault("docwriter")?.Model ?? UnsetSentinel;
        _improverModel = data.Workers.GetValueOrDefault("improver")?.Model ?? UnsetSentinel;
        _coderPremiumModel = data.Workers.GetValueOrDefault("coder")?.PremiumModel ?? UnsetSentinel;
        _testerPremiumModel = data.Workers.GetValueOrDefault("tester")?.PremiumModel ?? UnsetSentinel;
        _reviewerPremiumModel = data.Workers.GetValueOrDefault("reviewer")?.PremiumModel ?? UnsetSentinel;
        _docwriterPremiumModel = data.Workers.GetValueOrDefault("docwriter")?.PremiumModel ?? UnsetSentinel;
        _improverPremiumModel = data.Workers.GetValueOrDefault("improver")?.PremiumModel ?? UnsetSentinel;

        // Null reasoning binds the empty sentinel — NOT 'none' — so an untouched save never
        // materializes the adjacent nullable fields. Explicit ReasoningEffort.None is a real
        // configured value and keeps the 'none' wire value.
        _orchestratorReasoningEffort = WireOrUnset(data.OrchestratorReasoningEffort);
        _composerReasoningEffort = WireOrUnset(data.ComposerReasoningEffort);
        _coderReasoningEffort = WireOrUnset(data.WorkerReasoningEffort.GetValueOrDefault("coder"));
        _testerReasoningEffort = WireOrUnset(data.WorkerReasoningEffort.GetValueOrDefault("tester"));
        _reviewerReasoningEffort = WireOrUnset(data.WorkerReasoningEffort.GetValueOrDefault("reviewer"));
        _docwriterReasoningEffort = WireOrUnset(data.WorkerReasoningEffort.GetValueOrDefault("docwriter"));
        _improverReasoningEffort = WireOrUnset(data.WorkerReasoningEffort.GetValueOrDefault("improver"));
        _coderPremiumReasoningEffort = WireOrUnset(data.WorkerPremiumReasoningEffort.GetValueOrDefault("coder"));
        _testerPremiumReasoningEffort = WireOrUnset(data.WorkerPremiumReasoningEffort.GetValueOrDefault("tester"));
        _reviewerPremiumReasoningEffort = WireOrUnset(data.WorkerPremiumReasoningEffort.GetValueOrDefault("reviewer"));
        _docwriterPremiumReasoningEffort = WireOrUnset(data.WorkerPremiumReasoningEffort.GetValueOrDefault("docwriter"));
        _improverPremiumReasoningEffort = WireOrUnset(data.WorkerPremiumReasoningEffort.GetValueOrDefault("improver"));
    }

    /// <summary>
    /// Converts a loaded <see cref="ReasoningEffort"/> into the wire value the Models-tab
    /// reasoning <c>&lt;select&gt;</c> elements bind to. An unset (null) effort binds the empty
    /// sentinel so the disabled '(not configured)' placeholder is shown — it must never claim
    /// the explicit 'none' level. <see cref="ReasoningEffort.None"/> itself remains the real
    /// 'none' wire value and round-trips as such.
    /// </summary>
    private static string WireOrUnset(ReasoningEffort? effort) =>
        effort is null ? UnsetSentinel : ReasoningEffortOptions.WireValue(effort.Value);

    /// <summary>
    /// Builds the <see cref="ModelConfigUpdate"/> from the current binding fields. NULL-PRESERVING,
    /// with the PRIMARY contract deliberately separate from the premium/compaction one:
    /// <list type="bullet">
    /// <item>An empty primary scalar (orchestrator / Composer) is sent as <c>null</c>
    /// (leave-unchanged) over ANY baseline — including a previously concrete one. Clearing an
    /// existing primary model is NOT a feature, so the empty-string clear must never travel here.</item>
    /// <item>An empty primary worker selection is ALWAYS OMITTED from
    /// <see cref="ModelConfigUpdate.WorkerModels"/> — never sent as an empty string and never
    /// substituted with another role's model. A concrete selection keeps its exact name, even
    /// when it equals the orchestrator's model (equality is never inferred as inheritance).</item>
    /// <item>Premium/compaction keep the BASELINE-AWARE behavior: a displayed empty over an
    /// originally null baseline (the loaded <see cref="_modelsData"/>) omits the premium key /
    /// sends a <c>null</c> compaction, while an explicitly cleared previously-concrete value
    /// still travels as the existing empty-string update, per the service's blank-normalization
    /// contract.</item>
    /// <item>An unset reasoning binds the empty sentinel and maps through
    /// <see cref="ParseReasoning"/> to <c>null</c> (no-op); explicit 'none' round-trips as
    /// <see cref="ReasoningEffort.None"/>.</item>
    /// </list>
    /// </summary>
    internal ModelConfigUpdate BuildModelConfigUpdate()
    {
        var data = _modelsData;

        return new ModelConfigUpdate(
            // Primaries: unconditional no-op on empty — NOT NullIfUnset (which clears over a
            // concrete baseline; that behavior belongs to premium/compaction only).
            OrchestratorModel: NullIfEmpty(_orchestratorModel),
            ComposerModel: NullIfEmpty(_composerModel),
            WorkerModels: BuildPrimaryWorkerModels(),
            PremiumWorkerModels: BuildPremiumWorkerModels(data),
            CompactionModel: NullIfUnset(_compactionModel, data?.Compaction),
            OrchestratorReasoningEffort: ParseReasoning(_orchestratorReasoningEffort),
            ComposerReasoningEffort: ParseReasoning(_composerReasoningEffort),
            WorkerReasoningEffort: BuildWorkerReasoningDictionary(primary: true),
            WorkerPremiumReasoningEffort: BuildWorkerReasoningDictionary(primary: false));
    }

    /// <summary>
    /// PRIMARY mapping: an empty display is ALWAYS <c>null</c> (leave-unchanged), regardless of
    /// the loaded baseline — this editor never clears an existing primary model. A non-empty
    /// value travels verbatim, including a selection equal to the orchestrator's model.
    /// </summary>
    private static string? NullIfEmpty(string displayed) =>
        displayed.Length == 0 ? null : displayed;

    /// <summary>
    /// PREMIUM/COMPACTION mapping ONLY: returns <c>null</c> (leave-unchanged) when the displayed
    /// value is the empty sentinel AND the stored baseline was also null — an untouched unset
    /// field is a no-op. A non-empty value travels verbatim, and an empty value over a CONCRETE
    /// baseline travels as the empty string, preserving the existing user clearing behavior of
    /// the '(none)' / '(use main model)' selects. Deliberately NOT used for the primary
    /// orchestrator/Composer/worker fields.
    /// </summary>
    private static string? NullIfUnset(string displayed, string? baseline) =>
        displayed.Length == 0
            ? (baseline is null ? null : "")
            : displayed;

    /// <summary>
    /// Builds the PRIMARY worker-model dictionary. An empty (sentinel) selection is ALWAYS
    /// omitted — no baseline lookup is consulted, so a previously concrete role is left
    /// untouched rather than cleared. Concrete selections keep their exact names.
    /// </summary>
    private Dictionary<string, string> BuildPrimaryWorkerModels()
    {
        var displayed = new Dictionary<string, string>
        {
            ["coder"] = _coderModel,
            ["tester"] = _testerModel,
            ["reviewer"] = _reviewerModel,
            ["docwriter"] = _docwriterModel,
            ["improver"] = _improverModel,
        };

        Dictionary<string, string> result = [];
        foreach (var (role, value) in displayed)
        {
            var effective = NullIfEmpty(value);
            if (effective is not null)
                result.Add(role, effective);
        }

        return result;
    }

    /// <summary>
    /// Builds the PREMIUM worker-model dictionary. An empty display over an originally null
    /// baseline is omitted (an untouched blank never creates a worker section); an empty display
    /// over a CONCRETE baseline travels as the empty string so the existing '(none)' clearing
    /// behavior keeps working.
    /// </summary>
    private Dictionary<string, string> BuildPremiumWorkerModels(ModelsConfigDto? data)
    {
        var displayed = new Dictionary<string, string>
        {
            ["coder"] = _coderPremiumModel,
            ["tester"] = _testerPremiumModel,
            ["reviewer"] = _reviewerPremiumModel,
            ["docwriter"] = _docwriterPremiumModel,
            ["improver"] = _improverPremiumModel,
        };

        Dictionary<string, string> result = [];
        foreach (var (role, value) in displayed)
        {
            var baselineValue = data?.Workers.GetValueOrDefault(role)?.PremiumModel;
            var effective = NullIfUnset(value, baselineValue);
            if (effective is not null)
                result.Add(role, effective);
        }

        return result;
    }

    /// <summary>
    /// Builds the per-role reasoning-effort dictionary. A sentinel (unset) reasoning assignment
    /// maps through <see cref="ParseReasoning"/> to <c>null</c>, which the service treats as a
    /// no-op for that role, so an untouched save never materializes the adjacent nullable
    /// fields; a concrete selection (including explicit 'none') is included so it persists.
    /// </summary>
    private Dictionary<string, ReasoningEffort?> BuildWorkerReasoningDictionary(bool primary)
    {
        var displayed = new Dictionary<string, string>
        {
            ["coder"] = primary ? _coderReasoningEffort : _coderPremiumReasoningEffort,
            ["tester"] = primary ? _testerReasoningEffort : _testerPremiumReasoningEffort,
            ["reviewer"] = primary ? _reviewerReasoningEffort : _reviewerPremiumReasoningEffort,
            ["docwriter"] = primary ? _docwriterReasoningEffort : _docwriterPremiumReasoningEffort,
            ["improver"] = primary ? _improverReasoningEffort : _improverPremiumReasoningEffort,
        };

        var result = new Dictionary<string, ReasoningEffort?>();
        foreach (var (role, value) in displayed)
        {
            var parsed = ParseReasoning(value);
            if (parsed is not null)
                result.Add(role, parsed);
        }
        return result;
    }

