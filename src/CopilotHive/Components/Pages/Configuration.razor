    private async Task RemoveRepositoryAsync(string name)
    {
        _repoError = null; _repoSuccess = null;
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Remove repository '{name}'?");
        if (!confirmed) return;
        try
        {
            var result = await ConfigFacade.RemoveRepositoryAsync(name);
            if (result.Success)
            {
                await LoadRepositoriesAsync();
                _repoSuccess = "✅ Repository removed";
                await Task.Delay(3000);
                _repoSuccess = null;
            }
            else
            {
                _repoError = $"Remove failed: {result.Error}";
            }
        }
        catch (Exception ex)
        {
            _repoError = $"Remove failed: {ex.Message}";
