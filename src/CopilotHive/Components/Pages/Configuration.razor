    // Tri-state helpers: "" => null (unset), "true" => true, "false" => false.
    private static string FormatTriState(bool? value) => value switch
    {
        true => "true",
        false => "false",
        null => "",
    };

    private static bool? ParseTriState(string? raw) => raw switch
    {
        "true" => true,
        "false" => false,
        _ => null,
    };

