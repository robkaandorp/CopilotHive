    private void ToggleDiscoveredSelection(string id, bool selected)
    {
        if (selected)
            _selectedDiscoveredIds.Add(id);
        else
            _selectedDiscoveredIds.Remove(id);
    }

    private async Task BrowseProviderModelsAsync()
    {
        _discoveringModels = true;
        _availableModelsError = null;
        _availableModelsSuccess = null;
        try
        {
            var result = await ConfigFacade.DiscoverModelsAsync();
            if (!result.Success)
            {
                _availableModelsError = $"Discovery failed: {result.Error}";
                return;
            }

            _discoveredModels = (result.Value ?? [])
                .OrderBy(m => m.Name ?? m.Id, StringComparer.OrdinalIgnoreCase).ToList();
            _selectedDiscoveredIds.Clear();
            _showDiscoveryModal = true;
        }
        catch (Exception ex)
        {
            _availableModelsError = $"Discovery failed: {ex.Message}";
        }
        finally
        {
            _discoveringModels = false;
            StateHasChanged();
        }
    }

    private async Task AddSelectedDiscoveredAsync()
    {
        _availableModelsError = null;
        _availableModelsSuccess = null;
        try
        {
            foreach (var dm in _discoveredModels.Where(m => _selectedDiscoveredIds.Contains(m.Id)))
            {
                var result = await AddAvailableModelEntryAsync(dm.Id, dm.ContextWindow, null);
                if (!result.Success)
                {
                    _availableModelsError = $"Failed to add '{dm.Id}': {result.Error}";
                }
            }
            _selectedDiscoveredIds.Clear();
            _showDiscoveryModal = false;
            await LoadModelsAsync();
            if (_availableModelsError is null)
                _availableModelsSuccess = "✅ Models added";
        }
        catch (Exception ex)
        {
            _availableModelsError = $"Add failed: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
        }
    }

