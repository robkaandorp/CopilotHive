@page "/composer"
@using CopilotHive.Dashboard
@using CopilotHive.Orchestration
@using CopilotHive.Services
@using Markdig
@using Microsoft.AspNetCore.Components.Forms
@using SharpCoder.SubAgents
@using System.IO
@using System.Text.Json
@using Microsoft.Extensions.AI
@implements IAsyncDisposable
@inject Composer Composer
@inject ComposerAttachmentService AttachmentService
@inject IJSRuntime JS
@inject PageHeaderState PageHeader
@inject IComposerFacade ComposerFacade
@inject IConfigFacade ConfigFacade

@if (ViewState.ShowNotConfiguredNotice)
{
    <div class="chat-status chat-status-error">
        No model configured — select a model to start
    </div>
}

@if (ViewState.ShowModelPicker && !ViewState.ShowConnectedControls)
{
    <div class="chat-actions">
        <select disabled="@Composer.IsStreaming" class="chat-model-select" @onchange="HandleModelChange">
            @if (ViewState.Placeholder is { } placeholder)
            {
                <option value="" selected="@(string.IsNullOrEmpty(_selectedModel))">@placeholder</option>
            }
            @foreach (var model in _availableModels)
            {
                <option value="@model" selected="@(_selectedModel == model)">@model</option>
            }
        </select>
    </div>
}

@if (ViewState.ShowConnectedControls)
{
    <div class="composer-layout">
        <div class="chat-container">
            @{
                var subAgents = Composer.GetSubAgents();
            }
            @if (subAgents.Count > 0)
            {
                <div style="border: 1px solid var(--border-color, #333); border-radius: 6px; margin-bottom: 0.5rem; overflow: hidden;">
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.4rem 0.6rem; font-size: 0.85rem; font-weight: 600;">
                        <span>⚙️ Background tasks (@subAgents.Count)</span>
                        <button class="chat-action-btn" style="padding: 0.1rem 0.5rem; font-size: 0.8rem;"
                                @onclick="ToggleSubAgents">
                            @(_subAgentsExpanded ? "▾" : "▸")
                        </button>
                    </div>
                    @if (_subAgentsExpanded)
                    {
                        <div style="padding: 0 0.6rem 0.4rem 0.6rem; max-height: 60vh; overflow-y: auto;">
                            @foreach (var sa in subAgents)
                            {
                                <div style="padding: 0.3rem 0; border-top: 1px solid var(--border-color, #333);">
                                    <div style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.8rem;">
                                        <span style="flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;">@(string.IsNullOrWhiteSpace(sa.Task) ? "" : sa.Task.ReplaceLineEndings(" ").Trim())</span>
                                        <span class="text-muted" style="flex: 0 0 auto;">@(string.IsNullOrWhiteSpace(sa.Model) ? "—" : sa.Model)</span>
                                        <span style="flex: 0 0 auto;">@StatusBadge(sa.Status)</span>
                                        <span class="text-muted" style="flex: 0 0 auto;">@Elapsed(sa)</span>
                                    </div>
                                    @if (sa.Status == SubAgentStatus.Completed && !string.IsNullOrWhiteSpace(sa.Summary))
                                    {
                                        <div style="font-size: 0.75rem; margin-top: 0.2rem; max-height: 220px; overflow-y: auto;">@((MarkupString)FormatContent(sa.Summary))</div>
                                    }
                                    else if ((sa.Status == SubAgentStatus.Failed || sa.Status == SubAgentStatus.TimedOut)
                                             && !string.IsNullOrWhiteSpace(sa.Error))
                                    {
                                        <div style="font-size: 0.75rem; margin-top: 0.2rem; color: var(--danger-color, #e05561); max-height: 220px; overflow-y: auto;">@sa.Error</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            <div class="chat-messages" id="chat-messages">
                @if (_messages.Count == 0 && !Composer.IsStreaming)
                {
                    <div class="chat-empty">
                        <p><strong>Welcome to the Composer.</strong></p>
                        <p>Describe what you'd like to build or improve, and I'll help break it into goals.</p>
                        <p class="text-muted">Try: <em>"I want to add user authentication to the API"</em></p>
                    </div>
                }

                @foreach (var msg in _messages)
                {
                    @if (msg.Role == "system")
                    {
                        <div class="chat-msg chat-msg-system">
                            <div class="chat-msg-role">System</div>
                            <div class="chat-msg-content">@((MarkupString)FormatContent(msg.Content))</div>
                        </div>
                    }
                    else
                    {
                        <div class="chat-msg chat-msg-@msg.Role">
                            <div class="chat-msg-role">@(msg.Role == "user" ? "You" : "Composer")</div>
                            <div class="chat-msg-content">@((MarkupString)FormatContent(msg.Content))</div>
                        </div>
                    }
                }

                @if (Composer.IsStreaming)
                {
                    <div class="chat-msg chat-msg-assistant">
                        <div class="chat-msg-role">Composer</div>
                        <div class="chat-msg-content">
                            @((MarkupString)FormatStreamingContent(Composer.StreamingContent))
                            <span class="chat-cursor">▊</span>
                        </div>
                    </div>
                }

                @if (Composer.PendingQuestion is { } pq)
                {
                    <div class="chat-msg chat-msg-assistant chat-question-widget">
                        <div class="chat-msg-role">Composer — Question</div>
                        <div class="chat-msg-content">
                            <div class="chat-question-text">@((MarkupString)FormatContent(pq.Text))</div>

                            @if (pq.Type == QuestionType.YesNo)
                            {
                                <div class="chat-question-actions">
                                    <button class="chat-send chat-question-yes"
                                            @onclick="() => SubmitYesNo(true, pq)">Yes</button>
                                    <button class="chat-action-btn chat-question-no"
                                            @onclick="() => SubmitYesNo(false, pq)">No</button>
                                    <button class="chat-action-btn"
                                            @onclick="() => CancelQuestion(pq)">Cancel</button>
                                </div>
                                <textarea class="chat-input chat-question-feedback"
                                          @bind="_questionFeedback"
                                          placeholder="Optional additional feedback…"
                                          rows="2"></textarea>
                            }
                            else if (pq.Type == QuestionType.SingleChoice)
                            {
                                <div class="chat-question-options">
                                    @foreach (var opt in pq.Options)
                                    {
                                        <label class="chat-question-option">
                                            <input type="radio"
                                                   name="single-choice"
                                                   checked="@(_selectedOptions.Contains(opt))"
                                                   @onchange="() => SelectSingle(opt)" />
                                            @opt
                                        </label>
                                    }
                                </div>
                                <textarea class="chat-input chat-question-feedback"
                                          @bind="_questionFeedback"
                                          placeholder="Optional additional feedback…"
                                          rows="2"></textarea>
                                <div class="chat-question-actions">
                                    <button class="chat-send"
                                            disabled="@(_selectedOptions.Count == 0)"
                                            @onclick="() => SubmitChoice(pq)">Submit</button>
                                    <button class="chat-action-btn"
                                            @onclick="() => CancelQuestion(pq)">Cancel</button>
                                </div>
                            }
                            else if (pq.Type == QuestionType.MultiChoice)
                            {
                                <div class="chat-question-options">
                                    @foreach (var opt in pq.Options)
                                    {
                                        <label class="chat-question-option">
                                            <input type="checkbox"
                                                   checked="@(_selectedOptions.Contains(opt))"
                                                   @onchange="() => ToggleOption(opt)" />
                                            @opt
                                        </label>
                                    }
                                </div>
                                <textarea class="chat-input chat-question-feedback"
                                          @bind="_questionFeedback"
                                          placeholder="Optional additional feedback…"
                                          rows="2"></textarea>
                                <div class="chat-question-actions">
                                    <button class="chat-send"
                                            disabled="@(_selectedOptions.Count == 0)"
                                            @onclick="() => SubmitChoice(pq)">Submit</button>
                                    <button class="chat-action-btn"
                                            @onclick="() => CancelQuestion(pq)">Cancel</button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div id="chat-anchor"></div>
            </div>

            <div class="chat-input-area">
                @if (_pending is not null)
                {
                    <div class="chat-attach-chip">
                        <span class="chat-attach-chip-name">@_pending.DisplayName</span>
                        <button class="chat-attach-chip-remove" @onclick="RemoveAttachment" disabled="@Composer.IsStreaming" title="Remove attachment">×</button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_attachmentError))
                {
                    <div class="chat-attach-error">@_attachmentError</div>
                }
                @if (!string.IsNullOrEmpty(_sendError))
                {
                    <div class="chat-attach-error">@_sendError</div>
                }
                <label class="chat-attach-btn">
                    📎
                    <InputFile OnChange="HandleFileSelected"
                               accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,image/*,application/pdf"
                               disabled="@(_pending is not null || _uploading || Composer.IsStreaming)"
                               class="chat-attach-input" />
                </label>
                <textarea id="composer-input"
                          @bind="_inputText" @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          placeholder="Describe what you want to build…"
                          disabled="@Composer.IsStreaming"
                          rows="2"
                          class="chat-input"></textarea>
                <button @onclick="SendMessage" disabled="@(!CanSend)"
                        class="chat-send">
                    @if (Composer.IsStreaming)
                    {
                        <span>Thinking…</span>
                    }
                    else
                    {
                        <span>Send</span>
                    }
                </button>
            </div>

            <div class="chat-actions">
                <select disabled="@Composer.IsStreaming" class="chat-model-select" @onchange="HandleModelChange">
                    @if (ViewState.Placeholder is { } placeholder)
                    {
                        <option value="" selected="@(string.IsNullOrEmpty(_selectedModel))">@placeholder</option>
                    }
                    @foreach (var model in _availableModels)
                    {
                        <option value="@model" selected="@(_selectedModel == model)">@model</option>
                    }
                </select>
                <select disabled="@Composer.IsStreaming" class="chat-model-select" @onchange="HandleReasoningChange">
                    @foreach (var option in ReasoningEffortOptions.Options)
                    {
                        <option value="@ReasoningEffortOptions.WireValue(option.Value)" selected="@(_selectedReasoning == option.Value)">@option.Label</option>
                    }
                </select>
                <button @onclick="ResetSession" disabled="@Composer.IsStreaming" class="chat-action-btn">
                    🔄 New Session
                </button>
                <button @onclick="CompactSession" disabled="@(Composer.IsStreaming || Composer.IsCompacting)" class="chat-action-btn">
                    @if (Composer.IsCompacting)
                    {
                        <span>Compacting…</span>
                    }
                    else
                    {
                        <text>📦 Compact</text>
                    }
                </button>
                <button @onclick="CompactPartial" disabled="@(Composer.IsStreaming || Composer.IsCompacting)" class="chat-action-btn">
                    @if (Composer.IsCompacting)
                    {
                        <span>Compacting…</span>
                    }
                    else
                    {
                        <text>📦 Compact 50%</text>
                    }
                </button>
                <button @onclick="ToggleActiveNotifications"
                        disabled="@(!CanToggleActiveNotifications(_activeNotifMode, Composer.IsStreaming, _notifTogglePending))"
                        class="chat-action-btn">
                    @ActiveNotificationsButtonText
                </button>
                @if (_restartRequiredForNotifications)
                {
                    <span class="chat-hint">⚠️ Restart required</span>
                }
                @if (!string.IsNullOrEmpty(_notifToggleError))
                {
                    <span class="chat-attach-error">@_notifToggleError</span>
                }
                <span class="text-muted chat-hint">
                    @(_messages.Count) msgs
                    @if (Composer.LastToolCalls > 0)
                    {
                        <text> · @Composer.LastToolCalls tools</text>
                    }
                    @{
                        var stats = Composer.GetStats();
                        var ctxClass = stats is not null
                            ? (stats.ContextUsagePercent >= 90 ? "chat-ctx-danger" : stats.ContextUsagePercent >= 70 ? "chat-ctx-warn" : "chat-ctx-ok")
                            : "";
                    }
                    @if (stats is not null)
                    {
                        <text> · ctx <span class="@ctxClass">@stats.ContextUsagePercent%</span></text>
                    }
                    @if (Composer.IsCompacting)
                    {
                        <span class="chat-ctx-compacting"> · Compacting…</span>
                    }
                    else if (Composer.WasCompacted)
                    {
                        <span class="chat-ctx-compacted"> · Compacted</span>
                    }
                </span>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Internal immutable view-state record the Razor markup reads DIRECTLY. The page computes
    /// its render state from this record; tests construct it from mock Composer state and assert
    /// its flags — never markup tokens or an HTML string. This is the production seam.
    /// </summary>
    /// <param name="IsConnected">Whether the Composer is connected (has an active model).</param>
    /// <param name="ShowModelPicker">Whether the model picker is rendered (always true — reachable even while disconnected).</param>
    /// <param name="ShowConnectedControls">Whether the connected-only controls (thread, Send, Compact, Reset, reasoning select) are rendered.</param>
    /// <param name="ShowNotConfiguredNotice">Whether the "No model configured" notice is shown.</param>
    /// <param name="Placeholder">The no-selection placeholder label for the model select, or <c>null</c> when none.</param>
    internal sealed record ComposerChatViewState(
        bool IsConnected,
        bool ShowModelPicker,
        bool ShowConnectedControls,
        bool ShowNotConfiguredNotice,
        string? Placeholder);

    /// <summary>
    /// The placeholder label for the model select's no-selection option. A non-empty list with
    /// no valid default must NOT visually auto-select the first option without firing a change
    /// event — the placeholder is the explicit no-selection state.
    /// </summary>
    internal const string ModelSelectPlaceholder = "— select a model —";

    /// <summary>
    /// Computes the page's render state from the Composer's connection state. The markup reads
    /// this record directly; tests assert its flags.
    /// </summary>
    /// <param name="isConnected">Whether the Composer is connected.</param>
    internal static ComposerChatViewState ComputeViewState(bool isConnected) => new(
        IsConnected: isConnected,
        ShowModelPicker: true,
        ShowConnectedControls: isConnected,
        ShowNotConfiguredNotice: !isConnected,
        Placeholder: ModelSelectPlaceholder);

    private ComposerChatViewState ViewState => ComputeViewState(Composer.IsConnected);

    private sealed class ChatMessage
    {
        public required string Role { get; init; }
        public string Content { get; set; } = "";
    }

    private readonly List<ChatMessage> _messages = [];
    private string _inputText = "";
    private HashSet<string> _selectedOptions = [];
    private string _questionFeedback = "";
    private List<string> _availableModels = [];
    private string _selectedModel = "";
    private ReasoningEffort _selectedReasoning = ReasoningEffort.None;
    private bool _subAgentsExpanded = false;
    private ComposerAttachment? _pending;
    private bool _uploading;
    private string? _attachmentError;
    private string? _sendError;
    private IJSObjectReference? _pasteModule;
    private DotNetObjectReference<ComposerChat>? _pasteDotNetRef;
    // Whether the paste module has been installed on the composer-input textarea. Set exactly
    // once, when the textarea first appears (post-connect on a disconnected-first page); never
    // reset — the module is uninstalled/disposed only in DisposeAsync.
    private bool _pasteInstalled;
    // Authoritative event-notification mode. Null until IConfigFacade.GetComposer() reports it —
    // a fabricated default would let the toggle persist a transition the server never implied.
    private string? _activeNotifMode;
    private bool _notifTogglePending;
    private bool _restartRequiredForNotifications;
    private string? _notifToggleError;

    protected override async Task OnInitializedAsync()
    {
        PageHeader.SetTitle("💬 Composer");

        // The available-models picker is ALWAYS loaded — even while disconnected the picker is
        // reachable and enabled so the user can select a model to start. The current-model
        // endpoint returns {"model":null} while disconnected (frozen contract), so loading it
        // is harmless and keeps the select in its placeholder state.
        await LoadAvailableModelsAsync();
        if (Composer.IsConnected)
        {
            LoadHistory();
            await LoadCurrentModelAsync();
        }

        // The config endpoint is independent of the Composer agent connection, so the
        // notification mode is loaded either way — otherwise a disconnected-then-reconnected
        // page would render the toggle from an unloaded state.
        await LoadActiveNotificationsModeAsync();
        StateHasChanged();

        Composer.OnStreamingUpdate += HandleStreamingUpdate;
        Composer.OnQuestionAsked += HandleQuestionAsked;
        Composer.OnCompactingStarted += HandleCompactingStarted;
        Composer.OnCompacted += HandleCompacted;
        Composer.OnSubAgentChanged += HandleSubAgentChanged;
        Composer.OnActiveInjection += HandleActiveInjection;
    }

    /// <summary>
    /// Whether the paste module should be installed on the current render. The module is
    /// installed when the composer-input textarea FIRST appears — on a connected-first page
    /// that is the first render; on a disconnected-first page it is the render after a
    /// successful first-connect. Installed EXACTLY ONCE (tracked by the caller's install
    /// state); never installed while disconnected (no textarea exists).
    /// </summary>
    /// <param name="alreadyInstalled">Whether the module has already been installed.</param>
    /// <param name="showConnectedControls">Whether the connected layout (with the textarea) is rendered.</param>
    internal static bool ShouldInstallPasteModule(bool alreadyInstalled, bool showConnectedControls)
        => !alreadyInstalled && showConnectedControls;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("eval",
            "document.getElementById('chat-anchor')?.scrollIntoView()");

        // The paste module is installed when the composer-input textarea FIRST appears — on a
        // connected-first page that is the first render; on a disconnected-first page it is the
        // render after a successful first-connect. Installed EXACTLY ONCE (tracked by
        // _pasteInstalled); never installed while disconnected (no textarea exists).
        if (ShouldInstallPasteModule(_pasteInstalled, ViewState.ShowConnectedControls))
        {
            _pasteInstalled = true;
            _pasteModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/composer-paste.js");
            _pasteDotNetRef = DotNetObjectReference.Create(this);
            await _pasteModule.InvokeVoidAsync("install", "composer-input", _pasteDotNetRef);
            await SyncPasteAllowedAsync();
        }
    }

    /// <summary>
    /// Mirrors the authoritative .NET paste-allowed state into the JS module so a paste that can
    /// never be accepted is not intercepted in the first place. The .NET side still re-validates.
    /// </summary>
    private async Task SyncPasteAllowedAsync()
    {
        if (_pasteModule is null) return;
        await _pasteModule.InvokeVoidAsync("setAllowed", ComputePasteAllowed(Composer.IsStreaming, _uploading, _pending));
    }

    /// <summary>
    /// Whether a clipboard paste may currently produce a pending attachment. A paste is refused
    /// while another attachment is pending, while an upload is running and while the Composer is
    /// streaming, so an existing pending attachment can never be replaced or orphaned.
    /// </summary>
    /// <param name="isStreaming">Whether the Composer is streaming.</param>
    /// <param name="uploading">Whether an attachment upload is already in flight.</param>
    /// <param name="pending">The current pending attachment, if any.</param>
    internal static bool ComputePasteAllowed(bool isStreaming, bool uploading, object? pending)
        => !isStreaming && !uploading && pending is null;


    private void LoadHistory()
    {
        _messages.Clear();
        foreach (var (role, content) in Composer.GetChatHistory())
        {
            if (role == "user")
            {
                var (eventBlock, userMessage) = Composer.TrySplitEventBlock(content);
                if (eventBlock is not null)
                    _messages.Add(new ChatMessage { Role = "system", Content = eventBlock });
                // Active system notifications are E0-envelope-wrapped with a
                // "[System Notification]" prefix — render them as system messages.
                if (userMessage.StartsWith("[System Notification]", StringComparison.Ordinal))
                    _messages.Add(new ChatMessage { Role = "system", Content = userMessage });
                else
                    _messages.Add(new ChatMessage { Role = "user", Content = userMessage });
            }
            else
            {
                _messages.Add(new ChatMessage { Role = role, Content = content });
            }
        }
    }

    private void HandleStreamingUpdate()
    {
        InvokeAsync(async () =>
        {
            // When streaming finishes, reload history to get the final message
            if (!Composer.IsStreaming)
            {
                LoadHistory();
            }
            StateHasChanged();

            // CRITICAL: streaming toggles paste availability. Without this the JS mirror would
            // stay allowed=false forever once a stream ends, permanently killing paste.
            await SyncPasteAllowedAsync();
        });
    }

    private async Task SendMessage()
    {
        if (!CanSend) return;

        _sendError = null;

        string text;
        if (_pending is not null)
        {
            var ext = Path.GetExtension(_pending.SavedRelativePath);
            var absPath = Path.Combine(AttachmentService.AttachmentsRootPath, _pending.SavedRelativePath);
            text = BuildAttachmentMessage(_inputText, _pending.DisplayName, ext, absPath);
        }
        else
        {
            text = _inputText.Trim();
        }

        string? eventBlock = null;
        try
        {
            eventBlock = await Composer.SendMessageWithEventsAsync(text);
        }
        catch (Exception ex)
        {
            _sendError = ex.Message;
            StateHasChanged();
            return;
        }

        if (eventBlock is not null)
            _messages.Add(new ChatMessage { Role = "system", Content = eventBlock });

        _messages.Add(new ChatMessage { Role = "user", Content = text });

        // Call Composer.SendMessageWithEventsAsync first. Only after it returns without throwing do we
        // perform destructive state transitions (MarkAsSent, clear pending/input/error).
        // This keeps _pending and _inputText intact for retry if the call fails.
        if (_pending is not null)
        {
            AttachmentService.MarkAsSent(_pending);
            _pending = null;
        }

        _inputText = "";
        _attachmentError = null;
        StateHasChanged();
        await SyncPasteAllowedAsync();
    }

    internal static string BuildAttachmentMessage(string? userText, string displayName, string extension, string savedAbsPath)
    {
        var kind = extension.TrimStart('.').Equals("pdf", StringComparison.OrdinalIgnoreCase) ? "pdf" : "image";
        var encodedPath = System.Text.Json.JsonSerializer.Serialize(savedAbsPath);
        var encodedName = System.Text.Json.JsonSerializer.Serialize(displayName);
        var block = " [Attached " + kind + " file " + encodedName + "; saved at " + encodedPath
            + ". To analyze it, delegate to a vision-capable sub-agent with start_sub_agent(task: \"Analyze this attachment\", image_paths: ["
            + encodedPath + "]).]";
        if (string.IsNullOrWhiteSpace(userText))
            return "The user attached a file with no accompanying text." + block;
        return userText.TrimEnd() + block;
    }

    internal static bool ComputeCanSend(bool isStreaming, bool uploading, string inputText, object? pending)
        => !isStreaming && !uploading && (!string.IsNullOrWhiteSpace(inputText) || pending is not null);

    private bool CanSend => ComputeCanSend(Composer.IsStreaming, _uploading, _inputText, _pending);

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _attachmentError = null;
        var file = e.File;
        if (file is null || file.Size == 0)
        {
            _attachmentError = "No file selected or file is empty.";
            StateHasChanged();
            return;
        }

        _uploading = true;

        // Mirrored BEFORE the first await: while the picker upload runs, a paste must be left
        // alone by JS rather than intercepted and then silently dropped by the .NET guard —
        // that would swallow the user's clipboard content with no feedback. Best-effort: a
        // failing mirror update must not abort the upload and strand the _uploading claim.
        await TrySyncPasteAllowedAsync(PasteHost);

        try
        {
            // maxAllowedSize is MaxAttachmentBytes + 1 so files at exactly the cap pass
            // and files exceeding it throw IOException (Blazor throws IOException, NOT FileLoadException)
            await using var stream = file.OpenReadStream(
                maxAllowedSize: ComposerAttachmentService.MaxAttachmentBytes + 1);
            await SaveAttachmentAsync(file.Name, stream);
        }
        catch (IOException ex)
        {
            _attachmentError = ex.Message; // includes oversize rejection
        }
        catch (Exception ex)
        {
            _attachmentError = ex.Message;
        }
        finally
        {
            _uploading = false;
            StateHasChanged();

            // Best-effort: a failing mirror update must not mask the upload's own outcome.
            await TrySyncPasteAllowedAsync(PasteHost);
        }
    }

    /// <summary>
    /// Narrow seam over the component state the paste flow touches, so the PRODUCTION handler
    /// body (<see cref="HandlePasteCoreAsync"/> and <see cref="SaveAttachmentAsync(IPasteHost, string, Stream)"/>)
    /// can be exercised by tests without a live Blazor circuit. The component itself is the only
    /// production implementation.
    /// </summary>
    internal interface IPasteHost
    {
        /// <summary>The currently staged attachment, if any.</summary>
        ComposerAttachment? Pending { get; set; }

        /// <summary>Whether an attachment upload is in flight.</summary>
        bool Uploading { get; set; }

        /// <summary>Error surfaced under the input area, if any.</summary>
        string? AttachmentError { get; set; }

        /// <summary>Whether the Composer is currently streaming a response.</summary>
        bool IsStreaming { get; }

        /// <summary>Streams the content into the attachment store.</summary>
        /// <param name="originalName">Display name recorded for the attachment.</param>
        /// <param name="content">Content stream; never fully buffered.</param>
        Task<AttachmentSaveResult> SaveAsync(string originalName, Stream content);

        /// <summary>Requests a re-render (the component's <c>StateHasChanged</c>).</summary>
        void Notify();

        /// <summary>Mirrors the authoritative paste-allowed state into the JS module.</summary>
        Task SyncPasteAllowedAsync();
    }

    /// <summary>Binds <see cref="IPasteHost"/> to this component's own fields and services.</summary>
