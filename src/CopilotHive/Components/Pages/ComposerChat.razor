@page "/composer"
@using CopilotHive.Dashboard
@using CopilotHive.Goals
@using CopilotHive.Orchestration
@using CopilotHive.Services
@using Markdig
@using Microsoft.AspNetCore.Components.Forms
@using SharpCoder.SubAgents
@using System.IO
@using System.Text.Json
@using Microsoft.Extensions.AI
@using System.Security.Claims
@implements IAsyncDisposable
@* The LEGACY singleton Composer / attachment store: the OPEN-MODE binding only. In authenticated mode
   the circuit binds the caller's OWN runtime (Composer/Atsachments resolve from the circuit binding),
   so nothing here can serve one account's Composer to another. *@
@inject Composer LegacyComposer
@inject ComposerAttachmentService LegacyAttachments
@* THE SCOPED PER-CIRCUIT RUNTIME SEAM: every operation re-queries it, so the CURRENT account's role and
   enabled state are re-resolved on the very next call. It is never captured by a singleton. *@
@inject IComposerRuntimeAccessor ComposerRuntimeAccessor
@inject IJSRuntime JS
@inject PageHeaderState PageHeader
@inject IComposerFacade ComposerFacade
@inject IConfigFacade ConfigFacade
@inject CopilotHive.Security.CircuitUserPrincipalAccessor CircuitPrincipal

@if (ViewState.ShowForbidden)
{
    @* A Viewer, a signed-out caller or an authenticated refusal: NO runtime, NO history, NO content and
       deliberately NO login redirect (the identity is known — it simply may not use the Composer). *@
    <div class="chat-status chat-status-error chat-forbidden">
        You do not have access to the Composer.
    </div>
}

@if (ViewState.ShowRuntimeError)
{
    <div class="chat-status chat-status-error">
        @ViewState.RuntimeError
    </div>
}

@if (ViewState.ShowDeferredNotice)
{
    @* DEFERRED: the runtime exists but its connect is deferred, so every read answers with shell
       metadata and every mutation first drives ONE connect. The control keeps the page actionable. *@
    <div class="chat-status chat-status-deferred">
        This Composer is not connected yet.
        <button @onclick="ConnectRuntimeAsync" class="chat-action-btn chat-connect-btn">Connect now</button>
    </div>
}

@if (ViewState.ShowNotConfiguredNotice)
{
    <div class="chat-status chat-status-error">
        No model configured — select a model to start
    </div>
}

@if (ViewState.ShowModelPicker && !ViewState.ShowConnectedControls)
{
    <div class="chat-actions">
        <select disabled="@IsBoundStreaming" class="chat-model-select" @onchange="HandleModelChange">
            @if (ViewState.Placeholder is { } placeholder)
            {
                <option value="" selected="@(string.IsNullOrEmpty(_selectedModel))">@placeholder</option>
            }
            @foreach (var model in _availableModels)
            {
                <option value="@model" selected="@(_selectedModel == model)">@model</option>
            }
        </select>
    </div>
}

@if (ViewState.ShowConnectedControls)
{
    <div class="composer-layout">
        <div class="chat-container">
            @{
                var subAgents = Composer.GetSubAgents();
            }
            @if (subAgents.Count > 0)
            {
                <div style="border: 1px solid var(--border-color, #333); border-radius: 6px; margin-bottom: 0.5rem; overflow: hidden;">
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.4rem 0.6rem; font-size: 0.85rem; font-weight: 600;">
                        <span>⚙️ Background tasks (@subAgents.Count)</span>
                        <button class="chat-action-btn" style="padding: 0.1rem 0.5rem; font-size: 0.8rem;"
                                @onclick="ToggleSubAgents">
                            @(_subAgentsExpanded ? "▾" : "▸")
                        </button>
                    </div>
                    @if (_subAgentsExpanded)
                    {
                        <div style="padding: 0 0.6rem 0.4rem 0.6rem; max-height: 60vh; overflow-y: auto;">
                            @foreach (var sa in subAgents)
                            {
                                <div style="padding: 0.3rem 0; border-top: 1px solid var(--border-color, #333);">
                                    <div style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.8rem;">
                                        <span style="flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;">@(string.IsNullOrWhiteSpace(sa.Task) ? "" : sa.Task.ReplaceLineEndings(" ").Trim())</span>
                                        <span class="text-muted" style="flex: 0 0 auto;">@(string.IsNullOrWhiteSpace(sa.Model) ? "—" : sa.Model)</span>
                                        <span style="flex: 0 0 auto;">@StatusBadge(sa.Status)</span>
                                        <span class="text-muted" style="flex: 0 0 auto;">@Elapsed(sa)</span>
                                    </div>
                                    @if (sa.Status == SubAgentStatus.Completed && !string.IsNullOrWhiteSpace(sa.Summary))
                                    {
                                        <div style="font-size: 0.75rem; margin-top: 0.2rem; max-height: 220px; overflow-y: auto;">@((MarkupString)FormatContent(sa.Summary))</div>
                                    }
                                    else if ((sa.Status == SubAgentStatus.Failed || sa.Status == SubAgentStatus.TimedOut)
                                             && !string.IsNullOrWhiteSpace(sa.Error))
                                    {
                                        <div style="font-size: 0.75rem; margin-top: 0.2rem; color: var(--danger-color, #e05561); max-height: 220px; overflow-y: auto;">@sa.Error</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            <div class="chat-messages" id="chat-messages">
                @if (_messages.Count == 0 && !IsBoundStreaming)
                {
                    <div class="chat-empty">
                        <p><strong>Welcome to the Composer.</strong></p>
                        <p>Describe what you'd like to build or improve, and I'll help break it into goals.</p>
                        <p class="text-muted">Try: <em>"I want to add user authentication to the API"</em></p>
                    </div>
                }

                @foreach (var msg in _messages)
                {
                    @if (msg.Role == "system")
                    {
                        <div class="chat-msg chat-msg-system">
                            <div class="chat-msg-role">System</div>
                            <div class="chat-msg-content">@((MarkupString)FormatContent(msg.Content))</div>
                        </div>
                    }
                    else
                    {
                        <div class="chat-msg chat-msg-@msg.Role">
                            <div class="chat-msg-role">@(msg.Role == "user" ? "You" : "Composer")</div>
                            <div class="chat-msg-content">@((MarkupString)FormatContent(msg.Content))</div>
                        </div>
                    }
                }

                @if (IsBoundStreaming)
                {
                    <div class="chat-msg chat-msg-assistant">
                        <div class="chat-msg-role">Composer</div>
                        <div class="chat-msg-content">
                            @((MarkupString)FormatStreamingContent(Composer.StreamingContent))
                            <span class="chat-cursor">▊</span>
                        </div>
                    </div>
                }

                @if (Composer.PendingQuestion is { } pq)
                {
                    <div class="chat-msg chat-msg-assistant chat-question-widget">
                        <div class="chat-msg-role">Composer — Question</div>
                        <div class="chat-msg-content">
                            <div class="chat-question-text">@((MarkupString)FormatContent(pq.Text))</div>

                            @if (pq.Type == QuestionType.YesNo)
                            {
                                <div class="chat-question-actions">
                                    <button class="chat-send chat-question-yes"
                                            @onclick="() => SubmitYesNo(true, pq)">Yes</button>
                                    <button class="chat-action-btn chat-question-no"
                                            @onclick="() => SubmitYesNo(false, pq)">No</button>
                                    <button class="chat-action-btn"
                                            @onclick="() => CancelQuestion(pq)">Cancel</button>
                                </div>
                                <textarea class="chat-input chat-question-feedback"
                                          @bind="_questionFeedback"
                                          placeholder="Optional additional feedback…"
                                          rows="2"></textarea>
                            }
                            else if (pq.Type == QuestionType.SingleChoice)
                            {
                                <div class="chat-question-options">
                                    @foreach (var opt in pq.Options)
                                    {
                                        <label class="chat-question-option">
                                            <input type="radio"
                                                   name="single-choice"
                                                   checked="@(_selectedOptions.Contains(opt))"
                                                   @onchange="() => SelectSingle(opt)" />
                                            @opt
                                        </label>
                                    }
                                </div>
                                <textarea class="chat-input chat-question-feedback"
                                          @bind="_questionFeedback"
                                          placeholder="Optional additional feedback…"
                                          rows="2"></textarea>
                                <div class="chat-question-actions">
                                    <button class="chat-send"
                                            disabled="@(_selectedOptions.Count == 0)"
                                            @onclick="() => SubmitChoice(pq)">Submit</button>
                                    <button class="chat-action-btn"
                                            @onclick="() => CancelQuestion(pq)">Cancel</button>
                                </div>
                            }
                            else if (pq.Type == QuestionType.MultiChoice)
                            {
                                <div class="chat-question-options">
                                    @foreach (var opt in pq.Options)
                                    {
                                        <label class="chat-question-option">
                                            <input type="checkbox"
                                                   checked="@(_selectedOptions.Contains(opt))"
                                                   @onchange="() => ToggleOption(opt)" />
                                            @opt
                                        </label>
                                    }
                                </div>
                                <textarea class="chat-input chat-question-feedback"
                                          @bind="_questionFeedback"
                                          placeholder="Optional additional feedback…"
                                          rows="2"></textarea>
                                <div class="chat-question-actions">
                                    <button class="chat-send"
                                            disabled="@(_selectedOptions.Count == 0)"
                                            @onclick="() => SubmitChoice(pq)">Submit</button>
                                    <button class="chat-action-btn"
                                            @onclick="() => CancelQuestion(pq)">Cancel</button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div id="chat-anchor"></div>
            </div>

            <div class="chat-input-area">
                @if (_pending is not null)
                {
                    <div class="chat-attach-chip">
                        <span class="chat-attach-chip-name">@_pending.DisplayName</span>
                        <button class="chat-attach-chip-remove" @onclick="RemoveAttachment" disabled="@IsBoundStreaming" title="Remove attachment">×</button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_attachmentError))
                {
                    <div class="chat-attach-error">@_attachmentError</div>
                }
                @if (!string.IsNullOrEmpty(_sendError))
                {
                    <div class="chat-attach-error">@_sendError</div>
                }
                <label class="chat-attach-btn">
                    📎
                    <InputFile OnChange="HandleFileSelected"
                               accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,image/*,application/pdf"
                               disabled="@(_pending is not null || _uploading || IsBoundStreaming)"
                               class="chat-attach-input" />
                </label>
                <textarea id="composer-input"
                          @bind="_inputText" @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          placeholder="Describe what you want to build…"
                          disabled="@IsBoundStreaming"
                          rows="2"
                          class="chat-input"></textarea>
                <button @onclick="SendMessage" disabled="@(!CanSend)"
                        class="chat-send">
                    @if (IsBoundStreaming)
                    {
                        <span>Thinking…</span>
                    }
                    else
                    {
                        <span>Send</span>
                    }
                </button>
            </div>

            <div class="chat-actions">
                <select disabled="@IsBoundStreaming" class="chat-model-select" @onchange="HandleModelChange">
                    @if (ViewState.Placeholder is { } placeholder)
                    {
                        <option value="" selected="@(string.IsNullOrEmpty(_selectedModel))">@placeholder</option>
                    }
                    @foreach (var model in _availableModels)
                    {
                        <option value="@model" selected="@(_selectedModel == model)">@model</option>
                    }
                </select>
                <select disabled="@IsBoundStreaming" class="chat-model-select" @onchange="HandleReasoningChange">
                    @foreach (var option in ReasoningEffortOptions.Options)
                    {
                        <option value="@ReasoningEffortOptions.WireValue(option.Value)" selected="@(_selectedReasoning == option.Value)">@option.Label</option>
                    }
                </select>
                <button @onclick="ResetSession" disabled="@IsBoundStreaming" class="chat-action-btn">
                    🔄 New Session
                </button>
                <button @onclick="CompactSession" disabled="@(IsBoundStreaming || Composer.IsCompacting)" class="chat-action-btn">
                    @if (Composer.IsCompacting)
                    {
                        <span>Compacting…</span>
                    }
                    else
                    {
                        <text>📦 Compact</text>
                    }
                </button>
                <button @onclick="CompactPartial" disabled="@(IsBoundStreaming || Composer.IsCompacting)" class="chat-action-btn">
                    @if (Composer.IsCompacting)
                    {
                        <span>Compacting…</span>
                    }
                    else
                    {
                        <text>📦 Compact 50%</text>
                    }
                </button>
                @if (_notifToggleAdminAllowed)
                {
                    <button @onclick="ToggleActiveNotifications"
                            disabled="@(!CanToggleActiveNotifications(_activeNotifMode, Composer.IsStreaming, _notifTogglePending))"
                            class="chat-action-btn">
                        @ActiveNotificationsButtonText
                    </button>
                }
                else
                {
                    <span class="chat-hint" title="Global / system-wide setting — only an administrator can change it">
                        🔒 Notifications (global setting)
                    </span>
                }
                @if (_restartRequiredForNotifications)
                {
                    <span class="chat-hint">⚠️ Restart required</span>
                }
                @if (!string.IsNullOrEmpty(_notifToggleError))
                {
                    <span class="chat-attach-error">@_notifToggleError</span>
                }
                <span class="text-muted chat-hint">
                    @(_messages.Count) msgs
                    @if (Composer.LastToolCalls > 0)
                    {
                        <text> · @Composer.LastToolCalls tools</text>
                    }
                    @{
                        var stats = Composer.GetStats();
                        var ctxClass = stats is not null
                            ? (stats.ContextUsagePercent >= 90 ? "chat-ctx-danger" : stats.ContextUsagePercent >= 70 ? "chat-ctx-warn" : "chat-ctx-ok")
                            : "";
                        // Computed DURING RENDER from the Composer's current usage snapshot, so the
                        // figures refresh on the re-renders the page already performs (a stream ends:
                        // HandleStreamingUpdate; a compaction finishes: HandleCompacted) — no new
                        // events, timers or polling. A disconnected Composer reports no usage and the
                        // span below simply does not render.
                        var usageStatus = BuildUsageStatus(Composer.GetUsage());
                    }
                    @if (stats is not null)
                    {
                        <text> · ctx <span class="@ctxClass">@stats.ContextUsagePercent%</span></text>
                    }
                    @if (usageStatus.Text.Length > 0)
                    {
                        <span title="@usageStatus.Tooltip">@usageStatus.Text</span>
                    }
                    @if (Composer.IsCompacting)
                    {
                        <span class="chat-ctx-compacting"> · Compacting…</span>
                    }
                    else if (Composer.WasCompacted)
                    {
                        <span class="chat-ctx-compacted"> · Compacted</span>
                    }
                </span>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// Internal immutable view-state record the Razor markup reads DIRECTLY. The page computes
    /// its render state from this record; tests construct it from mock Composer state and assert
    /// its flags — never markup tokens or an HTML string. This is the production seam.
    /// <para>
    /// It carries BOTH dimensions: the circuit's runtime selection (which fails closed — a denied or
    /// faulted selection hides the whole Composer) and the bound Composer's own connection state.
    /// </para>
    /// </summary>
    /// <param name="IsConnected">Whether the Composer is connected (has an active model).</param>
    /// <param name="ShowModelPicker">Whether the model picker is rendered (always true — reachable even while disconnected).</param>
    /// <param name="ShowConnectedControls">Whether the connected-only controls (thread, Send, Compact, Reset, reasoning select) are rendered.</param>
    /// <param name="ShowNotConfiguredNotice">Whether the "No model configured" notice is shown.</param>
    /// <param name="Placeholder">The no-selection placeholder label for the model select, or <c>null</c> when none.</param>
    /// <param name="ShowForbidden">Whether the forbidden view is rendered INSTEAD of any Composer content.</param>
    /// <param name="ShowRuntimeError">Whether a fixed, secret-free runtime error is rendered.</param>
    /// <param name="RuntimeError">The error text for <paramref name="ShowRuntimeError"/>; otherwise <c>null</c>.</param>
    /// <param name="ShowDeferredNotice">Whether the still-deferred notice (with its ONE connect control) is rendered.</param>
    internal sealed record ComposerChatViewState(
        bool IsConnected,
        bool ShowModelPicker,
        bool ShowConnectedControls,
        bool ShowNotConfiguredNotice,
        string? Placeholder,
        bool ShowForbidden = false,
        bool ShowRuntimeError = false,
        string? RuntimeError = null,
        bool ShowDeferredNotice = false)
    {
        /// <summary>
        /// Whether this render may show Composer content at all. A forbidden or faulted runtime
        /// selection shows none: no thread, no catalog, no controls.
        /// </summary>
        internal bool ShowsComposerContent => !ShowForbidden && !ShowRuntimeError;
    }

    /// <summary>
    /// The placeholder label for the model select's no-selection option. A non-empty list with
    /// no valid default must NOT visually auto-select the first option without firing a change
    /// event — the placeholder is the explicit no-selection state.
    /// </summary>
    internal const string ModelSelectPlaceholder = "— select a model —";

    /// <summary>
    /// Computes the page's render state from the Composer's connection state. The markup reads
    /// this record directly; tests assert its flags.
    /// </summary>
    /// <param name="isConnected">Whether the Composer is connected.</param>
    internal static ComposerChatViewState ComputeViewState(bool isConnected) => new(
        IsConnected: isConnected,
        ShowModelPicker: true,
        ShowConnectedControls: isConnected,
        ShowNotConfiguredNotice: !isConnected,
        Placeholder: ModelSelectPlaceholder);

    /// <summary>
    /// Computes the page's render state from BOTH the circuit's runtime selection and the bound
    /// Composer's connection state. The runtime status dominates: a forbidden, faulted or deferred
    /// selection decides what may be shown regardless of what a previously bound Composer reported.
    /// </summary>
    /// <param name="status">The circuit's current runtime status.</param>
    /// <param name="isConnected">Whether the BOUND Composer is connected (ignored when nothing is bound).</param>
    /// <param name="runtimeError">The fixed runtime error text for the failed/removed statuses.</param>
    internal static ComposerChatViewState ComputeViewState(
        ComposerCircuitStatus status, bool isConnected, string? runtimeError)
    {
        switch (status)
        {
            case ComposerCircuitStatus.Forbidden:
                // NOTHING renders: no picker, no thread, no controls, no "configure a model" hint — a
                // caller who may not use the Composer learns nothing about its state.
                return new ComposerChatViewState(
                    IsConnected: false,
                    ShowModelPicker: false,
                    ShowConnectedControls: false,
                    ShowNotConfiguredNotice: false,
                    Placeholder: null,
                    ShowForbidden: true);

            case ComposerCircuitStatus.Failed:
            case ComposerCircuitStatus.Removed:
                // A fixed, secret-free error and NO content: the handle is unusable until the next operation.
                return new ComposerChatViewState(
                    IsConnected: false,
                    ShowModelPicker: false,
                    ShowConnectedControls: false,
                    ShowNotConfiguredNotice: false,
                    Placeholder: null,
                    ShowRuntimeError: true,
                    RuntimeError: runtimeError ?? ComposerRuntimeFacade.RuntimeUnavailableError);

            case ComposerCircuitStatus.Deferred:
                // Deferred: shell metadata only (no thread, no connected controls) plus the ONE connect
                // control that keeps the page actionable.
                return new ComposerChatViewState(
                    IsConnected: false,
                    ShowModelPicker: true,
                    ShowConnectedControls: false,
                    ShowNotConfiguredNotice: false,
                    Placeholder: ModelSelectPlaceholder,
                    ShowDeferredNotice: true);

            case ComposerCircuitStatus.Ready:
                return ComputeViewState(isConnected);

            default:
                // No silent fallback for an undefined status: an unhandled value is a bug.
                throw new InvalidOperationException($"Unexpected Composer circuit status: {status}.");
        }
    }

    private ComposerChatViewState ViewState => ComputeViewState(CircuitStatus, HasBoundComposer && Composer.IsConnected, _circuitError);

    /// <summary>
    /// Internal immutable usage view the Razor markup reads DIRECTLY: the SHORT text appended to the
    /// chat status bar plus the TOOLTIP lines carrying the full breakdown. Tests construct it from
    /// mock snapshots and assert its text — never markup tokens or an HTML string. This is the
    /// production seam.
    /// </summary>
    /// <param name="Text">The status-bar text (empty when there is nothing to show), including its leading separator.</param>
    /// <param name="TooltipLines">The tooltip's lines, in render order; empty when there is nothing to show.</param>
    internal sealed record ComposerChatUsageStatus(string Text, IReadOnlyList<string> TooltipLines)
    {
        /// <summary>
        /// The tooltip as the markup's <c>title</c> attribute needs it: the lines joined with
        /// newlines, so every figure occupies its own line in the browser's tooltip.
        /// </summary>
        internal string Tooltip => string.Join("\n", TooltipLines);
    }

    /// <summary>
    /// Builds the chat status bar's token-usage view from the Composer's usage snapshot, or an empty
    /// view when the Composer is disconnected (a <c>null</c> snapshot) — in which case the status bar
    /// keeps exactly its previous content.
    /// <para>
    /// The snapshot's members are DELIBERATELY overlapping views of the same model calls, and this
    /// method NEVER sums them: <c>Session</c> already contains the manual compactions (shown as their
    /// own "included in session" line) and does NOT contain the clarifications (which run on forked
    /// sessions and get their own line), so each figure is rendered exactly once, from the member that
    /// answers its own question.
    /// </para>
    /// <para>
    /// Pure and side-effect free: the snapshot is only read, so calling this during a render can never
    /// perturb the usage state the next read reports.
    /// </para>
    /// </summary>
    /// <param name="usage">The Composer's usage snapshot, or <c>null</c> while disconnected.</param>
    /// <returns>The status text plus the tooltip lines for the current snapshot.</returns>
    internal static ComposerChatUsageStatus BuildUsageStatus(ComposerUsageSnapshot? usage)
    {
        // Disconnected: the Composer reports no usage at all, so the status bar contributes nothing —
        // neither text nor a tooltip.
        if (usage is null) return new ComposerChatUsageStatus("", []);

        var text = "";

        // The most recent completed turn: the freshest figure. Null until a turn completes, and
        // cleared when a new stream starts, so an in-flight turn contributes no turn figure at all.
        var lastTurn = usage.LastTurn;

        // The live session's cumulative usage. A zero-call session has nothing to show in the bar
        // (its tooltip line still renders, so the breakdown is never ambiguous).
        var session = usage.Session;

        if (lastTurn is not null)
        {
            text += $" · turn {UsageFormat.FormatCompactTotal(lastTurn.Total)}";
        }

        if (session.Total.Calls > 0)
        {
            text += $" · session {UsageFormat.FormatCompactTotal(session.Total)}";
        }

        var lines = new List<string>();

        // Per-turn line first (only once a turn completed), then the session total with its
        // per-(source, model) breakdown. The session line and its entries are unconditional: they are
        // the anchor the other figures are read against.
        if (lastTurn is not null)
        {
            lines.Add($"Last turn: {UsageFormat.FormatUsageLine(lastTurn.Total)}");
        }

        lines.Add($"Session: {UsageFormat.FormatUsageLine(session.Total)}");
        lines.AddRange(UsageFormat.FormatEntryLines(session));

        // Clarifications are NOT part of Session (forked sessions whose usage is reset), so their
        // calls reach no session total: the line is shown only when clarifications were actually
        // answered, and it is never folded into another number.
        if (usage.Clarifications.Total.Calls > 0)
        {
            lines.Add($"Clarifications (since start): {UsageFormat.FormatUsageLine(usage.Clarifications.Total)}");
        }

        // Manual compactions ARE a subset of Session: the label states that, so the two lines can
        // never be mistaken for figures to add up.
        if (usage.ManualCompactions.Total.Calls > 0)
        {
            lines.Add($"Manual compactions (since start, included in session): {UsageFormat.FormatUsageLine(usage.ManualCompactions.Total)}");
        }

        return new ComposerChatUsageStatus(text, lines);
    }

    private sealed class ChatMessage
    {
        public required string Role { get; init; }
        public string Content { get; set; } = "";
    }

    /// <summary>
    /// The circuit's cascading authentication state, handed to EVERY identity-aware facade call.
    /// ABSENT in open mode — <c>Program.cs</c> registers <c>AddCascadingAuthenticationState</c> only
    /// when authentication is enabled — in which case no cascade arrives, the helper yields a null
    /// identity and the resolver answers with the open-mode local operator, so backward
    /// compatibility is unchanged and nothing throws.
    /// </summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>
    /// The identity to hand to one identity-aware facade call: this circuit's authenticated
    /// principal, or null when no cascade exists (open mode / signed out). It is an IDENTITY only —
    /// the facade re-resolves current role/enabled state on every operation.
    /// <para>
    /// This is also the page's MINIMAL circuit identity acquisition: the scoped
    /// <see cref="CopilotHive.Security.CircuitUserPrincipalAccessor"/> is initialised from the same
    /// cascading state exactly once per circuit. In open mode there is no cascade, so the accessor is
    /// left uninitialised (open mode needs none) and the identity is null — the facades then resolve
    /// the local operator exactly as before. Nothing here throws when auth services are absent.
    /// </para>
    /// </summary>
    private ValueTask<ClaimsPrincipal?> ActingUserAsync() =>
        ComponentActingUser.AcquireAsync(AuthenticationState, CircuitPrincipal);

    private readonly List<ChatMessage> _messages = [];
    private string _inputText = "";
    private HashSet<string> _selectedOptions = [];
    private string _questionFeedback = "";
    private List<string> _availableModels = [];
    private string _selectedModel = "";
    private ReasoningEffort _selectedReasoning = ReasoningEffort.None;
    private bool _subAgentsExpanded = false;
    private ComposerAttachment? _pending;
    private bool _uploading;
    private string? _attachmentError;
    private string? _sendError;
    private IJSObjectReference? _pasteModule;
    private DotNetObjectReference<ComposerChat>? _pasteDotNetRef;
    // Whether the paste module is installed on the CURRENT composer-input textarea. Set when the
    // textarea appears (post-connect on a disconnected-first page) and RESET whenever the connected
    // layout is removed (a refusal, a deferral, a failure): the listener is released with the textarea
    // it was attached to and a fresh one is installed on the NEXT textarea. Managed component JS only —
    // never a runtime.
    private bool _pasteInstalled;
    // Authoritative event-notification mode. Null until IConfigFacade.GetComposer() reports it —
    // a fabricated default would let the toggle persist a transition the server never implied.
    private string? _activeNotifMode;
    private bool _notifTogglePending;
    private bool _restartRequiredForNotifications;
    private string? _notifToggleError;
    /// <summary>
    /// Whether the CURRENT circuit user may change the INSTALLATION-WIDE event-notification mode.
    /// The toggle persists the global Composer setting through
    /// <see cref="IConfigFacade.SaveComposerAsync"/>, which requires
    /// <see cref="CopilotHive.Security.HiveCapability.GlobalAdmin"/> — so a non-admin must not be
    /// offered a control that could only fail. Derived from the circuit identity through the scoped
    /// <see cref="CopilotHive.Security.CircuitUserPrincipalAccessor"/> (which re-resolves current
    /// stored state); in open mode it is the local operator, so the pre-multi-user behaviour is
    /// unchanged. This gates RENDERING only: the facade independently re-resolves and refuses.
    /// </summary>
    private bool _notifToggleAdminAllowed;

    protected override async Task OnInitializedAsync()
    {
        PageHeader.SetTitle("💬 Composer");

        // THE CIRCUIT'S RUNTIME SELECTION, BEFORE ANY CONTENT IS READ: the accessor re-resolves this
        // circuit's identity from CURRENT stored state and requires InteractiveMember. A Viewer, a
        // signed-out caller or an authenticated refusal therefore never reaches the Composer at all.
        // In open mode the same call selects the explicit legacy singleton.
        try
        {
            _ = await AcquireCircuitRuntimeAsync(mutation: false, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _circuitError = ComposerRuntimeFacade.RuntimeUnavailableError;
            Console.Error.WriteLine($"[ComposerChat] Composer runtime selection failed: {ex.Message}");
        }

        // The available-models picker is ALWAYS loaded for a bound Composer — even while disconnected the
        // picker is reachable and enabled so the user can select a model to start. The current-model
        // endpoint returns {"model":null} while disconnected (frozen contract), so loading it is harmless
        // and keeps the select in its placeholder state.
        if (HasBoundComposer)
        {
            await LoadAvailableModelsAsync();
            if (Composer.IsConnected)
            {
                LoadHistory();
                await LoadCurrentModelAsync();
            }
        }

        // The notification toggle persists a GLOBAL (installation-wide) setting, so its rendering is
        // gated on the caller's CURRENT GlobalAdmin capability. This is also the page's explicit
        // circuit identity acquisition: the scoped accessor is initialised from the cascading
        // AuthenticationState here (no-op in open mode, where no cascade exists and the local
        // operator holds every capability). A failure to answer renders the toggle HIDDEN — the
        // facade would refuse the write anyway, so a stale flag can only under-render.
        try
        {
            _notifToggleAdminAllowed = await ComponentActingUser.IsAllowedAsync(
                AuthenticationState,
                CircuitPrincipal,
                CopilotHive.Security.HiveCapability.GlobalAdmin,
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            _notifToggleAdminAllowed = false;
            _notifToggleError = $"Could not verify administrator permissions: {ex.Message}";
        }

        // The config endpoint is independent of the Composer agent connection, so the
        // notification mode is loaded either way — otherwise a disconnected-then-reconnected
        // page would render the toggle from an unloaded state.
        await LoadActiveNotificationsModeAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Whether the paste module should be installed on the current render. The module is
    /// installed when the composer-input textarea FIRST appears — on a connected-first page
    /// that is the first render; on a disconnected-first page it is the render after a
    /// successful first-connect. Installed EXACTLY ONCE (tracked by the caller's install
    /// state); never installed while disconnected (no textarea exists).
    /// </summary>
    /// <param name="alreadyInstalled">Whether the module has already been installed.</param>
    /// <param name="showConnectedControls">Whether the connected layout (with the textarea) is rendered.</param>
    internal static bool ShouldInstallPasteModule(bool alreadyInstalled, bool showConnectedControls)
        => !alreadyInstalled && showConnectedControls;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("eval",
            "document.getElementById('chat-anchor')?.scrollIntoView()");

        // THE LISTENER FOLLOWS THE TEXTAREA. When the connected layout is gone (a refusal, a deferral, a
        // failure, a removed runtime) the textarea the listener was attached to is detached: release the
        // listener NOW instead of at disposal, so the JS module never keeps a detached element and a paste can
        // never be intercepted for a page that shows no composer.
        if (_pasteInstalled && !ViewState.ShowConnectedControls)
            await ReleasePasteListenerAsync();

        // The paste module is installed when the composer-input textarea APPEARS — on a connected-first page
        // that is the first render; on a disconnected-first page (or after a Deferred -> Connect -> Ready
        // replacement, which creates a NEW textarea) it is the render after the connect. Installed once per
        // textarea (tracked by _pasteInstalled); never installed while no textarea exists.
        if (ShouldInstallPasteModule(_pasteInstalled, ViewState.ShowConnectedControls))
        {
            // LIFECYCLE OWNERSHIP: the flag is set before the import await (so a second render cannot start a second
            // import), and the generation identifies THIS install attempt. Every release bumps the generation, so
            // the continuation below can tell — when it resumes — whether it still owns the lifecycle.
            _pasteInstalled = true;
            var generation = _pasteGeneration;

            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/composer-paste.js");

            // RE-VALIDATE AT RESUMPTION, BEFORE ANY INSTALL OR REFERENCE RETENTION: a refusal/removal that rendered
            // while the import was outstanding released the lifecycle (new generation) or removed the textarea. The
            // late module belongs to a textarea that is gone: dispose it, install nothing, retain nothing, and leave
            // the flag clear (only if no newer attempt already owns it).
            if (generation != _pasteGeneration || !ViewState.ShowConnectedControls)
            {
                if (generation == _pasteGeneration)
                    _pasteInstalled = false;

                try
                {
                    await module.DisposeAsync();
                }
                catch (JSDisconnectedException)
                {
                    // Circuit teardown: the module reference dies with the circuit.
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"[ComposerChat] Paste module disposal failed: {ex.Message}");
                }

                return;
            }

            _pasteModule = module;
            _pasteDotNetRef = DotNetObjectReference.Create(this);
            await _pasteModule.InvokeVoidAsync("install", "composer-input", _pasteDotNetRef);
            await SyncPasteAllowedAsync();
        }
    }

    // Identifies the current paste-listener lifecycle. Bumped by every release so an in-flight import (or any
    // other continuation that captured it) can tell it no longer owns the lifecycle when it resumes.
    private int _pasteGeneration;

    /// <summary>
    /// Uninstalls and disposes this component's paste JS (listener, module reference, .NET reference) and resets
    /// the install flag so the NEXT connected textarea gets a fresh listener. Each step is independently attempted
    /// and a fault is logged, never thrown. It manages component JS only — never a runtime.
    /// </summary>
    private async Task ReleasePasteListenerAsync()
    {
        // DETACH EVERY OWNED RESOURCE SYNCHRONOUSLY, BEFORE THE FIRST AWAIT: this release owns exactly the module AND
        // the .NET reference that were installed when it started. A NEWER install that appears while the uninstall
        // response is outstanding writes the shared fields afresh and is therefore never visible to — or cleaned
        // up by — this release.
        _pasteInstalled = false;
        _pasteGeneration++;
        var module = _pasteModule;
        _pasteModule = null;
        var dotNetRef = _pasteDotNetRef;
        _pasteDotNetRef = null;

        if (module is not null)
        {
            // Independently attempted: an uninstall fault must not skip the module disposal.
            try
            {
                await module.InvokeVoidAsync("uninstall");
            }
            catch (JSDisconnectedException)
            {
                // Circuit teardown / navigation: the browser is already gone — expected, not a fault.
            }
            catch (Exception ex)
            {
                // Never silently swallowed: re-throwing here would mask whatever triggered
                // disposal, so an unexpected teardown fault is surfaced in the logs instead.
                Console.Error.WriteLine($"[ComposerChat] Paste module uninstall failed: {ex.Message}");
            }

            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit teardown / navigation: the module reference dies with the circuit.
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[ComposerChat] Paste module disposal failed: {ex.Message}");
            }
        }

        // ONLY the reference this release detached: never the shared field, which may now hold a newer install's.
        dotNetRef?.Dispose();
    }

    /// <summary>
    /// Mirrors the authoritative .NET paste-allowed state into the JS module so a paste that can
    /// never be accepted is not intercepted in the first place. The .NET side still re-validates.
    /// </summary>
    private async Task SyncPasteAllowedAsync()
    {
        if (_pasteModule is null) return;
        await _pasteModule.InvokeVoidAsync("setAllowed", PasteAllowedNow);
    }

    /// <summary>
    /// The paste-allowed state to mirror to JS RIGHT NOW. An UNBOUND page (forbidden / failed / removed / deferred)
    /// is never allowed — an idle page with nothing bound is not "idle and ready", it is closed — and a bound one
    /// follows <see cref="ComputePasteAllowed"/> exactly as before.
    /// </summary>
    private bool PasteAllowedNow =>
        CircuitStatus == ComposerCircuitStatus.Ready
        && HasBoundComposer
        && ComputePasteAllowed(IsBoundStreaming, _uploading, _pending);

    /// <summary>
    /// Whether the CURRENTLY BOUND Composer is streaming. With nothing bound (forbidden / failed /
    /// removed / before the first selection) the page is idle, never streaming.
    /// </summary>
    private bool IsBoundStreaming => HasBoundComposer && Composer.IsStreaming;

    /// <summary>
    /// Whether a clipboard paste may currently produce a pending attachment. A paste is refused
    /// while another attachment is pending, while an upload is running and while the Composer is
    /// streaming, so an existing pending attachment can never be replaced or orphaned.
    /// </summary>
    /// <param name="isStreaming">Whether the Composer is streaming.</param>
    /// <param name="uploading">Whether an attachment upload is already in flight.</param>
    /// <param name="pending">The current pending attachment, if any.</param>
    internal static bool ComputePasteAllowed(bool isStreaming, bool uploading, object? pending)
        => !isStreaming && !uploading && pending is null;


    private void LoadHistory()
    {
        _messages.Clear();

        // NO CONTENT WITHOUT A BINDING: a forbidden/failed/removed selection (or the moment before the
        // first selection) must never show another account's thread.
        if (!HasBoundComposer)
            return;

        foreach (var (role, content) in Composer.GetChatHistory())
        {
            if (role == "user")
            {
                var (eventBlock, userMessage) = Composer.TrySplitEventBlock(content);
                if (eventBlock is not null)
                    _messages.Add(new ChatMessage { Role = "system", Content = eventBlock });
                // Active system notifications are E0-envelope-wrapped with a
                // "[System Notification]" prefix — render them as system messages.
                if (userMessage.StartsWith("[System Notification]", StringComparison.Ordinal))
                    _messages.Add(new ChatMessage { Role = "system", Content = userMessage });
                else
                    _messages.Add(new ChatMessage { Role = "user", Content = userMessage });
            }
            else
            {
                _messages.Add(new ChatMessage { Role = role, Content = content });
            }
        }
    }

    /// <summary>
    /// A streaming update from the Composer this circuit is subscribed to. The handler is QUEUE-able, so the
    /// binding is captured when it fires and re-checked when the body finally runs: a callback queued before a
    /// demotion or a runtime replacement must not re-render content from the runtime it no longer shows.
    /// </summary>
    private void HandleStreamingUpdate()
    {
        // CAPTURED SYNCHRONOUSLY, on the raising thread: the token is the binding that raised this event.
        var captured = CurrentCallbackBinding;

        QueueCallback(async () =>
        {
            // THE FRESHNESS GUARD: a queued callback for a replaced/fail-closed binding, or for a caller who has
            // since been demoted or disabled, does nothing at all — it neither re-renders content nor re-syncs
            // the paste mirror from the runtime it no longer shows.
            if (await DropStaleCallbackAsync(captured, CancellationToken.None))
                return;

            // When streaming finishes, reload history to get the final message
            if (!IsBoundStreaming)
            {
                LoadHistory();
            }
            StateHasChanged();

            // CRITICAL: streaming toggles paste availability. Without this the JS mirror would
            // stay allowed=false forever once a stream ends, permanently killing paste.
            await SyncPasteAllowedAsync();
        });
    }

    private async Task SendMessage()
    {
        if (!CanSend) return;

        _sendError = null;

        // FRESH SELECTION FOR THE SEND: the operation re-queries the accessor, so a demotion or
        // disablement since the last render refuses the send instead of streaming into a runtime the
        // caller no longer holds. A deferred/shell runtime is connected by the send itself.
        Composer? composer;
        try
        {
            composer = await AcquireComposerForMutationAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _sendError = ComposerRuntimeFacade.RuntimeUnavailableError;
            Console.Error.WriteLine($"[ComposerChat] Composer runtime selection failed: {ex.Message}");
            StateHasChanged();
            return;
        }

        if (composer is null)
        {
            // Denied, still deferred, failed or removed: no content is produced and the failure is stated.
            _sendError = _circuitError ?? ComposerRuntimeAccessError;
            StateHasChanged();
            return;
        }

        // The attachment path is resolved against the SAME selection the message is sent to, so a
        // per-user attachment can never be addressed through another account's root.
        ComposerAttachmentService attachments;
        try
        {
            attachments = BoundAttachments ?? throw new InvalidOperationException(
                "A bound Composer must carry its attachment service.");
        }
        catch (Exception ex)
        {
            _sendError = ex.Message;
            StateHasChanged();
            return;
        }

        string text;
        if (_pending is not null)
        {
            var ext = Path.GetExtension(_pending.SavedRelativePath);
            var absPath = Path.Combine(attachments.AttachmentsRootPath, _pending.SavedRelativePath);
            text = BuildAttachmentMessage(_inputText, _pending.DisplayName, ext, absPath);
        }
        else
        {
            text = _inputText.Trim();
        }

        string? eventBlock = null;
        try
        {
            eventBlock = await composer.SendMessageWithEventsAsync(text);
        }
        catch (Exception ex)
        {
            _sendError = ex.Message;
            StateHasChanged();
            return;
        }

        if (eventBlock is not null)
            _messages.Add(new ChatMessage { Role = "system", Content = eventBlock });

        _messages.Add(new ChatMessage { Role = "user", Content = text });

        // Call Composer.SendMessageWithEventsAsync first. Only after it returns without throwing do we
        // perform destructive state transitions (MarkAsSent, clear pending/input/error).
        // This keeps _pending and _inputText intact for retry if the call fails.
        if (_pending is not null)
        {
            attachments.MarkAsSent(_pending);
            _pending = null;
        }

        _inputText = "";
        _attachmentError = null;
        StateHasChanged();
        await SyncPasteAllowedAsync();
    }

    /// <summary>
    /// The fixed, sanitized notice for a mutation that could not run because the runtime selection was
    /// denied or is not (yet) usable. It names no account, model, provider or credential.
    /// </summary>
    internal const string ComposerRuntimeAccessError =
        "The Composer is not available for this account right now. Retry the operation; if it persists, "
        + "check that your account is enabled and has access to the selected model.";

    internal static string BuildAttachmentMessage(string? userText, string displayName, string extension, string savedAbsPath)
    {
        var kind = extension.TrimStart('.').Equals("pdf", StringComparison.OrdinalIgnoreCase) ? "pdf" : "image";
        var encodedPath = System.Text.Json.JsonSerializer.Serialize(savedAbsPath);
        var encodedName = System.Text.Json.JsonSerializer.Serialize(displayName);
        var block = " [Attached " + kind + " file " + encodedName + "; saved at " + encodedPath
            + ". To analyze it, delegate to a vision-capable sub-agent with start_sub_agent(task: \"Analyze this attachment\", image_paths: ["
            + encodedPath + "]).]";
        if (string.IsNullOrWhiteSpace(userText))
            return "The user attached a file with no accompanying text." + block;
        return userText.TrimEnd() + block;
    }

    internal static bool ComputeCanSend(bool isStreaming, bool uploading, string inputText, object? pending)
        => !isStreaming && !uploading && (!string.IsNullOrWhiteSpace(inputText) || pending is not null);

    private bool CanSend => ComputeCanSend(IsBoundStreaming, _uploading, _inputText, _pending);

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _attachmentError = null;
        var file = e.File;
        if (file is null || file.Size == 0)
        {
            _attachmentError = "No file selected or file is empty.";
            StateHasChanged();
            return;
        }

        // NO ATTACHMENT WITHOUT A BINDING: the upload is written into the SELECTED runtime's own attachment
        // store, so a forbidden/failed/removed selection must refuse the upload instead of writing anywhere.
        if (BoundAttachments is null)
        {
            _attachmentError = ComposerRuntimeAccessError;
            StateHasChanged();
            return;
        }

        _uploading = true;

        // Mirrored BEFORE the first await: while the picker upload runs, a paste must be left
        // alone by JS rather than intercepted and then silently dropped by the .NET guard —
        // that would swallow the user's clipboard content with no feedback. Best-effort: a
        // failing mirror update must not abort the upload and strand the _uploading claim.
        await TrySyncPasteAllowedAsync(PasteHost);

        try
        {
            // maxAllowedSize is MaxAttachmentBytes + 1 so files at exactly the cap pass
            // and files exceeding it throw IOException (Blazor throws IOException, NOT FileLoadException)
            await using var stream = file.OpenReadStream(
                maxAllowedSize: ComposerAttachmentService.MaxAttachmentBytes + 1);
            await SaveAttachmentAsync(file.Name, stream);
        }
        catch (IOException ex)
        {
            _attachmentError = ex.Message; // includes oversize rejection
        }
        catch (Exception ex)
        {
            _attachmentError = ex.Message;
        }
        finally
        {
            _uploading = false;
            StateHasChanged();

            // Best-effort: a failing mirror update must not mask the upload's own outcome.
            await TrySyncPasteAllowedAsync(PasteHost);
        }
    }

    /// <summary>
    /// Narrow seam over the component state the paste flow touches, so the PRODUCTION handler
    /// body (<see cref="HandlePasteCoreAsync"/> and <see cref="SaveAttachmentAsync(IPasteHost, string, Stream)"/>)
    /// can be exercised by tests without a live Blazor circuit. The component itself is the only
    /// production implementation.
    /// </summary>
    internal interface IPasteHost
    {
        /// <summary>The currently staged attachment, if any.</summary>
        ComposerAttachment? Pending { get; set; }

        /// <summary>Whether an attachment upload is in flight.</summary>
        bool Uploading { get; set; }

        /// <summary>Error surfaced under the input area, if any.</summary>
        string? AttachmentError { get; set; }

        /// <summary>Whether the Composer is currently streaming a response.</summary>
        bool IsStreaming { get; }

        /// <summary>Streams the content into the attachment store.</summary>
        /// <param name="originalName">Display name recorded for the attachment.</param>
        /// <param name="content">Content stream; never fully buffered.</param>
        Task<AttachmentSaveResult> SaveAsync(string originalName, Stream content);

        /// <summary>
        /// THE COMPLETION GUARD: whether the asynchronous write that just finished may still be reflected in this
        /// circuit's state — i.e. the binding that started it is still current AND the caller still holds
        /// <see cref="CopilotHive.Security.HiveCapability.InteractiveMember"/>. The component re-queries its
        /// scoped runtime accessor here, so a demotion, a disablement or a runtime replacement that landed while
        /// the upload was in flight is observed at completion time.
        /// </summary>
        /// <param name="ct">Caller cancellation; cancellation propagates.</param>
        /// <returns><c>true</c> only when the outcome may be applied.</returns>
        Task<bool> IsCompletionStillAuthorizedAsync(CancellationToken ct);

        /// <summary>Requests a re-render (the component's <c>StateHasChanged</c>).</summary>
        void Notify();

        /// <summary>Mirrors the authoritative paste-allowed state into the JS module.</summary>
        Task SyncPasteAllowedAsync();
    }

    /// <summary>Binds <see cref="IPasteHost"/> to this component's own fields and services.</summary>
    private sealed class ComponentPasteHost(ComposerChat owner) : IPasteHost
    {
        /// <summary>
        /// THE FRESHNESS TOKEN for this host's IN-FLIGHT asynchronous write: the binding that was current when the
        /// write STARTED. It is refreshed by every <see cref="SaveAsync"/>, so it always describes the write being
        /// observed — and a save that completes after the runtime was replaced (or after the selection became
        /// fail-closed) is dropped rather than attached to a runtime this circuit no longer shows.
        /// </summary>
        private ComposerCircuitBinding? _capturedBinding;

        /// <inheritdoc />
        public ComposerAttachment? Pending
        {
            get => owner._pending;
            set => owner._pending = value;
        }

        /// <inheritdoc />
        public bool Uploading
        {
            get => owner._uploading;
            set => owner._uploading = value;
        }

        /// <inheritdoc />
        public string? AttachmentError
        {
            get => owner._attachmentError;
            set => owner._attachmentError = value;
        }

        /// <inheritdoc />
        public bool IsStreaming => owner.IsBoundStreaming;

        /// <inheritdoc />
        public async Task<AttachmentSaveResult> SaveAsync(string originalName, Stream content)
        {
            // THE START GATE: one FRESH selection through the accessor BEFORE any byte reaches a store. A write
            // begun after access was revoked (or after the runtime was removed/replaced) must never start; the
            // completion guard below is a separate, additional requirement for a write that did start.
            var attachments = await owner.AuthorizeAttachmentWriteAsync();

            // CAPTURED AT THE START OF THE WRITE: this is the binding whose freshness the completion must prove —
            // the one the start gate just selected, so it is the binding the write is actually going into.
            _capturedBinding = owner.CurrentCallbackBinding;

            if (attachments is null)
                return new AttachmentSaveResult(false, null, ComposerRuntimeAccessError);

            return await attachments.SaveAsync(originalName, content);
        }

        /// <inheritdoc />
        public void Notify() => owner.StateHasChanged();

        /// <inheritdoc />
        public Task SyncPasteAllowedAsync() => owner.SyncPasteAllowedAsync();

        /// <summary>
        /// THE COMPLETION GUARD for this component: the binding the write started under, re-checked through the
        /// component's own freshness seam (the O(1) binding check plus ONE fresh authorization re-check).
        /// </summary>
        /// <param name="ct">Caller cancellation; cancellation propagates.</param>
        public Task<bool> IsCompletionStillAuthorizedAsync(CancellationToken ct) =>
            owner.IsCompletionStillAuthorizedAsync(_capturedBinding, ct);
    }

    private IPasteHost? _pasteHost;

    private IPasteHost PasteHost => _pasteHost ??= new ComponentPasteHost(this);

    /// <summary>
    /// Shared save path for BOTH the file picker and a clipboard paste: streams the content into
    /// <see cref="ComposerAttachmentService.SaveAsync"/> and reflects the outcome in the pending
    /// attachment / error state. The caller owns the stream, its size guard and its exception
    /// handling (the picker's <see cref="IOException"/> oversize contract is picker-specific).
    /// </summary>
    /// <remarks>
    /// THE COMPLETION IS RE-AUTHORIZED BEFORE ITS OUTCOME IS APPLIED: the write runs, then the host re-checks
    /// that the binding which started it is still the current one AND that the caller still holds
    /// <see cref="CopilotHive.Security.HiveCapability.InteractiveMember"/>. A write that completes after a
    /// demotion, a disablement or a
    /// runtime replacement is NOT attached to this circuit — it becomes an orphaned file in the store that
    /// accepted it, which is strictly safer than re-attaching a stale upload to a runtime the user may no
    /// longer use.
    /// </remarks>
    /// <param name="host">State seam the outcome is written to.</param>
    /// <param name="originalName">Display name recorded for the attachment.</param>
    /// <param name="stream">Content stream; never fully buffered.</param>
    internal static async Task SaveAttachmentAsync(IPasteHost host, string originalName, Stream stream)
    {
        ArgumentNullException.ThrowIfNull(host);
        ArgumentNullException.ThrowIfNull(stream);

        host.Uploading = true;
        try
        {
            var result = await host.SaveAsync(originalName, stream);

            // THE COMPLETION GUARD, on EVERY path that would reflect the write in component state.
            if (!await host.IsCompletionStillAuthorizedAsync(CancellationToken.None))
                return;

            if (result.Success && result.Attachment is not null)
            {
                host.Pending = result.Attachment;
            }
            else
            {
                host.AttachmentError = result.Error ?? "Failed to save attachment.";
            }
        }
        finally
        {
            host.Uploading = false;
        }
    }

    /// <summary>Runs the shared save path against this component's own state.</summary>
    /// <param name="originalName">Display name recorded for the attachment.</param>
    /// <param name="stream">Content stream; never fully buffered.</param>
    private Task SaveAttachmentAsync(string originalName, Stream stream)
        => SaveAttachmentAsync(PasteHost, originalName, stream);

    /// <summary>
    /// Maps a supported clipboard MIME type to the extension used for the generated file name.
    /// Any other value is an unsupported clipboard item and is rejected before any save.
    /// </summary>
    internal static readonly IReadOnlyDictionary<string, string> PasteMimeExtensions =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["image/png"] = "png",
            ["image/jpeg"] = "jpg",
            ["image/gif"] = "gif",
            ["image/webp"] = "webp",
            ["application/pdf"] = "pdf",
        };

    /// <summary>Error surfaced when a clipboard item's MIME type is missing or unsupported.</summary>
    internal const string UnsupportedClipboardItemError = "Unsupported clipboard item.";

    /// <summary>Error surfaced when a clipboard item declares no bytes (matches the picker's empty-file error).</summary>
    internal const string EmptyAttachmentError = "No file selected or file is empty.";

    /// <summary>
    /// Authoritative validation for a pasted clipboard item, mirroring the JS-side filter.
    /// Returns the extension to use when the paste is acceptable; otherwise <c>null</c> and the
    /// error to surface, and NO save must be attempted.
    /// </summary>
    /// <param name="mimeType">MIME type reported by the clipboard item.</param>
    /// <param name="declaredLength">Declared byte length of the clipboard blob.</param>
    /// <param name="error">Error to surface when the paste is rejected; otherwise <c>null</c>.</param>
    internal static string? ValidatePaste(string? mimeType, long declaredLength, out string? error)
    {
        if (string.IsNullOrWhiteSpace(mimeType) || !PasteMimeExtensions.TryGetValue(mimeType, out var ext))
        {
            error = UnsupportedClipboardItemError;
            return null;
        }

        if (declaredLength <= 0)
        {
            error = EmptyAttachmentError;
            return null;
        }

        error = null;
        return ext;
    }

    /// <summary>
    /// Builds the generated name for a pasted attachment: <c>paste-{yyyyMMdd-HHmmss}.{ext}</c>.
    /// </summary>
    /// <param name="extension">Extension without a leading dot (for example <c>png</c>).</param>
    /// <param name="utcNow">Timestamp used for the name (UTC).</param>
    internal static string BuildPasteFileName(string extension, DateTime utcNow)
        => $"paste-{utcNow:yyyyMMdd-HHmmss}.{extension}";

    /// <summary>
    /// Receives a pasted image/PDF blob streamed from the browser and funnels it into the SAME
    /// pending-attachment flow the file picker uses.
    /// </summary>
    /// <remarks>
    /// The JS <c>allowed</c> flag is only a mirror: this method re-validates state, MIME and size
    /// authoritatively. A stale mirror that let a paste through is dropped silently so an existing
    /// pending attachment is never replaced or orphaned.
    /// </remarks>
    /// <param name="streamRef">JS stream reference over the pasted blob.</param>
    /// <param name="mimeType">MIME type reported by the clipboard item.</param>
    /// <param name="declaredLength">Declared byte length of the blob.</param>
    [JSInvokable]
    public Task HandlePasteAsync(IJSStreamReference streamRef, string mimeType, long declaredLength)
        => HandlePasteCoreAsync(PasteHost, streamRef, mimeType, declaredLength);

    /// <summary>
    /// The PRODUCTION paste body, written against <see cref="IPasteHost"/> so tests exercise this
    /// exact code rather than a re-implementation.
    /// </summary>
    /// <remarks>
    /// Two invariants are enforced by the outer <c>finally</c>, on EVERY path (accepted, rejected
    /// or faulted): the <paramref name="streamRef"/> is disposed (it is owned by this call and
    /// leaks otherwise) and the JS allowed-state is re-synced (JS set <c>allowed = false</c>
    /// synchronously before invoking, so a rejection that skipped the sync would permanently
    /// disable paste).
    /// </remarks>
    /// <param name="host">State seam the outcome is written to.</param>
    /// <param name="streamRef">JS stream reference over the pasted blob; disposed here.</param>
    /// <param name="mimeType">MIME type reported by the clipboard item.</param>
    /// <param name="declaredLength">Declared byte length of the blob.</param>
    internal static async Task HandlePasteCoreAsync(
        IPasteHost host, IJSStreamReference streamRef, string? mimeType, long declaredLength)
    {
        ArgumentNullException.ThrowIfNull(host);
        ArgumentNullException.ThrowIfNull(streamRef);

        try
        {
            // Stale-mirror guard: .NET state changed after setAllowed(true) was mirrored. Drop the
            // paste silently — never save over / orphan the existing pending attachment.
            if (!ComputePasteAllowed(host.IsStreaming, host.Uploading, host.Pending))
                return;

            host.AttachmentError = null;

            var ext = ValidatePaste(mimeType, declaredLength, out var validationError);
            if (ext is null)
            {
                host.AttachmentError = validationError;
                host.Notify();
                return;
            }

            // Claimed BEFORE the first await so a second paste (or a picker upload) starting
            // while the stream is being opened is refused by the guard above rather than racing
            // this one. SaveAttachmentAsync re-sets it (harmlessly) and clears it in its finally.
            host.Uploading = true;

            // Accepting the paste is itself a transition .NET must mirror: JS set allowed = false
            // for THIS paste only, and the authoritative upload-in-progress state is ours.
            await TrySyncPasteAllowedAsync(host);

            var generatedName = BuildPasteFileName(ext, DateTime.UtcNow);

            try
            {
                // The declared length is used verbatim: the framework default is far below the
                // attachment cap. SaveAsync is the bounded reader and the size authority — it
                // rejects oversize content with "attachment exceeds 20 MiB".
                await using var stream = await streamRef.OpenReadStreamAsync(maxAllowedSize: declaredLength);
                await SaveAttachmentAsync(host, generatedName, stream);
            }
            catch (Exception ex)
            {
                host.AttachmentError = ex.Message;
            }
            finally
            {
                // Released even when the stream could never be opened (SaveAttachmentAsync,
                // which normally clears it, was never reached).
                host.Uploading = false;
            }

            host.Notify();
        }
        finally
        {
            // Two INDEPENDENT cleanup steps. The stream reference is owned by this invocation and
            // must be disposed on every path; the allowed-state mirror must be restored on every
            // path too (JS set allowed = false synchronously before invoking, so even a silent
            // stale-mirror drop has to restore it). The nested finally guarantees the sync runs
            // even when disposal throws something other than JSDisconnectedException.
            try
            {
                await streamRef.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit teardown: the browser-side reference is already gone.
            }
            finally
            {
                // Best-effort: a failing mirror update must not mask the paste's own outcome
                // (or a disposal fault that is propagating out of the try above).
                await TrySyncPasteAllowedAsync(host);
            }
        }
    }

    /// <summary>
    /// Mirrors the allowed-state to JS without ever throwing. The mirror is an optimisation —
    /// .NET re-validates every paste authoritatively — so a failed update must never mask the
    /// outcome of the operation that triggered it, nor a fault already propagating out of a
    /// cleanup path. Unexpected failures are logged rather than silently discarded.
    /// </summary>
    /// <param name="host">State seam whose mirror is updated.</param>
    private static async Task TrySyncPasteAllowedAsync(IPasteHost host)
    {
        try
        {
            await host.SyncPasteAllowedAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Paste allowed-state sync failed: {ex.Message}");
        }
    }

    private async Task RemoveAttachment()
    {
        if (_pending is null) return;

        // AUTHORIZE BEFORE THE MUTATION: removal deletes a file, so it needs the same fresh selection as any other
        // storage write. A demoted/refused caller's file is left exactly where it is, and the page leaves Ready.
        // The pending attachment belongs to the SELECTION that saved it, so it is removed through that
        // selection's own attachment store — never through a global one.
        ComposerAttachmentService? attachments;
        try
        {
            attachments = await AuthorizeAttachmentWriteAsync();
        }
        catch (Exception ex)
        {
            attachments = null;
            Console.Error.WriteLine($"[ComposerChat] Composer runtime selection failed: {ex.Message}");
        }

        // A different runtime (or a refusal) forgot the staged record while the selection ran: nothing to remove.
        if (attachments is null || _pending is null)
        {
            if (attachments is null)
                _attachmentError = ComposerRuntimeAccessError;
            StateHasChanged();
            await SyncPasteAllowedAsync();
            return;
        }

        var result = attachments.Remove(_pending);
        if (result.Success)
        {
            _pending = null;
            _attachmentError = null;
        }
        else
        {
            // Keep the chip, show the error
            _attachmentError = result.Error ?? "Failed to remove attachment.";
        }
        StateHasChanged();
        await SyncPasteAllowedAsync();
    }

    private async Task ResetSession()
    {
        if (IsBoundStreaming) return;

        // FRESH SELECTION: the reset mutates the session, so it re-queries the accessor first and drives
        // the ONE deferred connect when the runtime is not connected yet.
        Composer? composer;
        try
        {
            composer = await AcquireComposerForMutationAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            _sendError = ComposerRuntimeFacade.RuntimeUnavailableError;
            Console.Error.WriteLine($"[ComposerChat] Composer runtime selection failed: {ex.Message}");
            StateHasChanged();
            return;
        }

        if (composer is null)
        {
            _sendError = _circuitError ?? ComposerRuntimeAccessError;
            StateHasChanged();
            return;
        }

        await composer.ResetSessionAsync();
        _messages.Clear();
        _pending = null;        // Composer's reset calls ClearAllAsync which may delete the file
        _attachmentError = null; // clear any pending-related error note
        StateHasChanged();
        await SyncPasteAllowedAsync();
    }

    private async Task CompactSession()
    {
        if (IsBoundStreaming || (HasBoundComposer && Composer.IsCompacting)) return;
        try
        {
            // The facade re-selects the runtime for THIS operation itself (fresh identity + capability,
            // one deferred connect on a mutation), then maps every manager outcome to the recovery answer.
            var result = await ComposerFacade.CompactAsync(
                await ActingUserAsync(), CancellationToken.None);

            // ADOPT WHAT THE FACADE JUST DECIDED: a refusal hides the content and unsubscribes, a replacement
            // unifies the binding/reads/subscriptions with the runtime the facade acted on.
            await AdoptCurrentSelectionAsync();
            if (result.Success)
            {
                LoadHistory();
            }
            else
            {
                // The recovery answer (deferred 503 / failed 503 / removed 409 / refused 403) is surfaced next
                // to the controls; it never hides the thread, because the bound Composer is still usable.
                _sendError = result.Error;
            }
            // A failed compaction leaves the thread exactly as it was — the history is NOT
            // reloaded — but the view is still refreshed so the compacting indicator clears.
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Compact failed: {ex.Message}");
        }
    }

    private async Task CompactPartial()
    {
        if (IsBoundStreaming || (HasBoundComposer && Composer.IsCompacting)) return;
        try
        {
            var result = await ComposerFacade.CompactPartialAsync(
                await ActingUserAsync(), 50, CancellationToken.None);
            await AdoptCurrentSelectionAsync();
            if (result.Success)
            {
                LoadHistory();
            }
            else
            {
                _sendError = result.Error;
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Partial compact failed: {ex.Message}");
        }
    }

    /// <summary>
    /// The button label for the active-notifications toggle: passive → "🔕 Passive",
    /// active → "🔔 Active", off → "🔕 Off". A mode that has not loaded yet (<c>null</c>)
    /// shows a neutral placeholder rather than a fabricated default, so the UI never claims
    /// a mode the server never reported.
    /// </summary>
    /// <param name="mode">The authoritative loaded mode, or <c>null</c> when not yet loaded.</param>
    internal static string ActiveNotificationsLabel(string? mode) => mode switch
    {
        "passive" => "🔕 Passive",
        "active" => "🔔 Active",
        "off" => "🔕 Off",
        _ => "🔕 …",
    };

    private string ActiveNotificationsButtonText => ActiveNotificationsLabel(_activeNotifMode);

    /// <summary>
    /// The next mode in the cycle passive → active → off → passive.
    /// </summary>
    /// <param name="current">The authoritative current mode.</param>
    internal static string NextActiveNotificationsMode(string current) => current switch
    {
        "passive" => "active",
        "active" => "off",
        "off" => "passive",
        _ => throw new InvalidOperationException($"Unhandled event notification mode '{current}'."),
    };

    /// <summary>
    /// Normalizes a mode reported by <see cref="IConfigFacade.GetComposerAsync"/>. The projection
    /// already returns the effective (normalized) mode, so anything outside the three known
    /// values is treated as "not loaded" (<c>null</c>) rather than being coerced into a default
    /// that would let the toggle persist a transition derived from a value never reported.
    /// </summary>
    /// <param name="mode">The raw mode from the projection.</param>
    internal static string? NormalizeLoadedNotificationsMode(string? mode) => mode switch
    {
        "passive" or "active" or "off" => mode,
        _ => null,
    };

    /// <summary>
    /// Whether the toggle may run right now. It requires an authoritative loaded mode
    /// (<paramref name="mode"/> non-null), an idle Composer, and no toggle already in flight —
    /// the last of which stops two rapid clicks from both deriving their next mode from the
    /// same stale value and persisting the same transition twice.
    /// </summary>
    /// <param name="mode">The authoritative loaded mode, or <c>null</c> when not yet loaded.</param>
    /// <param name="isStreaming">Whether the Composer is streaming.</param>
    /// <param name="togglePending">Whether a toggle request is already in flight.</param>
    internal static bool CanToggleActiveNotifications(string? mode, bool isStreaming, bool togglePending)
        => mode is not null && !isStreaming && !togglePending;

    /// <summary>
    /// Narrow seam over the component state the notification toggle touches, so the PRODUCTION
    /// toggle body (<see cref="ToggleActiveNotificationsCoreAsync"/>) can be exercised by tests
    /// without a live Blazor circuit. The component itself is the only production implementation.
    /// </summary>
    internal interface INotificationToggleHost
    {
        /// <summary>The authoritative mode, or <c>null</c> until the config GET has loaded it.</summary>
        string? Mode { get; set; }

        /// <summary>Whether a toggle save is currently in flight.</summary>
        bool TogglePending { get; set; }

        /// <summary>Whether a mode change has been persisted and needs a restart to take effect.</summary>
        bool RestartRequired { get; set; }

        /// <summary>Error surfaced next to the toggle button, if any.</summary>
        string? ToggleError { get; set; }

        /// <summary>Whether the Composer is currently streaming a response.</summary>
        bool IsStreaming { get; }

        /// <summary>Persists the mode change through <see cref="IConfigFacade.SaveComposerAsync"/>.</summary>
        /// <param name="mode">The mode to persist.</param>
        Task<FacadeResult<SavedResult>> SaveModeAsync(string mode);

        /// <summary>Requests a re-render (the component's <c>StateHasChanged</c>).</summary>
        void Notify();
    }

    /// <summary>Binds <see cref="INotificationToggleHost"/> to this component's own fields and services.</summary>
    private sealed class ComponentNotificationToggleHost(ComposerChat owner) : INotificationToggleHost
    {
        /// <inheritdoc />
        public string? Mode
        {
            get => owner._activeNotifMode;
            set => owner._activeNotifMode = value;
        }

        /// <inheritdoc />
        public bool TogglePending
        {
            get => owner._notifTogglePending;
            set => owner._notifTogglePending = value;
        }

        /// <inheritdoc />
        public bool RestartRequired
        {
            get => owner._restartRequiredForNotifications;
            set => owner._restartRequiredForNotifications = value;
        }

        /// <inheritdoc />
        public string? ToggleError
        {
            get => owner._notifToggleError;
            set => owner._notifToggleError = value;
        }

        /// <inheritdoc />
        public bool IsStreaming => owner.IsBoundStreaming;

        /// <inheritdoc />
        public async Task<FacadeResult<SavedResult>> SaveModeAsync(string mode)
            => await owner.ConfigFacade.SaveComposerAsync(
                new ComposerSettingsUpdate(EventNotificationsMode: mode),
                await owner.ActingUserAsync(),
                CancellationToken.None);

        /// <inheritdoc />
        public void Notify() => owner.StateHasChanged();
    }

    private INotificationToggleHost? _notificationToggleHost;

    private INotificationToggleHost NotificationToggleHost =>
        _notificationToggleHost ??= new ComponentNotificationToggleHost(this);

    /// <summary>
    /// Loads the effective event-notification mode through <see cref="IConfigFacade.GetComposerAsync"/>.
    /// This runs regardless of whether the Composer agent is connected — the config projection is
    /// independent of that connection. A failed load leaves the mode <c>null</c> (not loaded),
    /// which keeps the toggle disabled instead of letting it persist a transition computed from a
    /// fabricated <c>passive</c> default that could overwrite a stored <c>active</c>/<c>off</c>.
    /// </summary>
    private async Task LoadActiveNotificationsModeAsync()
    {
        try
        {
            var result = await ConfigFacade.GetComposerAsync(
                await ActingUserAsync(), CancellationToken.None);
            if (!result.Success)
            {
                // Left unloaded on purpose: the toggle stays disabled rather than guessing.
                _activeNotifMode = null;
                _notifToggleError = $"Failed to load notification mode: {result.Error}";
                return;
            }

            _activeNotifMode = NormalizeLoadedNotificationsMode(result.Value?.EventNotifications?.Mode);
            if (_activeNotifMode is null)
                _notifToggleError = "Could not determine the current notification mode.";
        }
        catch (Exception ex)
        {
            // Left unloaded on purpose: the toggle stays disabled rather than guessing.
            _activeNotifMode = null;
            _notifToggleError = $"Failed to load notification mode: {ex.Message}";
        }
    }

    /// <summary>
    /// The PRODUCTION toggle body, written against <see cref="INotificationToggleHost"/> so tests
    /// exercise this exact code rather than a re-implementation.
    /// </summary>
    /// <remarks>
    /// The next mode is derived from the authoritative loaded mode, and the in-flight claim is
    /// taken BEFORE the first await so a second click cannot compute its transition from the same
    /// pre-save value. The <c>finally</c> always releases the claim, so a failed toggle never
    /// leaves the button permanently disabled.
    /// </remarks>
    /// <param name="host">State seam the outcome is written to.</param>
    internal static async Task ToggleActiveNotificationsCoreAsync(INotificationToggleHost host)
    {
        ArgumentNullException.ThrowIfNull(host);

        // Not loaded / streaming / already toggling: drop the click entirely.
        if (!CanToggleActiveNotifications(host.Mode, host.IsStreaming, host.TogglePending))
            return;

        // Authoritative: the transition is computed from the loaded mode, never a default.
        var nextMode = NextActiveNotificationsMode(host.Mode!);

        // Claimed BEFORE the first await so an overlapping click is refused by the guard above.
        host.TogglePending = true;
        host.ToggleError = null;
        host.Notify();

        try
        {
            var result = await host.SaveModeAsync(nextMode);
            if (result.Success)
            {
                host.Mode = nextMode;
                host.RestartRequired = true;
            }
            else
            {
                host.ToggleError = $"Notification mode toggle failed: {result.Error}";
            }
        }
        catch (Exception ex)
        {
            host.ToggleError = $"Notification mode toggle failed: {ex.Message}";
        }
        finally
        {
            // Released on every path so a failure can be retried.
            host.TogglePending = false;
            host.Notify();
        }
    }

    /// <summary>Runs the shared toggle body against this component's own state.</summary>
    private Task ToggleActiveNotifications() => ToggleActiveNotificationsCoreAsync(NotificationToggleHost);

    private async Task LoadAvailableModelsAsync()
    {
        try
        {
            var result = await ComposerFacade.GetModelsAsync(
                await ActingUserAsync(),
                CancellationToken.None);
            if (!result.Success)
            {
                Console.Error.WriteLine($"[ComposerChat] Failed to load available models: {result.Error}");
                return;
            }

            if (result.Value?.Models is { Count: > 0 } models)
            {
                _availableModels = models.ToList();
            }
            // A Composer with no configured reasoning effort presents as "None" in the dropdown,
            // so the value shown always matches what a subsequent switch would send.
            _selectedReasoning = InitialReasoning(result.Value?.ReasoningEffort);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Failed to load available models: {ex.Message}");
        }
    }

    /// <summary>
    /// Fetches the Composer's actual current model and sets it as the initial
    /// dropdown selection, ensuring correctness after a runtime model switch.
    /// The production body lives in <see cref="LoadCurrentModelCoreAsync"/> so the
    /// thrown-exception handling is exercised by tests through the same code path.
    /// </summary>
    private Task LoadCurrentModelAsync()
    {
        return LoadCurrentModelCoreAsync(CurrentModelHost);
    }

    /// <summary>
    /// Narrow seam over the component state the current-model load touches, so the PRODUCTION
    /// body (<see cref="LoadCurrentModelCoreAsync"/>) can be exercised by tests without a live
    /// Blazor circuit — including the thrown-exception path, which a source-level test cannot
    /// execute. The component itself is the only production implementation.
    /// </summary>
    internal interface ICurrentModelHost
    {
        /// <summary>The models loaded from the catalog picker.</summary>
        IReadOnlyList<string> AvailableModels { get; }

        /// <summary>The current dropdown selection; cleared on every no-valid-model path.</summary>
        string SelectedModel { get; set; }

        /// <summary>Logs a current-model failure (console).</summary>
        /// <param name="error">The error text from the result or the thrown exception.</param>
        void LogCurrentModelFailure(string error);

        /// <summary>Reads the current model through the facade.</summary>
        Task<FacadeResult<CurrentModelDto>> GetCurrentModelAsync();
    }

    /// <summary>Binds <see cref="ICurrentModelHost"/> to this component's own fields and services.</summary>
    private sealed class ComponentCurrentModelHost(ComposerChat owner) : ICurrentModelHost
    {
        /// <inheritdoc />
        public IReadOnlyList<string> AvailableModels => owner._availableModels;

        /// <inheritdoc />
        public string SelectedModel
        {
            get => owner._selectedModel;
            set => owner._selectedModel = value;
        }

        /// <inheritdoc />
        public void LogCurrentModelFailure(string error)
            => Console.Error.WriteLine($"[ComposerChat] Failed to load current model: {error}");

        /// <inheritdoc />
        public async Task<FacadeResult<CurrentModelDto>> GetCurrentModelAsync()
            => await owner.ComposerFacade.GetCurrentModelAsync(
                await owner.ActingUserAsync(), CancellationToken.None);
    }

    private ICurrentModelHost? _currentModelHost;

    private ICurrentModelHost CurrentModelHost => _currentModelHost ??= new ComponentCurrentModelHost(this);

    /// <summary>
    /// The PRODUCTION current-model body, written against <see cref="ICurrentModelHost"/> so
    /// tests exercise this exact code rather than a re-implementation.
    /// </summary>
    /// <remarks>
    /// The try/catch is scoped to the facade READ ONLY: the facade rethrows read failures by
    /// design, and this catch converts them into the same log-and-clear the unsuccessful-result
    /// path uses. Nothing outside this method's own read is caught, so surrounding
    /// switch/notification logic keeps its own handling.
    /// </remarks>
    /// <param name="host">State seam the outcome is written to.</param>
    internal static async Task LoadCurrentModelCoreAsync(ICurrentModelHost host)
    {
        ArgumentNullException.ThrowIfNull(host);

        FacadeResult<CurrentModelDto> result;
        try
        {
            // Scoped to the read call only — a fault here must never escape into the
            // component's init flow or the first-connect switch handler.
            result = await host.GetCurrentModelAsync();
        }
        catch (Exception ex)
        {
            // The facade rethrows read failures; restore the pre-migration behavior of
            // logging + clearing instead of faulting the circuit.
            host.LogCurrentModelFailure(ex.Message);
            host.SelectedModel = "";
            return;
        }

        if (!result.Success)
        {
            // Real failure: surface it (this replaces the previous exception path) and keep the
            // placeholder/no-selection state.
            host.LogCurrentModelFailure(result.Error ?? "Unknown error.");
            host.SelectedModel = "";
            return;
        }

        var model = result.Value?.Model;
        if (!string.IsNullOrWhiteSpace(model) && host.AvailableModels.Contains(model))
        {
            host.SelectedModel = model;
        }
        else
        {
            // No valid current model (unconfigured shell, or a model absent from the catalog):
            // keep the placeholder/no-selection state WITHOUT logging a failure — this is the
            // normal contract, not an error. Never auto-select the first catalog entry: a real
            // selection must fire a change event so the switch is actually invoked.
            host.SelectedModel = "";
        }
    }

    /// <summary>
    /// The reasoning effort value handed to <see cref="IComposerFacade.SwitchModelAsync"/>. The
    /// facade parses the CANONICAL wire form (<c>extra_high</c>, never <c>ExtraHigh</c>), so the
    /// conversion happens here rather than at each call site.
    /// </summary>
    /// <param name="reasoning">Reasoning effort to switch to.</param>
    internal static string SwitchReasoningWireValue(ReasoningEffort reasoning)
        => ReasoningEffortConverter.Format(reasoning)!;

    /// <summary>
    /// The reasoning level the dropdown starts on. A Composer with no configured effort reports
    /// <c>null</c>, which presents as <see cref="ReasoningEffort.None"/> so the displayed value
    /// always matches what a subsequent switch would send.
    /// </summary>
    /// <param name="fromResponse">The <c>reasoningEffort</c> field of the models response.</param>
    internal static ReasoningEffort InitialReasoning(ReasoningEffort? fromResponse)
        => fromResponse ?? ReasoningEffort.None;

    /// <summary>
    /// The reasoning level the dropdown must show after a switch attempt. A rejected switch left
    /// the server on the previous level, so the dropdown is restored rather than left showing a
    /// level that was never applied.
    /// </summary>
    /// <param name="previous">The level shown before the attempt.</param>
    /// <param name="attempted">The level the user selected.</param>
    /// <param name="succeeded">Whether the switch request succeeded.</param>
    internal static ReasoningEffort ResolveReasoningAfterSwitch(
        ReasoningEffort previous, ReasoningEffort attempted, bool succeeded)
        => succeeded ? attempted : previous;

    /// <summary>
    /// Narrow seam over the component state the model-selection flow touches, so the PRODUCTION
    /// handler body (<see cref="HandleModelChangeCoreAsync"/>) can be exercised by tests without
    /// a live Blazor circuit. The component itself is the only production implementation.
    /// </summary>
    internal interface IModelSwitchHost
    {
        /// <summary>Whether the Composer is connected BEFORE the switch attempt.</summary>
        bool IsConnected { get; }

        /// <summary>Switches the running Composer through <see cref="IComposerFacade.SwitchModelAsync"/>.</summary>
        /// <param name="model">Model identifier to switch to.</param>
        /// <param name="reasoning">Reasoning effort to switch to.</param>
        Task<FacadeResult<SwitchResultDto>> SwitchAsync(string model, ReasoningEffort reasoning);

        /// <summary>Reloads the message thread from the Composer session history.</summary>
        void LoadHistory();

        /// <summary>Refreshes the current model from the current-model endpoint.</summary>
        Task LoadCurrentModelAsync();

        /// <summary>Records the successfully applied model as the select's selection.</summary>
        void SetSelectedModel(string model);

        /// <summary>Requests a re-render (the component's <c>StateHasChanged</c>).</summary>
        void Notify();
    }

    /// <summary>Binds <see cref="IModelSwitchHost"/> to this component's own fields and services.</summary>
    private sealed class ComponentModelSwitchHost(ComposerChat owner) : IModelSwitchHost
    {
        /// <inheritdoc />
        public bool IsConnected => owner.HasBoundComposer && owner.Composer.IsConnected;

        /// <inheritdoc />
        public async Task<FacadeResult<SwitchResultDto>> SwitchAsync(string model, ReasoningEffort reasoning)
        {
            var result = await owner.ComposerFacade.SwitchModelAsync(
                await owner.ActingUserAsync(), model, SwitchReasoningWireValue(reasoning), CancellationToken.None);

            // ADOPT WHAT THE FACADE JUST DECIDED (refusal => hidden + unsubscribed; replacement => unified).
            await owner.AdoptCurrentSelectionAsync();
            return result;
        }

        /// <inheritdoc />
        public void LoadHistory() => owner.LoadHistory();

        /// <inheritdoc />
        public Task LoadCurrentModelAsync() => owner.LoadCurrentModelAsync();

        /// <inheritdoc />
        public void SetSelectedModel(string model) => owner._selectedModel = model;

        /// <inheritdoc />
        public void Notify() => owner.StateHasChanged();
    }

    private IModelSwitchHost? _modelSwitchHost;

    private IModelSwitchHost ModelSwitchHost => _modelSwitchHost ??= new ComponentModelSwitchHost(this);

    /// <summary>
    /// The PRODUCTION model-selection body, written against <see cref="IModelSwitchHost"/> so
    /// tests exercise this exact code rather than a re-implementation. A successful selection
    /// on a disconnected shell (first-connect) triggers history + current-model refresh so the
    /// restored thread shows immediately — no navigation.
    /// </summary>
    /// <param name="host">State seam the outcome is written to.</param>
    /// <param name="model">Model identifier to switch to.</param>
    /// <param name="reasoning">Reasoning effort to switch to.</param>
    internal static async Task HandleModelChangeCoreAsync(IModelSwitchHost host, string model, ReasoningEffort reasoning)
    {
        ArgumentNullException.ThrowIfNull(host);

        // Captured BEFORE the request: a successful first-selection connect (disconnected shell)
        // must refresh history + current model so the restored thread shows immediately.
        var wasDisconnected = !host.IsConnected;

        try
        {
            // The current reasoning selection travels with the new model — the facade requires
            // both and never infers reasoning from the model name.
            var result = await host.SwitchAsync(model, reasoning);
            if (result.Success)
            {
                host.SetSelectedModel(model);
                if (wasDisconnected)
                {
                    // First-connect: the switch connected the Composer (Slice 1A2b-1) and
                    // restored the session from disk. Load and display the restored history
                    // and refresh the current model so the thread shows immediately — no
                    // navigation required.
                    host.LoadHistory();
                    await host.LoadCurrentModelAsync();
                    // The view state flips to the connected layout (thread + controls) — the
                    // re-render also triggers the paste-module install (OnAfterRenderAsync).
                    host.Notify();
                }
            }
            else
            {
                Console.Error.WriteLine($"[ComposerChat] Model switch failed: {result.Error}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Model switch failed: {ex.Message}");
        }
    }

    /// <summary>Runs the shared model-selection body against this component's own state.</summary>
    private Task HandleModelChange(ChangeEventArgs e)
    {
        if (e.Value is not string model || string.IsNullOrWhiteSpace(model)) return Task.CompletedTask;
        if (!_availableModels.Contains(model)) return Task.CompletedTask;

        return HandleModelChangeCoreAsync(ModelSwitchHost, model, _selectedReasoning);
    }

    private async Task HandleReasoningChange(ChangeEventArgs e)
    {
        if (e.Value is not string raw || string.IsNullOrWhiteSpace(raw)) return;

        ReasoningEffort newReasoning;
        try
        {
            newReasoning = ReasoningEffortConverter.Parse(raw)!.Value;
        }
        catch (ArgumentException)
        {
            return;
        }

        // Captured BEFORE the request so a rejected switch can restore exactly what was shown.
        var previous = _selectedReasoning;
        _selectedReasoning = newReasoning;

        try
        {
            var result = await ComposerFacade.SwitchModelAsync(
                await ActingUserAsync(),
                _selectedModel,
                SwitchReasoningWireValue(newReasoning),
                CancellationToken.None);
            await AdoptCurrentSelectionAsync();
            _selectedReasoning = ResolveReasoningAfterSwitch(previous, newReasoning, result.Success);

            if (!result.Success)
            {
                Console.Error.WriteLine($"[ComposerChat] Reasoning switch failed: {result.Error}");
            }
        }
        catch (Exception ex)
        {
            _selectedReasoning = ResolveReasoningAfterSwitch(previous, newReasoning, succeeded: false);
            Console.Error.WriteLine($"[ComposerChat] Reasoning switch failed: {ex.Message}");
        }

        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private static string FormatContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return Markdown.ToHtml(content, MarkdownPipeline);
    }

    private static string FormatStreamingContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return Markdown.ToHtml(content, MarkdownPipeline);
    }

    public async ValueTask DisposeAsync()
    {
        // Disposal releases ONLY this component's own event subscriptions and JS interop handles. It never
        // disposes the Composer it was subscribed to: the singleton ComposerRuntimeManager is the sole
        // owner and disposer of every runtime (and of the legacy singleton), so a circuit teardown can never
        // tear down a runtime another request — or the host — still uses.
        UnsubscribeFromBoundComposer();

        await ReleasePasteListenerAsync();
    }

    /// <summary>
    /// A sub-agent status change on the bound Composer. Queued like every other subscription callback, with the
    /// same captured-binding freshness guard: a status from a replaced runtime never re-renders this circuit.
    /// </summary>
    private void HandleSubAgentChanged(SubAgentInfo info)
    {
        var captured = CurrentCallbackBinding;
        QueueCallback(async () =>
        {
            if (await DropStaleCallbackAsync(captured, CancellationToken.None))
                return;

            StateHasChanged();
            await Task.CompletedTask;
        });
    }

    private void ToggleSubAgents()
    {
        _subAgentsExpanded = !_subAgentsExpanded;
    }

    private static string StatusBadge(SubAgentStatus status) => status switch
    {
        SubAgentStatus.Running => "⏳ Running",
        SubAgentStatus.Completed => "✅ Completed",
        SubAgentStatus.Failed => "❌ Failed",
        SubAgentStatus.TimedOut => "⏱️ Timed out",
        SubAgentStatus.Cancelled => "🚫 Cancelled",
        _ => throw new InvalidOperationException($"Unhandled sub-agent status '{status}'.")
    };

    /// <summary>
    /// Formats the elapsed time. Running entries measure from <c>StartedAt</c> to now (refreshed
    /// only when a status event arrives — there is no per-second timer); terminal entries measure
    /// to <c>CompletedAt</c> when available.
    /// </summary>
    private static string Elapsed(SubAgentInfo info)
    {
        var end = info.Status == SubAgentStatus.Running
            ? DateTimeOffset.UtcNow
            : info.CompletedAt;

        if (end is null) return "";

        var span = end.Value - info.StartedAt;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;

        var totalMinutes = (int)span.TotalMinutes;
        return totalMinutes > 0
            ? $"{totalMinutes}m {span.Seconds}s"
            : $"{(int)span.TotalSeconds}s";
    }

    /// <summary>
    /// A compaction started on the bound Composer. Queued with the captured-binding freshness guard, so a
    /// compaction notification from a replaced runtime can never re-render this circuit.
    /// </summary>
    private void HandleCompactingStarted()
    {
        var captured = CurrentCallbackBinding;
        QueueCallback(async () =>
        {
            if (await DropStaleCallbackAsync(captured, CancellationToken.None))
                return;

            StateHasChanged();
            await SyncPasteAllowedAsync();
        });
    }

    /// <summary>
    /// A compaction finished on the bound Composer. Queued with the captured-binding freshness guard.
    /// </summary>
    private void HandleCompacted()
    {
        var captured = CurrentCallbackBinding;
        QueueCallback(async () =>
        {
            if (await DropStaleCallbackAsync(captured, CancellationToken.None))
                return;

            StateHasChanged();
            await SyncPasteAllowedAsync();
        });
    }

    /// <summary>
    /// A question was asked on the bound Composer. Queued with the captured-binding freshness guard: the question
    /// widget belongs to the runtime that asked it, so a stale callback never renders it.
    /// </summary>
    private void HandleQuestionAsked()
    {
        var captured = CurrentCallbackBinding;
        QueueCallback(async () =>
        {
            if (await DropStaleCallbackAsync(captured, CancellationToken.None))
                return;

            StateHasChanged();
            await Task.CompletedTask;
        });
    }

    /// <summary>
    /// Raised when an active system notification was injected: reload history so the
    /// notification message appears in the chat, then re-render.
    /// <para>
    /// This callback RESTORES CONTENT, so it applies the FULL freshness guard: the captured binding must still be
    /// the circuit's binding AND a fresh authorization re-check must still pass before any history is read.
    /// </para>
    /// </summary>
    private void HandleActiveInjection(string _)
    {
        var captured = CurrentCallbackBinding;
        QueueCallback(async () =>
        {
            if (await DropStaleCallbackAsync(captured, CancellationToken.None))
                return;

            LoadHistory();
            StateHasChanged();
            await SyncPasteAllowedAsync();
        });
    }

    private void SelectSingle(string option)
    {
        _selectedOptions = [option];
    }

    private void ToggleOption(string option)
    {
        if (_selectedOptions.Contains(option))
            _selectedOptions.Remove(option);
        else
            _selectedOptions.Add(option);
    }

    private async Task SubmitYesNo(bool yes, ComposerQuestion question)
    {
        var answer = yes ? "Yes" : "No";
        if (!string.IsNullOrWhiteSpace(_questionFeedback))
            answer += $" — {_questionFeedback.Trim()}";

        _selectedOptions = [];
        _questionFeedback = "";

        // ANSWERING A QUESTION IS A COMMAND: it re-selects the CURRENT runtime first, so an answer can
        // never be delivered to a runtime this account no longer holds (or to one that was replaced).
        var composer = await AcquireComposerForMutationAsync(CancellationToken.None);
        composer?.SubmitAnswer(answer);
        StateHasChanged();
    }

    private async Task SubmitChoice(ComposerQuestion question)
    {
        var selected = string.Join(", ", _selectedOptions);
        var answer = string.IsNullOrWhiteSpace(_questionFeedback)
            ? selected
            : $"{selected} — {_questionFeedback.Trim()}";

        _selectedOptions = [];
        _questionFeedback = "";

        var composer = await AcquireComposerForMutationAsync(CancellationToken.None);
        composer?.SubmitAnswer(answer);
        StateHasChanged();
    }

    private async Task CancelQuestion(ComposerQuestion question)
    {
        _selectedOptions = [];
        _questionFeedback = "";

        var composer = await AcquireComposerForMutationAsync(CancellationToken.None);
        composer?.CancelQuestion();
        StateHasChanged();
    }

