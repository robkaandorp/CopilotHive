@page "/composer"
@using CopilotHive.Dashboard
@using CopilotHive.Orchestration
@using CopilotHive.Services
@using Markdig
@using Microsoft.AspNetCore.Components.Forms
@using SharpCoder.SubAgents
@using System.IO
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.Extensions.AI
@implements IAsyncDisposable
@inject Composer Composer
@inject ComposerAttachmentService AttachmentService
@inject IJSRuntime JS
@inject PageHeaderState PageHeader
@inject HttpClient HttpClient

@if (!Composer.IsConnected)
{
    <div class="chat-status chat-status-error">
        Composer is not connected. Check orchestrator logs.
    </div>
}
else
{
    <div class="composer-layout">
        <div class="chat-container">
            @{
                var subAgents = Composer.GetSubAgents();
            }
            @if (subAgents.Count > 0)
            {
                <div style="border: 1px solid var(--border-color, #333); border-radius: 6px; margin-bottom: 0.5rem; overflow: hidden;">
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.4rem 0.6rem; font-size: 0.85rem; font-weight: 600;">
                        <span>⚙️ Background tasks (@subAgents.Count)</span>
                        <button class="chat-action-btn" style="padding: 0.1rem 0.5rem; font-size: 0.8rem;"
                                @onclick="ToggleSubAgents">
                            @(_subAgentsExpanded ? "▾" : "▸")
                        </button>
                    </div>
                    @if (_subAgentsExpanded)
                    {
                        <div style="padding: 0 0.6rem 0.4rem 0.6rem; max-height: 60vh; overflow-y: auto;">
                            @foreach (var sa in subAgents)
                            {
                                <div style="padding: 0.3rem 0; border-top: 1px solid var(--border-color, #333);">
                                    <div style="display: flex; align-items: center; gap: 0.6rem; font-size: 0.8rem;">
                                        <span style="flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;">@(string.IsNullOrWhiteSpace(sa.Task) ? "" : sa.Task.ReplaceLineEndings(" ").Trim())</span>
                                        <span class="text-muted" style="flex: 0 0 auto;">@(string.IsNullOrWhiteSpace(sa.Model) ? "—" : sa.Model)</span>
                                        <span style="flex: 0 0 auto;">@StatusBadge(sa.Status)</span>
                                        <span class="text-muted" style="flex: 0 0 auto;">@Elapsed(sa)</span>
                                    </div>
                                    @if (sa.Status == SubAgentStatus.Completed && !string.IsNullOrWhiteSpace(sa.Summary))
                                    {
                                        <div style="font-size: 0.75rem; margin-top: 0.2rem; max-height: 220px; overflow-y: auto;">@((MarkupString)FormatContent(sa.Summary))</div>
                                    }
                                    else if ((sa.Status == SubAgentStatus.Failed || sa.Status == SubAgentStatus.TimedOut)
                                             && !string.IsNullOrWhiteSpace(sa.Error))
                                    {
                                        <div style="font-size: 0.75rem; margin-top: 0.2rem; color: var(--danger-color, #e05561); max-height: 220px; overflow-y: auto;">@sa.Error</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            <div class="chat-messages" id="chat-messages">
                @if (_messages.Count == 0 && !Composer.IsStreaming)
                {
                    <div class="chat-empty">
                        <p><strong>Welcome to the Composer.</strong></p>
                        <p>Describe what you'd like to build or improve, and I'll help break it into goals.</p>
                        <p class="text-muted">Try: <em>"I want to add user authentication to the API"</em></p>
                    </div>
                }

                @foreach (var msg in _messages)
                {
                    <div class="chat-msg chat-msg-@msg.Role">
                        <div class="chat-msg-role">@(msg.Role == "user" ? "You" : "Composer")</div>
                        <div class="chat-msg-content">@((MarkupString)FormatContent(msg.Content))</div>
                    </div>
                }

                @if (Composer.IsStreaming)
                {
                    <div class="chat-msg chat-msg-assistant">
                        <div class="chat-msg-role">Composer</div>
                        <div class="chat-msg-content">
                            @((MarkupString)FormatStreamingContent(Composer.StreamingContent))
                            <span class="chat-cursor">▊</span>
                        </div>
                    </div>
                }

                @if (Composer.PendingQuestion is { } pq)
                {
                    <div class="chat-msg chat-msg-assistant chat-question-widget">
                        <div class="chat-msg-role">Composer — Question</div>
                        <div class="chat-msg-content">
                            <div class="chat-question-text">@((MarkupString)FormatContent(pq.Text))</div>

                            @if (pq.Type == QuestionType.YesNo)
                            {
                                <div class="chat-question-actions">
                                    <button class="chat-send chat-question-yes"
                                            @onclick="() => SubmitYesNo(true, pq)">Yes</button>
                                    <button class="chat-action-btn chat-question-no"
                                            @onclick="() => SubmitYesNo(false, pq)">No</button>
                                    <button class="chat-action-btn"
                                            @onclick="() => CancelQuestion(pq)">Cancel</button>
                                </div>
                                <textarea class="chat-input chat-question-feedback"
                                          @bind="_questionFeedback"
                                          placeholder="Optional additional feedback…"
                                          rows="2"></textarea>
                            }
                            else if (pq.Type == QuestionType.SingleChoice)
                            {
                                <div class="chat-question-options">
                                    @foreach (var opt in pq.Options)
                                    {
                                        <label class="chat-question-option">
                                            <input type="radio"
                                                   name="single-choice"
                                                   checked="@(_selectedOptions.Contains(opt))"
                                                   @onchange="() => SelectSingle(opt)" />
                                            @opt
                                        </label>
                                    }
                                </div>
                                <textarea class="chat-input chat-question-feedback"
                                          @bind="_questionFeedback"
                                          placeholder="Optional additional feedback…"
                                          rows="2"></textarea>
                                <div class="chat-question-actions">
                                    <button class="chat-send"
                                            disabled="@(_selectedOptions.Count == 0)"
                                            @onclick="() => SubmitChoice(pq)">Submit</button>
                                    <button class="chat-action-btn"
                                            @onclick="() => CancelQuestion(pq)">Cancel</button>
                                </div>
                            }
                            else if (pq.Type == QuestionType.MultiChoice)
                            {
                                <div class="chat-question-options">
                                    @foreach (var opt in pq.Options)
                                    {
                                        <label class="chat-question-option">
                                            <input type="checkbox"
                                                   checked="@(_selectedOptions.Contains(opt))"
                                                   @onchange="() => ToggleOption(opt)" />
                                            @opt
                                        </label>
                                    }
                                </div>
                                <textarea class="chat-input chat-question-feedback"
                                          @bind="_questionFeedback"
                                          placeholder="Optional additional feedback…"
                                          rows="2"></textarea>
                                <div class="chat-question-actions">
                                    <button class="chat-send"
                                            disabled="@(_selectedOptions.Count == 0)"
                                            @onclick="() => SubmitChoice(pq)">Submit</button>
                                    <button class="chat-action-btn"
                                            @onclick="() => CancelQuestion(pq)">Cancel</button>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div id="chat-anchor"></div>
            </div>

            <div class="chat-input-area">
                @if (_pending is not null)
                {
                    <div class="chat-attach-chip">
                        <span class="chat-attach-chip-name">@_pending.DisplayName</span>
                        <button class="chat-attach-chip-remove" @onclick="RemoveAttachment" disabled="@Composer.IsStreaming" title="Remove attachment">×</button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_attachmentError))
                {
                    <div class="chat-attach-error">@_attachmentError</div>
                }
                <label class="chat-attach-btn">
                    📎
                    <InputFile OnChange="HandleFileSelected"
                               accept=".png,.jpg,.jpeg,.gif,.webp,.pdf,image/*,application/pdf"
                               disabled="@(_pending is not null || _uploading || Composer.IsStreaming)"
                               class="chat-attach-input" />
                </label>
                <textarea id="composer-input"
                          @bind="_inputText" @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          placeholder="Describe what you want to build…"
                          disabled="@Composer.IsStreaming"
                          rows="2"
                          class="chat-input"></textarea>
                <button @onclick="SendMessage" disabled="@(!CanSend)"
                        class="chat-send">
                    @if (Composer.IsStreaming)
                    {
                        <span>Thinking…</span>
                    }
                    else
                    {
                        <span>Send</span>
                    }
                </button>
            </div>

            <div class="chat-actions">
                <select disabled="@Composer.IsStreaming" class="chat-model-select" @onchange="HandleModelChange">
                    @foreach (var model in _availableModels)
                    {
                        <option value="@model" selected="@(_selectedModel == model)">@model</option>
                    }
                </select>
                <select disabled="@Composer.IsStreaming" class="chat-model-select" @onchange="HandleReasoningChange">
                    @foreach (var effort in ReasoningOptions)
                    {
                        <option value="@ReasoningEffortConverter.Format(effort)" selected="@(_selectedReasoning == effort)">@ReasoningLabel(effort)</option>
                    }
                </select>
                <button @onclick="ResetSession" disabled="@Composer.IsStreaming" class="chat-action-btn">
                    🔄 New Session
                </button>
                <button @onclick="CompactSession" disabled="@(Composer.IsStreaming || Composer.IsCompacting)" class="chat-action-btn">
                    @if (Composer.IsCompacting)
                    {
                        <span>Compacting…</span>
                    }
                    else
                    {
                        <text>📦 Compact</text>
                    }
                </button>
                <button @onclick="CompactPartial" disabled="@(Composer.IsStreaming || Composer.IsCompacting)" class="chat-action-btn">
                    @if (Composer.IsCompacting)
                    {
                        <span>Compacting…</span>
                    }
                    else
                    {
                        <text>📦 Compact 50%</text>
                    }
                </button>
                <span class="text-muted chat-hint">
                    @(_messages.Count) msgs
                    @if (Composer.LastToolCalls > 0)
                    {
                        <text> · @Composer.LastToolCalls tools</text>
                    }
                    @{
                        var stats = Composer.GetStats();
                        var ctxClass = stats is not null
                            ? (stats.ContextUsagePercent >= 90 ? "chat-ctx-danger" : stats.ContextUsagePercent >= 70 ? "chat-ctx-warn" : "chat-ctx-ok")
                            : "";
                    }
                    @if (stats is not null)
                    {
                        <text> · ctx <span class="@ctxClass">@stats.ContextUsagePercent%</span></text>
                    }
                    @if (Composer.IsCompacting)
                    {
                        <span class="chat-ctx-compacting"> · Compacting…</span>
                    }
                    else if (Composer.WasCompacted)
                    {
                        <span class="chat-ctx-compacted"> · Compacted</span>
                    }
                </span>
            </div>
        </div>
    </div>
}

@code {
    private sealed class ChatMessage
    {
        public required string Role { get; init; }
        public string Content { get; set; } = "";
    }

    private readonly List<ChatMessage> _messages = [];
    private string _inputText = "";
    private HashSet<string> _selectedOptions = [];
    private string _questionFeedback = "";
    private List<string> _availableModels = [];
    private string _selectedModel = "";
    private ReasoningEffort _selectedReasoning = ReasoningEffort.None;
    private bool _subAgentsExpanded = false;
    private ComposerAttachment? _pending;
    private bool _uploading;
    private string? _attachmentError;
    private IJSObjectReference? _pasteModule;
    private DotNetObjectReference<ComposerChat>? _pasteDotNetRef;

    /// <summary>
    /// The reasoning levels offered by the dropdown, in ascending order.
    /// </summary>
    internal static readonly ReasoningEffort[] ReasoningOptions =
    [
        ReasoningEffort.None,
        ReasoningEffort.Low,
        ReasoningEffort.Medium,
        ReasoningEffort.High,
        ReasoningEffort.ExtraHigh,
    ];

    /// <summary>
    /// Human-readable dropdown label for a reasoning level. The wire value stays the canonical
    /// snake_case form produced by <see cref="ReasoningEffortConverter.Format(ReasoningEffort?)"/>.
    /// </summary>
    internal static string ReasoningLabel(ReasoningEffort effort) => effort switch
    {
        ReasoningEffort.None => "None",
        ReasoningEffort.Low => "Low",
        ReasoningEffort.Medium => "Medium",
        ReasoningEffort.High => "High",
        ReasoningEffort.ExtraHigh => "Extra High",
        _ => throw new InvalidOperationException($"Unhandled reasoning effort '{effort}'.")
    };

    /// <summary>
    /// JSON options for the API calls this page makes. They MUST match the server's global
    /// converter (<c>ConfigureHttpJsonOptions</c> in <c>Program.cs</c>) so snake_case enum
    /// values such as <c>extra_high</c> deserialize back into <see cref="ReasoningEffort"/>.
    /// </summary>
    internal static readonly JsonSerializerOptions ApiJsonOptions = CreateApiJsonOptions();

    private static JsonSerializerOptions CreateApiJsonOptions()
    {
        var options = new JsonSerializerOptions(JsonSerializerDefaults.Web);
        options.Converters.Add(
            new JsonStringEnumConverter(JsonNamingPolicy.SnakeCaseLower, allowIntegerValues: false));
        return options;
    }

    protected override async Task OnInitializedAsync()
    {
        PageHeader.SetTitle("💬 Composer");
        if (Composer.IsConnected)
        {
            LoadHistory();
            await LoadAvailableModelsAsync();
            await LoadCurrentModelAsync();
            StateHasChanged();
        }
        Composer.OnStreamingUpdate += HandleStreamingUpdate;
        Composer.OnQuestionAsked += HandleQuestionAsked;
        Composer.OnCompactingStarted += HandleCompactingStarted;
        Composer.OnCompacted += HandleCompacted;
        Composer.OnSubAgentChanged += HandleSubAgentChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("eval",
            "document.getElementById('chat-anchor')?.scrollIntoView()");

        if (firstRender)
        {
            _pasteModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/composer-paste.js");
            _pasteDotNetRef = DotNetObjectReference.Create(this);
            await _pasteModule.InvokeVoidAsync("install", "composer-input", _pasteDotNetRef);
            await SyncPasteAllowedAsync();
        }
    }

    /// <summary>
    /// Mirrors the authoritative .NET paste-allowed state into the JS module so a paste that can
    /// never be accepted is not intercepted in the first place. The .NET side still re-validates.
    /// </summary>
    private async Task SyncPasteAllowedAsync()
    {
        if (_pasteModule is null) return;
        await _pasteModule.InvokeVoidAsync("setAllowed", ComputePasteAllowed(Composer.IsStreaming, _uploading, _pending));
    }

    /// <summary>
    /// Whether a clipboard paste may currently produce a pending attachment. A paste is refused
    /// while another attachment is pending, while an upload is running and while the Composer is
    /// streaming, so an existing pending attachment can never be replaced or orphaned.
    /// </summary>
    /// <param name="isStreaming">Whether the Composer is streaming.</param>
    /// <param name="uploading">Whether an attachment upload is already in flight.</param>
    /// <param name="pending">The current pending attachment, if any.</param>
    internal static bool ComputePasteAllowed(bool isStreaming, bool uploading, object? pending)
        => !isStreaming && !uploading && pending is null;


    private void LoadHistory()
    {
        _messages.Clear();
        foreach (var (role, content) in Composer.GetChatHistory())
        {
            _messages.Add(new ChatMessage { Role = role, Content = content });
        }
    }

    private void HandleStreamingUpdate()
    {
        InvokeAsync(async () =>
        {
            // When streaming finishes, reload history to get the final message
            if (!Composer.IsStreaming)
            {
                LoadHistory();
            }
            StateHasChanged();

            // CRITICAL: streaming toggles paste availability. Without this the JS mirror would
            // stay allowed=false forever once a stream ends, permanently killing paste.
            await SyncPasteAllowedAsync();
        });
    }

    private async Task SendMessage()
    {
        if (!CanSend) return;

        string text;
        if (_pending is not null)
        {
            var ext = Path.GetExtension(_pending.SavedRelativePath);
            var absPath = Path.Combine(AttachmentService.AttachmentsRootPath, _pending.SavedRelativePath);
            text = BuildAttachmentMessage(_inputText, _pending.DisplayName, ext, absPath);
        }
        else
        {
            text = _inputText.Trim();
        }

        _messages.Add(new ChatMessage { Role = "user", Content = text });

        // Call Composer.SendMessage first. Only after it returns without throwing do we
        // perform destructive state transitions (MarkAsSent, clear pending/input/error).
        // This keeps _pending and _inputText intact for retry if the call fails.
        Composer.SendMessage(text);

        if (_pending is not null)
        {
            AttachmentService.MarkAsSent(_pending);
            _pending = null;
        }

        _inputText = "";
        _attachmentError = null;
        StateHasChanged();
        await SyncPasteAllowedAsync();
    }

    internal static string BuildAttachmentMessage(string? userText, string displayName, string extension, string savedAbsPath)
    {
        var kind = extension.TrimStart('.').Equals("pdf", StringComparison.OrdinalIgnoreCase) ? "pdf" : "image";
        var encodedPath = System.Text.Json.JsonSerializer.Serialize(savedAbsPath);
        var encodedName = System.Text.Json.JsonSerializer.Serialize(displayName);
        var block = " [Attached " + kind + " file " + encodedName + "; saved at " + encodedPath
            + ". To analyze it, delegate to a vision-capable sub-agent with start_sub_agent(task: \"Analyze this attachment\", image_paths: ["
            + encodedPath + "]).]";
        if (string.IsNullOrWhiteSpace(userText))
            return "The user attached a file with no accompanying text." + block;
        return userText.TrimEnd() + block;
    }

    internal static bool ComputeCanSend(bool isStreaming, bool uploading, string inputText, object? pending)
        => !isStreaming && !uploading && (!string.IsNullOrWhiteSpace(inputText) || pending is not null);

    private bool CanSend => ComputeCanSend(Composer.IsStreaming, _uploading, _inputText, _pending);

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _attachmentError = null;
        var file = e.File;
        if (file is null || file.Size == 0)
        {
            _attachmentError = "No file selected or file is empty.";
            StateHasChanged();
            return;
        }

        _uploading = true;

        // Mirrored BEFORE the first await: while the picker upload runs, a paste must be left
        // alone by JS rather than intercepted and then silently dropped by the .NET guard —
        // that would swallow the user's clipboard content with no feedback. Best-effort: a
        // failing mirror update must not abort the upload and strand the _uploading claim.
        await TrySyncPasteAllowedAsync(PasteHost);

        try
        {
            // maxAllowedSize is MaxAttachmentBytes + 1 so files at exactly the cap pass
            // and files exceeding it throw IOException (Blazor throws IOException, NOT FileLoadException)
            await using var stream = file.OpenReadStream(
                maxAllowedSize: ComposerAttachmentService.MaxAttachmentBytes + 1);
            await SaveAttachmentAsync(file.Name, stream);
        }
        catch (IOException ex)
        {
            _attachmentError = ex.Message; // includes oversize rejection
        }
        catch (Exception ex)
        {
            _attachmentError = ex.Message;
        }
        finally
        {
            _uploading = false;
            StateHasChanged();

            // Best-effort: a failing mirror update must not mask the upload's own outcome.
            await TrySyncPasteAllowedAsync(PasteHost);
        }
    }

    /// <summary>
    /// Narrow seam over the component state the paste flow touches, so the PRODUCTION handler
    /// body (<see cref="HandlePasteCoreAsync"/> and <see cref="SaveAttachmentAsync(IPasteHost, string, Stream)"/>)
    /// can be exercised by tests without a live Blazor circuit. The component itself is the only
    /// production implementation.
    /// </summary>
    internal interface IPasteHost
    {
        /// <summary>The currently staged attachment, if any.</summary>
        ComposerAttachment? Pending { get; set; }

        /// <summary>Whether an attachment upload is in flight.</summary>
        bool Uploading { get; set; }

        /// <summary>Error surfaced under the input area, if any.</summary>
        string? AttachmentError { get; set; }

        /// <summary>Whether the Composer is currently streaming a response.</summary>
        bool IsStreaming { get; }

        /// <summary>Streams the content into the attachment store.</summary>
        /// <param name="originalName">Display name recorded for the attachment.</param>
        /// <param name="content">Content stream; never fully buffered.</param>
        Task<AttachmentSaveResult> SaveAsync(string originalName, Stream content);

        /// <summary>Requests a re-render (the component's <c>StateHasChanged</c>).</summary>
        void Notify();

        /// <summary>Mirrors the authoritative paste-allowed state into the JS module.</summary>
        Task SyncPasteAllowedAsync();
    }

    /// <summary>Binds <see cref="IPasteHost"/> to this component's own fields and services.</summary>
    private sealed class ComponentPasteHost(ComposerChat owner) : IPasteHost
    {
        /// <inheritdoc />
        public ComposerAttachment? Pending
        {
            get => owner._pending;
            set => owner._pending = value;
        }

        /// <inheritdoc />
        public bool Uploading
        {
            get => owner._uploading;
            set => owner._uploading = value;
        }

        /// <inheritdoc />
        public string? AttachmentError
        {
            get => owner._attachmentError;
            set => owner._attachmentError = value;
        }

        /// <inheritdoc />
        public bool IsStreaming => owner.Composer.IsStreaming;

        /// <inheritdoc />
        public Task<AttachmentSaveResult> SaveAsync(string originalName, Stream content)
            => owner.AttachmentService.SaveAsync(originalName, content);

        /// <inheritdoc />
        public void Notify() => owner.StateHasChanged();

        /// <inheritdoc />
        public Task SyncPasteAllowedAsync() => owner.SyncPasteAllowedAsync();
    }

    private IPasteHost? _pasteHost;

    private IPasteHost PasteHost => _pasteHost ??= new ComponentPasteHost(this);

    /// <summary>
    /// Shared save path for BOTH the file picker and a clipboard paste: streams the content into
    /// <see cref="ComposerAttachmentService.SaveAsync"/> and reflects the outcome in the pending
    /// attachment / error state. The caller owns the stream, its size guard and its exception
    /// handling (the picker's <see cref="IOException"/> oversize contract is picker-specific).
    /// </summary>
    /// <param name="host">State seam the outcome is written to.</param>
    /// <param name="originalName">Display name recorded for the attachment.</param>
    /// <param name="stream">Content stream; never fully buffered.</param>
    internal static async Task SaveAttachmentAsync(IPasteHost host, string originalName, Stream stream)
    {
        host.Uploading = true;
        try
        {
            var result = await host.SaveAsync(originalName, stream);
            if (result.Success && result.Attachment is not null)
            {
                host.Pending = result.Attachment;
            }
            else
            {
                host.AttachmentError = result.Error ?? "Failed to save attachment.";
            }
        }
        finally
        {
            host.Uploading = false;
        }
    }

    /// <summary>Runs the shared save path against this component's own state.</summary>
    /// <param name="originalName">Display name recorded for the attachment.</param>
    /// <param name="stream">Content stream; never fully buffered.</param>
    private Task SaveAttachmentAsync(string originalName, Stream stream)
        => SaveAttachmentAsync(PasteHost, originalName, stream);

    /// <summary>
    /// Maps a supported clipboard MIME type to the extension used for the generated file name.
    /// Any other value is an unsupported clipboard item and is rejected before any save.
    /// </summary>
    internal static readonly IReadOnlyDictionary<string, string> PasteMimeExtensions =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["image/png"] = "png",
            ["image/jpeg"] = "jpg",
            ["image/gif"] = "gif",
            ["image/webp"] = "webp",
            ["application/pdf"] = "pdf",
        };

    /// <summary>Error surfaced when a clipboard item's MIME type is missing or unsupported.</summary>
    internal const string UnsupportedClipboardItemError = "Unsupported clipboard item.";

    /// <summary>Error surfaced when a clipboard item declares no bytes (matches the picker's empty-file error).</summary>
    internal const string EmptyAttachmentError = "No file selected or file is empty.";

    /// <summary>
    /// Authoritative validation for a pasted clipboard item, mirroring the JS-side filter.
    /// Returns the extension to use when the paste is acceptable; otherwise <c>null</c> and the
    /// error to surface, and NO save must be attempted.
    /// </summary>
    /// <param name="mimeType">MIME type reported by the clipboard item.</param>
    /// <param name="declaredLength">Declared byte length of the clipboard blob.</param>
    /// <param name="error">Error to surface when the paste is rejected; otherwise <c>null</c>.</param>
    internal static string? ValidatePaste(string? mimeType, long declaredLength, out string? error)
    {
        if (string.IsNullOrWhiteSpace(mimeType) || !PasteMimeExtensions.TryGetValue(mimeType, out var ext))
        {
            error = UnsupportedClipboardItemError;
            return null;
        }

        if (declaredLength <= 0)
        {
            error = EmptyAttachmentError;
            return null;
        }

        error = null;
        return ext;
    }

    /// <summary>
    /// Builds the generated name for a pasted attachment: <c>paste-{yyyyMMdd-HHmmss}.{ext}</c>.
    /// </summary>
    /// <param name="extension">Extension without a leading dot (for example <c>png</c>).</param>
    /// <param name="utcNow">Timestamp used for the name (UTC).</param>
    internal static string BuildPasteFileName(string extension, DateTime utcNow)
        => $"paste-{utcNow:yyyyMMdd-HHmmss}.{extension}";

    /// <summary>
    /// Receives a pasted image/PDF blob streamed from the browser and funnels it into the SAME
    /// pending-attachment flow the file picker uses.
    /// </summary>
    /// <remarks>
    /// The JS <c>allowed</c> flag is only a mirror: this method re-validates state, MIME and size
    /// authoritatively. A stale mirror that let a paste through is dropped silently so an existing
    /// pending attachment is never replaced or orphaned.
    /// </remarks>
    /// <param name="streamRef">JS stream reference over the pasted blob.</param>
    /// <param name="mimeType">MIME type reported by the clipboard item.</param>
    /// <param name="declaredLength">Declared byte length of the blob.</param>
    [JSInvokable]
    public Task HandlePasteAsync(IJSStreamReference streamRef, string mimeType, long declaredLength)
        => HandlePasteCoreAsync(PasteHost, streamRef, mimeType, declaredLength);

    /// <summary>
    /// The PRODUCTION paste body, written against <see cref="IPasteHost"/> so tests exercise this
    /// exact code rather than a re-implementation.
    /// </summary>
    /// <remarks>
    /// Two invariants are enforced by the outer <c>finally</c>, on EVERY path (accepted, rejected
    /// or faulted): the <paramref name="streamRef"/> is disposed (it is owned by this call and
    /// leaks otherwise) and the JS allowed-state is re-synced (JS set <c>allowed = false</c>
    /// synchronously before invoking, so a rejection that skipped the sync would permanently
    /// disable paste).
    /// </remarks>
    /// <param name="host">State seam the outcome is written to.</param>
    /// <param name="streamRef">JS stream reference over the pasted blob; disposed here.</param>
    /// <param name="mimeType">MIME type reported by the clipboard item.</param>
    /// <param name="declaredLength">Declared byte length of the blob.</param>
    internal static async Task HandlePasteCoreAsync(
        IPasteHost host, IJSStreamReference streamRef, string? mimeType, long declaredLength)
    {
        ArgumentNullException.ThrowIfNull(host);
        ArgumentNullException.ThrowIfNull(streamRef);

        try
        {
            // Stale-mirror guard: .NET state changed after setAllowed(true) was mirrored. Drop the
            // paste silently — never save over / orphan the existing pending attachment.
            if (!ComputePasteAllowed(host.IsStreaming, host.Uploading, host.Pending))
                return;

            host.AttachmentError = null;

            var ext = ValidatePaste(mimeType, declaredLength, out var validationError);
            if (ext is null)
            {
                host.AttachmentError = validationError;
                host.Notify();
                return;
            }

            // Claimed BEFORE the first await so a second paste (or a picker upload) starting
            // while the stream is being opened is refused by the guard above rather than racing
            // this one. SaveAttachmentAsync re-sets it (harmlessly) and clears it in its finally.
            host.Uploading = true;

            // Accepting the paste is itself a transition .NET must mirror: JS set allowed = false
            // for THIS paste only, and the authoritative upload-in-progress state is ours.
            await TrySyncPasteAllowedAsync(host);

            var generatedName = BuildPasteFileName(ext, DateTime.UtcNow);

            try
            {
                // The declared length is used verbatim: the framework default is far below the
                // attachment cap. SaveAsync is the bounded reader and the size authority — it
                // rejects oversize content with "attachment exceeds 20 MiB".
                await using var stream = await streamRef.OpenReadStreamAsync(maxAllowedSize: declaredLength);
                await SaveAttachmentAsync(host, generatedName, stream);
            }
            catch (Exception ex)
            {
                host.AttachmentError = ex.Message;
            }
            finally
            {
                // Released even when the stream could never be opened (SaveAttachmentAsync,
                // which normally clears it, was never reached).
                host.Uploading = false;
            }

            host.Notify();
        }
        finally
        {
            // Two INDEPENDENT cleanup steps. The stream reference is owned by this invocation and
            // must be disposed on every path; the allowed-state mirror must be restored on every
            // path too (JS set allowed = false synchronously before invoking, so even a silent
            // stale-mirror drop has to restore it). The nested finally guarantees the sync runs
            // even when disposal throws something other than JSDisconnectedException.
            try
            {
                await streamRef.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit teardown: the browser-side reference is already gone.
            }
            finally
            {
                // Best-effort: a failing mirror update must not mask the paste's own outcome
                // (or a disposal fault that is propagating out of the try above).
                await TrySyncPasteAllowedAsync(host);
            }
        }
    }

    /// <summary>
    /// Mirrors the allowed-state to JS without ever throwing. The mirror is an optimisation —
    /// .NET re-validates every paste authoritatively — so a failed update must never mask the
    /// outcome of the operation that triggered it, nor a fault already propagating out of a
    /// cleanup path. Unexpected failures are logged rather than silently discarded.
    /// </summary>
    /// <param name="host">State seam whose mirror is updated.</param>
    private static async Task TrySyncPasteAllowedAsync(IPasteHost host)
    {
        try
        {
            await host.SyncPasteAllowedAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Paste allowed-state sync failed: {ex.Message}");
        }
    }

    private async Task RemoveAttachment()
    {
        if (_pending is null) return;
        var result = AttachmentService.Remove(_pending);
        if (result.Success)
        {
            _pending = null;
            _attachmentError = null;
        }
        else
        {
            // Keep the chip, show the error
            _attachmentError = result.Error ?? "Failed to remove attachment.";
        }
        StateHasChanged();
        await SyncPasteAllowedAsync();
    }

    private async Task ResetSession()
    {
        if (Composer.IsStreaming) return;
        await Composer.ResetSessionAsync();
        _messages.Clear();
        _pending = null;        // Composer's reset calls ClearAllAsync which may delete the file
        _attachmentError = null; // clear any pending-related error note
        StateHasChanged();
        await SyncPasteAllowedAsync();
    }

    private async Task CompactSession()
    {
        if (Composer.IsStreaming || Composer.IsCompacting) return;
        try
        {
            var response = await HttpClient.PostAsync("/api/composer/compact", null);
            if (response.IsSuccessStatusCode)
            {
                LoadHistory();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Compact failed: {ex.Message}");
        }
    }

    private async Task CompactPartial()
    {
        if (Composer.IsStreaming || Composer.IsCompacting) return;
        try
        {
            var response = await HttpClient.PostAsync("/api/composer/compact-partial?percent=50", null);
            if (response.IsSuccessStatusCode)
            {
                LoadHistory();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Partial compact failed: {ex.Message}");
        }
    }

    private async Task LoadAvailableModelsAsync()
    {
        try
        {
            var response = await HttpClient.GetFromJsonAsync<ModelsResponse>("/api/composer/models", ApiJsonOptions);
            if (response?.Models is { Count: > 0 })
            {
                _availableModels = response.Models;
            }
            // A Composer with no configured reasoning effort presents as "None" in the dropdown,
            // so the value shown always matches what a subsequent switch would send.
            _selectedReasoning = InitialReasoning(response?.ReasoningEffort);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Failed to load available models: {ex.Message}");
        }
    }

    /// <summary>
    /// Fetches the Composer's actual current model and sets it as the initial
    /// dropdown selection, ensuring correctness after a runtime model switch.
    /// </summary>
    private async Task LoadCurrentModelAsync()
    {
        try
        {
            var response = await HttpClient.GetFromJsonAsync<CurrentModelResponse>("/api/composer/current-model", ApiJsonOptions);
            if (!string.IsNullOrWhiteSpace(response?.Model) && _availableModels.Contains(response.Model))
            {
                _selectedModel = response.Model;
            }
            else if (_availableModels.Count > 0)
            {
                // Fallback: Composer model not in list or API returned empty, use first available
                _selectedModel = _availableModels[0];
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Failed to load current model: {ex.Message}");
            // Fallback to first available model on error
            if (_availableModels.Count > 0)
            {
                _selectedModel = _availableModels[0];
            }
        }
    }

    /// <summary>
    /// Builds the switch request URI. Both parameters are always sent: the reasoning effort uses
    /// its canonical wire form (<c>extra_high</c>, never <c>ExtraHigh</c>) so it round-trips
    /// through <see cref="ReasoningEffortConverter.Parse(string?)"/> on the server.
    /// </summary>
    /// <param name="model">Model identifier to switch to.</param>
    /// <param name="reasoning">Reasoning effort to switch to.</param>
    internal static string BuildSwitchUri(string model, ReasoningEffort reasoning)
        => $"/api/composer/models/switch?model={Uri.EscapeDataString(model)}" +
           $"&reasoning={Uri.EscapeDataString(ReasoningEffortConverter.Format(reasoning)!)}";

    /// <summary>
    /// The reasoning level the dropdown starts on. A Composer with no configured effort reports
    /// <c>null</c>, which presents as <see cref="ReasoningEffort.None"/> so the displayed value
    /// always matches what a subsequent switch would send.
    /// </summary>
    /// <param name="fromResponse">The <c>reasoningEffort</c> field of the models response.</param>
    internal static ReasoningEffort InitialReasoning(ReasoningEffort? fromResponse)
        => fromResponse ?? ReasoningEffort.None;

    /// <summary>
    /// The reasoning level the dropdown must show after a switch attempt. A rejected switch left
    /// the server on the previous level, so the dropdown is restored rather than left showing a
    /// level that was never applied.
    /// </summary>
    /// <param name="previous">The level shown before the attempt.</param>
    /// <param name="attempted">The level the user selected.</param>
    /// <param name="succeeded">Whether the switch request succeeded.</param>
    internal static ReasoningEffort ResolveReasoningAfterSwitch(
        ReasoningEffort previous, ReasoningEffort attempted, bool succeeded)
        => succeeded ? attempted : previous;

    private async Task HandleModelChange(ChangeEventArgs e)
    {
        if (e.Value is not string model || string.IsNullOrWhiteSpace(model)) return;
        if (!_availableModels.Contains(model)) return;

        try
        {
            // The current reasoning selection travels with the new model — the server requires
            // both and never infers reasoning from the model name.
            var response = await HttpClient.PostAsJsonAsync(
                BuildSwitchUri(model, _selectedReasoning), (object?)null, ApiJsonOptions);
            if (response.IsSuccessStatusCode)
            {
                _selectedModel = model;
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(ApiJsonOptions);
                Console.Error.WriteLine($"[ComposerChat] Model switch failed: {error?.Error ?? response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Model switch failed: {ex.Message}");
        }
    }

    private async Task HandleReasoningChange(ChangeEventArgs e)
    {
        if (e.Value is not string raw || string.IsNullOrWhiteSpace(raw)) return;

        ReasoningEffort newReasoning;
        try
        {
            newReasoning = ReasoningEffortConverter.Parse(raw)!.Value;
        }
        catch (ArgumentException)
        {
            return;
        }

        // Captured BEFORE the request so a rejected switch can restore exactly what was shown.
        var previous = _selectedReasoning;
        _selectedReasoning = newReasoning;

        try
        {
            var response = await HttpClient.PostAsJsonAsync(
                BuildSwitchUri(_selectedModel, newReasoning), (object?)null, ApiJsonOptions);
            _selectedReasoning = ResolveReasoningAfterSwitch(previous, newReasoning, response.IsSuccessStatusCode);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorResponse>(ApiJsonOptions);
                Console.Error.WriteLine($"[ComposerChat] Reasoning switch failed: {error?.Error ?? response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            _selectedReasoning = ResolveReasoningAfterSwitch(previous, newReasoning, succeeded: false);
            Console.Error.WriteLine($"[ComposerChat] Reasoning switch failed: {ex.Message}");
        }

        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private static string FormatContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return Markdown.ToHtml(content, MarkdownPipeline);
    }

    private static string FormatStreamingContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return Markdown.ToHtml(content, MarkdownPipeline);
    }

    public async ValueTask DisposeAsync()
    {
        Composer.OnStreamingUpdate -= HandleStreamingUpdate;
        Composer.OnQuestionAsked -= HandleQuestionAsked;
        Composer.OnCompactingStarted -= HandleCompactingStarted;
        Composer.OnCompacted -= HandleCompacted;
        Composer.OnSubAgentChanged -= HandleSubAgentChanged;

        if (_pasteModule is not null)
        {
            // Independently attempted: an uninstall fault must not skip the module disposal.
            try
            {
                await _pasteModule.InvokeVoidAsync("uninstall");
            }
            catch (JSDisconnectedException)
            {
                // Circuit teardown / navigation: the browser is already gone — expected, not a fault.
            }
            catch (Exception ex)
            {
                // Never silently swallowed: re-throwing here would mask whatever triggered
                // disposal, so an unexpected teardown fault is surfaced in the logs instead.
                Console.Error.WriteLine($"[ComposerChat] Paste module uninstall failed: {ex.Message}");
            }

            try
            {
                await _pasteModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit teardown / navigation: the module reference dies with the circuit.
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[ComposerChat] Paste module disposal failed: {ex.Message}");
            }

            _pasteModule = null;
        }

        _pasteDotNetRef?.Dispose();
        _pasteDotNetRef = null;
    }

    private void HandleSubAgentChanged(SubAgentInfo info)
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleSubAgents()
    {
        _subAgentsExpanded = !_subAgentsExpanded;
    }

    private static string StatusBadge(SubAgentStatus status) => status switch
    {
        SubAgentStatus.Running => "⏳ Running",
        SubAgentStatus.Completed => "✅ Completed",
        SubAgentStatus.Failed => "❌ Failed",
        SubAgentStatus.TimedOut => "⏱️ Timed out",
        SubAgentStatus.Cancelled => "🚫 Cancelled",
        _ => throw new InvalidOperationException($"Unhandled sub-agent status '{status}'.")
    };

    /// <summary>
    /// Formats the elapsed time. Running entries measure from <c>StartedAt</c> to now (refreshed
    /// only when a status event arrives — there is no per-second timer); terminal entries measure
    /// to <c>CompletedAt</c> when available.
    /// </summary>
    private static string Elapsed(SubAgentInfo info)
    {
        var end = info.Status == SubAgentStatus.Running
            ? DateTimeOffset.UtcNow
            : info.CompletedAt;

        if (end is null) return "";

        var span = end.Value - info.StartedAt;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;

        var totalMinutes = (int)span.TotalMinutes;
        return totalMinutes > 0
            ? $"{totalMinutes}m {span.Seconds}s"
            : $"{(int)span.TotalSeconds}s";
    }

    private void HandleCompactingStarted()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await SyncPasteAllowedAsync();
        });
    }

    private void HandleCompacted()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await SyncPasteAllowedAsync();
        });
    }

    private void HandleQuestionAsked()
    {
        InvokeAsync(StateHasChanged);
    }

    private void SelectSingle(string option)
    {
        _selectedOptions = [option];
    }

    private void ToggleOption(string option)
    {
        if (_selectedOptions.Contains(option))
            _selectedOptions.Remove(option);
        else
            _selectedOptions.Add(option);
    }

    private void SubmitYesNo(bool yes, ComposerQuestion question)
    {
        var answer = yes ? "Yes" : "No";
        if (!string.IsNullOrWhiteSpace(_questionFeedback))
            answer += $" — {_questionFeedback.Trim()}";

        _selectedOptions = [];
        _questionFeedback = "";
        Composer.SubmitAnswer(answer);
        StateHasChanged();
    }

    private void SubmitChoice(ComposerQuestion question)
    {
        var selected = string.Join(", ", _selectedOptions);
        var answer = string.IsNullOrWhiteSpace(_questionFeedback)
            ? selected
            : $"{selected} — {_questionFeedback.Trim()}";

        _selectedOptions = [];
        _questionFeedback = "";
        Composer.SubmitAnswer(answer);
        StateHasChanged();
    }

    private void CancelQuestion(ComposerQuestion question)
    {
        _selectedOptions = [];
        _questionFeedback = "";
        Composer.CancelQuestion();
        StateHasChanged();
    }

    private sealed record ModelsResponse(List<string> Models, ReasoningEffort? ReasoningEffort);
    private sealed record CurrentModelResponse(string Model);
    private sealed record ErrorResponse(string Error);
}
