    private IPasteHost? _pasteHost;

    private IPasteHost PasteHost => _pasteHost ??= new ComponentPasteHost(this);

    /// <summary>
    /// Shared save path for BOTH the file picker and a clipboard paste: streams the content into
    /// <see cref="ComposerAttachmentService.SaveAsync"/> and reflects the outcome in the pending
    /// attachment / error state. The caller owns the stream, its size guard and its exception
    /// handling (the picker's <see cref="IOException"/> oversize contract is picker-specific).
    /// </summary>
    /// <param name="host">State seam the outcome is written to.</param>
    /// <param name="originalName">Display name recorded for the attachment.</param>
    /// <param name="stream">Content stream; never fully buffered.</param>
    internal static async Task SaveAttachmentAsync(IPasteHost host, string originalName, Stream stream)
    {
        host.Uploading = true;
        try
        {
            var result = await host.SaveAsync(originalName, stream);
            if (result.Success && result.Attachment is not null)
            {
                host.Pending = result.Attachment;
            }
            else
            {
                host.AttachmentError = result.Error ?? "Failed to save attachment.";
            }
        }
        finally
        {
            host.Uploading = false;
        }
    }

    /// <summary>Runs the shared save path against this component's own state.</summary>
    /// <param name="originalName">Display name recorded for the attachment.</param>
    /// <param name="stream">Content stream; never fully buffered.</param>
    private Task SaveAttachmentAsync(string originalName, Stream stream)
        => SaveAttachmentAsync(PasteHost, originalName, stream);

    /// <summary>
    /// Maps a supported clipboard MIME type to the extension used for the generated file name.
    /// Any other value is an unsupported clipboard item and is rejected before any save.
    /// </summary>
    internal static readonly IReadOnlyDictionary<string, string> PasteMimeExtensions =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["image/png"] = "png",
            ["image/jpeg"] = "jpg",
            ["image/gif"] = "gif",
            ["image/webp"] = "webp",
            ["application/pdf"] = "pdf",
        };

    /// <summary>Error surfaced when a clipboard item's MIME type is missing or unsupported.</summary>
    internal const string UnsupportedClipboardItemError = "Unsupported clipboard item.";

    /// <summary>Error surfaced when a clipboard item declares no bytes (matches the picker's empty-file error).</summary>
    internal const string EmptyAttachmentError = "No file selected or file is empty.";

    /// <summary>
    /// Authoritative validation for a pasted clipboard item, mirroring the JS-side filter.
    /// Returns the extension to use when the paste is acceptable; otherwise <c>null</c> and the
    /// error to surface, and NO save must be attempted.
    /// </summary>
    /// <param name="mimeType">MIME type reported by the clipboard item.</param>
    /// <param name="declaredLength">Declared byte length of the clipboard blob.</param>
    /// <param name="error">Error to surface when the paste is rejected; otherwise <c>null</c>.</param>
    internal static string? ValidatePaste(string? mimeType, long declaredLength, out string? error)
    {
        if (string.IsNullOrWhiteSpace(mimeType) || !PasteMimeExtensions.TryGetValue(mimeType, out var ext))
        {
            error = UnsupportedClipboardItemError;
            return null;
        }

        if (declaredLength <= 0)
        {
            error = EmptyAttachmentError;
            return null;
        }

        error = null;
        return ext;
    }

    /// <summary>
    /// Builds the generated name for a pasted attachment: <c>paste-{yyyyMMdd-HHmmss}.{ext}</c>.
    /// </summary>
    /// <param name="extension">Extension without a leading dot (for example <c>png</c>).</param>
    /// <param name="utcNow">Timestamp used for the name (UTC).</param>
    internal static string BuildPasteFileName(string extension, DateTime utcNow)
        => $"paste-{utcNow:yyyyMMdd-HHmmss}.{extension}";

    /// <summary>
    /// Receives a pasted image/PDF blob streamed from the browser and funnels it into the SAME
    /// pending-attachment flow the file picker uses.
    /// </summary>
    /// <remarks>
    /// The JS <c>allowed</c> flag is only a mirror: this method re-validates state, MIME and size
    /// authoritatively. A stale mirror that let a paste through is dropped silently so an existing
    /// pending attachment is never replaced or orphaned.
    /// </remarks>
    /// <param name="streamRef">JS stream reference over the pasted blob.</param>
    /// <param name="mimeType">MIME type reported by the clipboard item.</param>
    /// <param name="declaredLength">Declared byte length of the blob.</param>
    [JSInvokable]
    public Task HandlePasteAsync(IJSStreamReference streamRef, string mimeType, long declaredLength)
        => HandlePasteCoreAsync(PasteHost, streamRef, mimeType, declaredLength);

    /// <summary>
    /// The PRODUCTION paste body, written against <see cref="IPasteHost"/> so tests exercise this
    /// exact code rather than a re-implementation.
    /// </summary>
    /// <remarks>
    /// Two invariants are enforced by the outer <c>finally</c>, on EVERY path (accepted, rejected
    /// or faulted): the <paramref name="streamRef"/> is disposed (it is owned by this call and
    /// leaks otherwise) and the JS allowed-state is re-synced (JS set <c>allowed = false</c>
    /// synchronously before invoking, so a rejection that skipped the sync would permanently
    /// disable paste).
    /// </remarks>
    /// <param name="host">State seam the outcome is written to.</param>
    /// <param name="streamRef">JS stream reference over the pasted blob; disposed here.</param>
    /// <param name="mimeType">MIME type reported by the clipboard item.</param>
    /// <param name="declaredLength">Declared byte length of the blob.</param>
    internal static async Task HandlePasteCoreAsync(
        IPasteHost host, IJSStreamReference streamRef, string? mimeType, long declaredLength)
    {
        ArgumentNullException.ThrowIfNull(host);
        ArgumentNullException.ThrowIfNull(streamRef);

        try
        {
            // Stale-mirror guard: .NET state changed after setAllowed(true) was mirrored. Drop the
            // paste silently — never save over / orphan the existing pending attachment.
            if (!ComputePasteAllowed(host.IsStreaming, host.Uploading, host.Pending))
                return;

            host.AttachmentError = null;

            var ext = ValidatePaste(mimeType, declaredLength, out var validationError);
            if (ext is null)
            {
                host.AttachmentError = validationError;
                host.Notify();
                return;
            }

            // Claimed BEFORE the first await so a second paste (or a picker upload) starting
            // while the stream is being opened is refused by the guard above rather than racing
            // this one. SaveAttachmentAsync re-sets it (harmlessly) and clears it in its finally.
            host.Uploading = true;

            // Accepting the paste is itself a transition .NET must mirror: JS set allowed = false
            // for THIS paste only, and the authoritative upload-in-progress state is ours.
            await TrySyncPasteAllowedAsync(host);

            var generatedName = BuildPasteFileName(ext, DateTime.UtcNow);

            try
            {
                // The declared length is used verbatim: the framework default is far below the
                // attachment cap. SaveAsync is the bounded reader and the size authority — it
                // rejects oversize content with "attachment exceeds 20 MiB".
                await using var stream = await streamRef.OpenReadStreamAsync(maxAllowedSize: declaredLength);
                await SaveAttachmentAsync(host, generatedName, stream);
            }
            catch (Exception ex)
            {
                host.AttachmentError = ex.Message;
            }
            finally
            {
                // Released even when the stream could never be opened (SaveAttachmentAsync,
                // which normally clears it, was never reached).
                host.Uploading = false;
            }

            host.Notify();
        }
        finally
        {
            // Two INDEPENDENT cleanup steps. The stream reference is owned by this invocation and
            // must be disposed on every path; the allowed-state mirror must be restored on every
            // path too (JS set allowed = false synchronously before invoking, so even a silent
            // stale-mirror drop has to restore it). The nested finally guarantees the sync runs
            // even when disposal throws something other than JSDisconnectedException.
            try
            {
                await streamRef.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit teardown: the browser-side reference is already gone.
            }
            finally
            {
                // Best-effort: a failing mirror update must not mask the paste's own outcome
                // (or a disposal fault that is propagating out of the try above).
                await TrySyncPasteAllowedAsync(host);
            }
        }
    }

    /// <summary>
    /// Mirrors the allowed-state to JS without ever throwing. The mirror is an optimisation —
    /// .NET re-validates every paste authoritatively — so a failed update must never mask the
    /// outcome of the operation that triggered it, nor a fault already propagating out of a
    /// cleanup path. Unexpected failures are logged rather than silently discarded.
    /// </summary>
    /// <param name="host">State seam whose mirror is updated.</param>
    private static async Task TrySyncPasteAllowedAsync(IPasteHost host)
    {
        try
        {
            await host.SyncPasteAllowedAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Paste allowed-state sync failed: {ex.Message}");
        }
    }

    private async Task RemoveAttachment()
    {
        if (_pending is null) return;
        var result = AttachmentService.Remove(_pending);
        if (result.Success)
        {
            _pending = null;
            _attachmentError = null;
        }
        else
        {
            // Keep the chip, show the error
            _attachmentError = result.Error ?? "Failed to remove attachment.";
        }
        StateHasChanged();
        await SyncPasteAllowedAsync();
    }

    private async Task ResetSession()
    {
        if (Composer.IsStreaming) return;
        await Composer.ResetSessionAsync();
        _messages.Clear();
        _pending = null;        // Composer's reset calls ClearAllAsync which may delete the file
        _attachmentError = null; // clear any pending-related error note
        StateHasChanged();
        await SyncPasteAllowedAsync();
    }

    private async Task CompactSession()
    {
        if (Composer.IsStreaming || Composer.IsCompacting) return;
        try
        {
            var result = await ComposerFacade.CompactAsync();
            if (result.Success)
            {
                LoadHistory();
            }
            // A failed compaction leaves the thread exactly as it was — the history is NOT
            // reloaded — but the view is still refreshed so the compacting indicator clears.
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Compact failed: {ex.Message}");
        }
    }

    private async Task CompactPartial()
    {
        if (Composer.IsStreaming || Composer.IsCompacting) return;
        try
        {
            var result = await ComposerFacade.CompactPartialAsync(50);
            if (result.Success)
            {
                LoadHistory();
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Partial compact failed: {ex.Message}");
        }
    }

    /// <summary>
    /// The button label for the active-notifications toggle: passive → "🔕 Passive",
    /// active → "🔔 Active", off → "🔕 Off". A mode that has not loaded yet (<c>null</c>)
    /// shows a neutral placeholder rather than a fabricated default, so the UI never claims
    /// a mode the server never reported.
    /// </summary>
    /// <param name="mode">The authoritative loaded mode, or <c>null</c> when not yet loaded.</param>
    internal static string ActiveNotificationsLabel(string? mode) => mode switch
    {
        "passive" => "🔕 Passive",
        "active" => "🔔 Active",
        "off" => "🔕 Off",
        _ => "🔕 …",
    };

    private string ActiveNotificationsButtonText => ActiveNotificationsLabel(_activeNotifMode);

    /// <summary>
    /// The next mode in the cycle passive → active → off → passive.
    /// </summary>
    /// <param name="current">The authoritative current mode.</param>
    internal static string NextActiveNotificationsMode(string current) => current switch
    {
        "passive" => "active",
        "active" => "off",
        "off" => "passive",
        _ => throw new InvalidOperationException($"Unhandled event notification mode '{current}'."),
    };

    /// <summary>
    /// Normalizes a mode reported by <see cref="IConfigFacade.GetComposer"/>. The projection
    /// already returns the effective (normalized) mode, so anything outside the three known
    /// values is treated as "not loaded" (<c>null</c>) rather than being coerced into a default
    /// that would let the toggle persist a transition derived from a value never reported.
    /// </summary>
    /// <param name="mode">The raw mode from the projection.</param>
    internal static string? NormalizeLoadedNotificationsMode(string? mode) => mode switch
    {
        "passive" or "active" or "off" => mode,
        _ => null,
    };

    /// <summary>
    /// Whether the toggle may run right now. It requires an authoritative loaded mode
    /// (<paramref name="mode"/> non-null), an idle Composer, and no toggle already in flight —
    /// the last of which stops two rapid clicks from both deriving their next mode from the
    /// same stale value and persisting the same transition twice.
    /// </summary>
    /// <param name="mode">The authoritative loaded mode, or <c>null</c> when not yet loaded.</param>
    /// <param name="isStreaming">Whether the Composer is streaming.</param>
    /// <param name="togglePending">Whether a toggle request is already in flight.</param>
    internal static bool CanToggleActiveNotifications(string? mode, bool isStreaming, bool togglePending)
        => mode is not null && !isStreaming && !togglePending;

    /// <summary>
    /// Narrow seam over the component state the notification toggle touches, so the PRODUCTION
    /// toggle body (<see cref="ToggleActiveNotificationsCoreAsync"/>) can be exercised by tests
    /// without a live Blazor circuit. The component itself is the only production implementation.
    /// </summary>
    internal interface INotificationToggleHost
    {
        /// <summary>The authoritative mode, or <c>null</c> until the config GET has loaded it.</summary>
        string? Mode { get; set; }

        /// <summary>Whether a toggle save is currently in flight.</summary>
        bool TogglePending { get; set; }

        /// <summary>Whether a mode change has been persisted and needs a restart to take effect.</summary>
        bool RestartRequired { get; set; }

        /// <summary>Error surfaced next to the toggle button, if any.</summary>
        string? ToggleError { get; set; }

        /// <summary>Whether the Composer is currently streaming a response.</summary>
        bool IsStreaming { get; }

        /// <summary>Persists the mode change through <see cref="IConfigFacade.SaveComposerAsync"/>.</summary>
        /// <param name="mode">The mode to persist.</param>
        Task<FacadeResult<SavedResult>> SaveModeAsync(string mode);

        /// <summary>Requests a re-render (the component's <c>StateHasChanged</c>).</summary>
        void Notify();
    }

    /// <summary>Binds <see cref="INotificationToggleHost"/> to this component's own fields and services.</summary>
    private sealed class ComponentNotificationToggleHost(ComposerChat owner) : INotificationToggleHost
    {
        /// <inheritdoc />
        public string? Mode
        {
            get => owner._activeNotifMode;
            set => owner._activeNotifMode = value;
        }

        /// <inheritdoc />
        public bool TogglePending
        {
            get => owner._notifTogglePending;
            set => owner._notifTogglePending = value;
        }

        /// <inheritdoc />
        public bool RestartRequired
        {
            get => owner._restartRequiredForNotifications;
            set => owner._restartRequiredForNotifications = value;
        }

        /// <inheritdoc />
        public string? ToggleError
        {
            get => owner._notifToggleError;
            set => owner._notifToggleError = value;
        }

        /// <inheritdoc />
        public bool IsStreaming => owner.Composer.IsStreaming;

        /// <inheritdoc />
        public Task<FacadeResult<SavedResult>> SaveModeAsync(string mode)
            => owner.ConfigFacade.SaveComposerAsync(
                new ComposerSettingsUpdate(EventNotificationsMode: mode), CancellationToken.None);

        /// <inheritdoc />
        public void Notify() => owner.StateHasChanged();
    }

    private INotificationToggleHost? _notificationToggleHost;

    private INotificationToggleHost NotificationToggleHost =>
        _notificationToggleHost ??= new ComponentNotificationToggleHost(this);

    /// <summary>
    /// Loads the effective event-notification mode through <see cref="IConfigFacade.GetComposer"/>.
    /// This runs regardless of whether the Composer agent is connected — the config projection is
    /// independent of that connection. A failed load leaves the mode <c>null</c> (not loaded),
    /// which keeps the toggle disabled instead of letting it persist a transition computed from a
    /// fabricated <c>passive</c> default that could overwrite a stored <c>active</c>/<c>off</c>.
    /// </summary>
    private Task LoadActiveNotificationsModeAsync()
    {
        try
        {
            var result = ConfigFacade.GetComposer();
            if (!result.Success)
            {
                // Left unloaded on purpose: the toggle stays disabled rather than guessing.
                _activeNotifMode = null;
                _notifToggleError = $"Failed to load notification mode: {result.Error}";
                return Task.CompletedTask;
            }

            _activeNotifMode = NormalizeLoadedNotificationsMode(result.Value?.EventNotifications?.Mode);
            if (_activeNotifMode is null)
                _notifToggleError = "Could not determine the current notification mode.";
        }
        catch (Exception ex)
        {
            // Left unloaded on purpose: the toggle stays disabled rather than guessing.
            _activeNotifMode = null;
            _notifToggleError = $"Failed to load notification mode: {ex.Message}";
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// The PRODUCTION toggle body, written against <see cref="INotificationToggleHost"/> so tests
    /// exercise this exact code rather than a re-implementation.
    /// </summary>
    /// <remarks>
    /// The next mode is derived from the authoritative loaded mode, and the in-flight claim is
    /// taken BEFORE the first await so a second click cannot compute its transition from the same
    /// pre-save value. The <c>finally</c> always releases the claim, so a failed toggle never
    /// leaves the button permanently disabled.
    /// </remarks>
    /// <param name="host">State seam the outcome is written to.</param>
    internal static async Task ToggleActiveNotificationsCoreAsync(INotificationToggleHost host)
    {
        ArgumentNullException.ThrowIfNull(host);

        // Not loaded / streaming / already toggling: drop the click entirely.
        if (!CanToggleActiveNotifications(host.Mode, host.IsStreaming, host.TogglePending))
            return;

        // Authoritative: the transition is computed from the loaded mode, never a default.
        var nextMode = NextActiveNotificationsMode(host.Mode!);

        // Claimed BEFORE the first await so an overlapping click is refused by the guard above.
        host.TogglePending = true;
        host.ToggleError = null;
        host.Notify();

        try
        {
            var result = await host.SaveModeAsync(nextMode);
            if (result.Success)
            {
                host.Mode = nextMode;
                host.RestartRequired = true;
            }
            else
            {
                host.ToggleError = $"Notification mode toggle failed: {result.Error}";
            }
        }
        catch (Exception ex)
        {
            host.ToggleError = $"Notification mode toggle failed: {ex.Message}";
        }
        finally
        {
            // Released on every path so a failure can be retried.
            host.TogglePending = false;
            host.Notify();
        }
    }

    /// <summary>Runs the shared toggle body against this component's own state.</summary>
    private Task ToggleActiveNotifications() => ToggleActiveNotificationsCoreAsync(NotificationToggleHost);

    private Task LoadAvailableModelsAsync()
    {
        try
        {
            var result = ComposerFacade.GetModels();
            if (!result.Success)
            {
                Console.Error.WriteLine($"[ComposerChat] Failed to load available models: {result.Error}");
                return Task.CompletedTask;
            }

            if (result.Value?.Models is { Count: > 0 } models)
            {
                _availableModels = models.ToList();
            }
            // A Composer with no configured reasoning effort presents as "None" in the dropdown,
            // so the value shown always matches what a subsequent switch would send.
            _selectedReasoning = InitialReasoning(result.Value?.ReasoningEffort);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Failed to load available models: {ex.Message}");
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// Fetches the Composer's actual current model and sets it as the initial
    /// dropdown selection, ensuring correctness after a runtime model switch.
    /// The production body lives in <see cref="LoadCurrentModelCoreAsync"/> so the
    /// thrown-exception handling is exercised by tests through the same code path.
    /// </summary>
    private Task LoadCurrentModelAsync()
    {
        return LoadCurrentModelCoreAsync(CurrentModelHost);
    }

    /// <summary>
    /// Narrow seam over the component state the current-model load touches, so the PRODUCTION
    /// body (<see cref="LoadCurrentModelCoreAsync"/>) can be exercised by tests without a live
    /// Blazor circuit — including the thrown-exception path, which a source-level test cannot
    /// execute. The component itself is the only production implementation.
    /// </summary>
    internal interface ICurrentModelHost
    {
        /// <summary>The models loaded from the catalog picker.</summary>
        IReadOnlyList<string> AvailableModels { get; }

        /// <summary>The current dropdown selection; cleared on every no-valid-model path.</summary>
        string SelectedModel { get; set; }

        /// <summary>Logs a current-model failure (console).</summary>
        /// <param name="error">The error text from the result or the thrown exception.</param>
        void LogCurrentModelFailure(string error);

        /// <summary>Reads the current model through the facade.</summary>
        Task<FacadeResult<CurrentModelDto>> GetCurrentModelAsync();
    }

    /// <summary>Binds <see cref="ICurrentModelHost"/> to this component's own fields and services.</summary>
    private sealed class ComponentCurrentModelHost(ComposerChat owner) : ICurrentModelHost
    {
        /// <inheritdoc />
        public IReadOnlyList<string> AvailableModels => owner._availableModels;

        /// <inheritdoc />
        public string SelectedModel
        {
            get => owner._selectedModel;
            set => owner._selectedModel = value;
        }

        /// <inheritdoc />
        public void LogCurrentModelFailure(string error)
            => Console.Error.WriteLine($"[ComposerChat] Failed to load current model: {error}");

        /// <inheritdoc />
        public Task<FacadeResult<CurrentModelDto>> GetCurrentModelAsync()
            => owner.ComposerFacade.GetCurrentModelAsync();
    }

    private ICurrentModelHost? _currentModelHost;

    private ICurrentModelHost CurrentModelHost => _currentModelHost ??= new ComponentCurrentModelHost(this);

    /// <summary>
    /// The PRODUCTION current-model body, written against <see cref="ICurrentModelHost"/> so
    /// tests exercise this exact code rather than a re-implementation.
    /// </summary>
    /// <remarks>
    /// The try/catch is scoped to the facade READ ONLY: the facade rethrows read failures by
    /// design, and this catch converts them into the same log-and-clear the unsuccessful-result
    /// path uses. Nothing outside this method's own read is caught, so surrounding
    /// switch/notification logic keeps its own handling.
    /// </remarks>
    /// <param name="host">State seam the outcome is written to.</param>
    internal static async Task LoadCurrentModelCoreAsync(ICurrentModelHost host)
    {
        ArgumentNullException.ThrowIfNull(host);

        FacadeResult<CurrentModelDto> result;
        try
        {
            // Scoped to the read call only — a fault here must never escape into the
            // component's init flow or the first-connect switch handler.
            result = await host.GetCurrentModelAsync();
        }
        catch (Exception ex)
        {
            // The facade rethrows read failures; restore the pre-migration behavior of
            // logging + clearing instead of faulting the circuit.
            host.LogCurrentModelFailure(ex.Message);
            host.SelectedModel = "";
            return;
        }

        if (!result.Success)
        {
            // Real failure: surface it (this replaces the previous exception path) and keep the
            // placeholder/no-selection state.
            host.LogCurrentModelFailure(result.Error ?? "Unknown error.");
            host.SelectedModel = "";
            return;
        }

        var model = result.Value?.Model;
        if (!string.IsNullOrWhiteSpace(model) && host.AvailableModels.Contains(model))
        {
            host.SelectedModel = model;
        }
        else
        {
            // No valid current model (unconfigured shell, or a model absent from the catalog):
            // keep the placeholder/no-selection state WITHOUT logging a failure — this is the
            // normal contract, not an error. Never auto-select the first catalog entry: a real
            // selection must fire a change event so the switch is actually invoked.
            host.SelectedModel = "";
        }
    }

    /// <summary>
    /// The reasoning effort value handed to <see cref="IComposerFacade.SwitchModelAsync"/>. The
    /// facade parses the CANONICAL wire form (<c>extra_high</c>, never <c>ExtraHigh</c>), so the
    /// conversion happens here rather than at each call site.
    /// </summary>
    /// <param name="reasoning">Reasoning effort to switch to.</param>
    internal static string SwitchReasoningWireValue(ReasoningEffort reasoning)
        => ReasoningEffortConverter.Format(reasoning)!;

    /// <summary>
    /// The reasoning level the dropdown starts on. A Composer with no configured effort reports
    /// <c>null</c>, which presents as <see cref="ReasoningEffort.None"/> so the displayed value
    /// always matches what a subsequent switch would send.
    /// </summary>
    /// <param name="fromResponse">The <c>reasoningEffort</c> field of the models response.</param>
    internal static ReasoningEffort InitialReasoning(ReasoningEffort? fromResponse)
        => fromResponse ?? ReasoningEffort.None;

    /// <summary>
    /// The reasoning level the dropdown must show after a switch attempt. A rejected switch left
    /// the server on the previous level, so the dropdown is restored rather than left showing a
    /// level that was never applied.
    /// </summary>
    /// <param name="previous">The level shown before the attempt.</param>
    /// <param name="attempted">The level the user selected.</param>
    /// <param name="succeeded">Whether the switch request succeeded.</param>
    internal static ReasoningEffort ResolveReasoningAfterSwitch(
        ReasoningEffort previous, ReasoningEffort attempted, bool succeeded)
        => succeeded ? attempted : previous;

    /// <summary>
    /// Narrow seam over the component state the model-selection flow touches, so the PRODUCTION
    /// handler body (<see cref="HandleModelChangeCoreAsync"/>) can be exercised by tests without
    /// a live Blazor circuit. The component itself is the only production implementation.
    /// </summary>
    internal interface IModelSwitchHost
    {
        /// <summary>Whether the Composer is connected BEFORE the switch attempt.</summary>
        bool IsConnected { get; }

        /// <summary>Switches the running Composer through <see cref="IComposerFacade.SwitchModelAsync"/>.</summary>
        /// <param name="model">Model identifier to switch to.</param>
        /// <param name="reasoning">Reasoning effort to switch to.</param>
        Task<FacadeResult<SwitchResultDto>> SwitchAsync(string model, ReasoningEffort reasoning);

        /// <summary>Reloads the message thread from the Composer session history.</summary>
        void LoadHistory();

        /// <summary>Refreshes the current model from the current-model endpoint.</summary>
        Task LoadCurrentModelAsync();

        /// <summary>Records the successfully applied model as the select's selection.</summary>
        void SetSelectedModel(string model);

        /// <summary>Requests a re-render (the component's <c>StateHasChanged</c>).</summary>
        void Notify();
    }

    /// <summary>Binds <see cref="IModelSwitchHost"/> to this component's own fields and services.</summary>
    private sealed class ComponentModelSwitchHost(ComposerChat owner) : IModelSwitchHost
    {
        /// <inheritdoc />
        public bool IsConnected => owner.Composer.IsConnected;

        /// <inheritdoc />
        public Task<FacadeResult<SwitchResultDto>> SwitchAsync(string model, ReasoningEffort reasoning)
            => owner.ComposerFacade.SwitchModelAsync(model, SwitchReasoningWireValue(reasoning));

        /// <inheritdoc />
        public void LoadHistory() => owner.LoadHistory();

        /// <inheritdoc />
        public Task LoadCurrentModelAsync() => owner.LoadCurrentModelAsync();

        /// <inheritdoc />
        public void SetSelectedModel(string model) => owner._selectedModel = model;

        /// <inheritdoc />
        public void Notify() => owner.StateHasChanged();
    }

    private IModelSwitchHost? _modelSwitchHost;

    private IModelSwitchHost ModelSwitchHost => _modelSwitchHost ??= new ComponentModelSwitchHost(this);

    /// <summary>
    /// The PRODUCTION model-selection body, written against <see cref="IModelSwitchHost"/> so
    /// tests exercise this exact code rather than a re-implementation. A successful selection
    /// on a disconnected shell (first-connect) triggers history + current-model refresh so the
    /// restored thread shows immediately — no navigation.
    /// </summary>
    /// <param name="host">State seam the outcome is written to.</param>
    /// <param name="model">Model identifier to switch to.</param>
    /// <param name="reasoning">Reasoning effort to switch to.</param>
    internal static async Task HandleModelChangeCoreAsync(IModelSwitchHost host, string model, ReasoningEffort reasoning)
    {
        ArgumentNullException.ThrowIfNull(host);

        // Captured BEFORE the request: a successful first-selection connect (disconnected shell)
        // must refresh history + current model so the restored thread shows immediately.
        var wasDisconnected = !host.IsConnected;

        try
        {
            // The current reasoning selection travels with the new model — the facade requires
            // both and never infers reasoning from the model name.
            var result = await host.SwitchAsync(model, reasoning);
            if (result.Success)
            {
                host.SetSelectedModel(model);
                if (wasDisconnected)
                {
                    // First-connect: the switch connected the Composer (Slice 1A2b-1) and
                    // restored the session from disk. Load and display the restored history
                    // and refresh the current model so the thread shows immediately — no
                    // navigation required.
                    host.LoadHistory();
                    await host.LoadCurrentModelAsync();
                    // The view state flips to the connected layout (thread + controls) — the
                    // re-render also triggers the paste-module install (OnAfterRenderAsync).
                    host.Notify();
                }
            }
            else
            {
                Console.Error.WriteLine($"[ComposerChat] Model switch failed: {result.Error}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ComposerChat] Model switch failed: {ex.Message}");
        }
    }

    /// <summary>Runs the shared model-selection body against this component's own state.</summary>
    private Task HandleModelChange(ChangeEventArgs e)
    {
        if (e.Value is not string model || string.IsNullOrWhiteSpace(model)) return Task.CompletedTask;
        if (!_availableModels.Contains(model)) return Task.CompletedTask;

        return HandleModelChangeCoreAsync(ModelSwitchHost, model, _selectedReasoning);
    }

    private async Task HandleReasoningChange(ChangeEventArgs e)
    {
        if (e.Value is not string raw || string.IsNullOrWhiteSpace(raw)) return;

        ReasoningEffort newReasoning;
        try
        {
            newReasoning = ReasoningEffortConverter.Parse(raw)!.Value;
        }
        catch (ArgumentException)
        {
            return;
        }

        // Captured BEFORE the request so a rejected switch can restore exactly what was shown.
        var previous = _selectedReasoning;
        _selectedReasoning = newReasoning;

        try
        {
            var result = await ComposerFacade.SwitchModelAsync(
                _selectedModel, SwitchReasoningWireValue(newReasoning));
            _selectedReasoning = ResolveReasoningAfterSwitch(previous, newReasoning, result.Success);

            if (!result.Success)
            {
                Console.Error.WriteLine($"[ComposerChat] Reasoning switch failed: {result.Error}");
            }
        }
        catch (Exception ex)
        {
            _selectedReasoning = ResolveReasoningAfterSwitch(previous, newReasoning, succeeded: false);
            Console.Error.WriteLine($"[ComposerChat] Reasoning switch failed: {ex.Message}");
        }

        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .DisableHtml()
        .Build();

    private static string FormatContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return Markdown.ToHtml(content, MarkdownPipeline);
    }

    private static string FormatStreamingContent(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        return Markdown.ToHtml(content, MarkdownPipeline);
    }

    public async ValueTask DisposeAsync()
    {
        Composer.OnStreamingUpdate -= HandleStreamingUpdate;
        Composer.OnQuestionAsked -= HandleQuestionAsked;
        Composer.OnCompactingStarted -= HandleCompactingStarted;
        Composer.OnCompacted -= HandleCompacted;
        Composer.OnSubAgentChanged -= HandleSubAgentChanged;
        Composer.OnActiveInjection -= HandleActiveInjection;

        if (_pasteModule is not null)
        {
            // Independently attempted: an uninstall fault must not skip the module disposal.
            try
            {
                await _pasteModule.InvokeVoidAsync("uninstall");
            }
            catch (JSDisconnectedException)
            {
                // Circuit teardown / navigation: the browser is already gone — expected, not a fault.
            }
            catch (Exception ex)
            {
                // Never silently swallowed: re-throwing here would mask whatever triggered
                // disposal, so an unexpected teardown fault is surfaced in the logs instead.
                Console.Error.WriteLine($"[ComposerChat] Paste module uninstall failed: {ex.Message}");
            }

            try
            {
                await _pasteModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit teardown / navigation: the module reference dies with the circuit.
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[ComposerChat] Paste module disposal failed: {ex.Message}");
            }

            _pasteModule = null;
        }

        _pasteDotNetRef?.Dispose();
        _pasteDotNetRef = null;
    }

    private void HandleSubAgentChanged(SubAgentInfo info)
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleSubAgents()
    {
        _subAgentsExpanded = !_subAgentsExpanded;
    }

    private static string StatusBadge(SubAgentStatus status) => status switch
    {
        SubAgentStatus.Running => "⏳ Running",
        SubAgentStatus.Completed => "✅ Completed",
        SubAgentStatus.Failed => "❌ Failed",
        SubAgentStatus.TimedOut => "⏱️ Timed out",
        SubAgentStatus.Cancelled => "🚫 Cancelled",
        _ => throw new InvalidOperationException($"Unhandled sub-agent status '{status}'.")
    };

    /// <summary>
    /// Formats the elapsed time. Running entries measure from <c>StartedAt</c> to now (refreshed
    /// only when a status event arrives — there is no per-second timer); terminal entries measure
    /// to <c>CompletedAt</c> when available.
    /// </summary>
    private static string Elapsed(SubAgentInfo info)
    {
        var end = info.Status == SubAgentStatus.Running
            ? DateTimeOffset.UtcNow
            : info.CompletedAt;

        if (end is null) return "";

        var span = end.Value - info.StartedAt;
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;

        var totalMinutes = (int)span.TotalMinutes;
        return totalMinutes > 0
            ? $"{totalMinutes}m {span.Seconds}s"
            : $"{(int)span.TotalSeconds}s";
    }

    private void HandleCompactingStarted()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await SyncPasteAllowedAsync();
        });
    }

    private void HandleCompacted()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            await SyncPasteAllowedAsync();
        });
    }

    private void HandleQuestionAsked()
    {
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Raised when an active system notification was injected: reload history so the
    /// notification message appears in the chat, then re-render.
    /// </summary>
    private void HandleActiveInjection(string _)
    {
        InvokeAsync(async () =>
        {
            LoadHistory();
            StateHasChanged();
            await SyncPasteAllowedAsync();
        });
    }

    private void SelectSingle(string option)
    {
        _selectedOptions = [option];
    }

    private void ToggleOption(string option)
    {
        if (_selectedOptions.Contains(option))
            _selectedOptions.Remove(option);
        else
            _selectedOptions.Add(option);
    }

    private void SubmitYesNo(bool yes, ComposerQuestion question)
    {
        var answer = yes ? "Yes" : "No";
        if (!string.IsNullOrWhiteSpace(_questionFeedback))
            answer += $" — {_questionFeedback.Trim()}";

        _selectedOptions = [];
        _questionFeedback = "";
        Composer.SubmitAnswer(answer);
        StateHasChanged();
    }

    private void SubmitChoice(ComposerQuestion question)
    {
        var selected = string.Join(", ", _selectedOptions);
        var answer = string.IsNullOrWhiteSpace(_questionFeedback)
            ? selected
            : $"{selected} — {_questionFeedback.Trim()}";

        _selectedOptions = [];
        _questionFeedback = "";
        Composer.SubmitAnswer(answer);
        StateHasChanged();
    }

    private void CancelQuestion(ComposerQuestion question)
    {
        _selectedOptions = [];
        _questionFeedback = "";
        Composer.CancelQuestion();
        StateHasChanged();
    }

