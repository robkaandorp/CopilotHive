@page "/orchestrator"
@using System.Security.Claims
@using CopilotHive.Dashboard
@using CopilotHive.Goals
@using CopilotHive.Orchestration
@using CopilotHive.Services
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable
@* The dashboard state service is injected ONLY as the page's refresh EVENT SOURCE
   (OnStateChanged). Every operational READ and the one operational MUTATION go through the
   authorized IOperationalFacade below, which re-resolves this circuit user's current role/enabled
   state on every call. *@
@inject DashboardStateService State
@* THE AUTHORIZED OPERATIONAL BOUNDARY: shared-read projections (requires SharedRead) and the
   Brain session reset (requires ExecutionOperator). No direct DashboardStateService read/mutation
   and no direct LlmSessionRegistry.GetAll in this page. *@
@inject IOperationalFacade OperationalFacade
@* THE AUTHORIZED CLARIFICATION BOUNDARY: the page renders the PERSISTED clarification history
   (the durable records stored with the goal iterations), which is read through the shared-read
   facade operation — never straight from IGoalStore. The transient queue operations live on the
   same facade but are NOT what this page displays. *@
@inject IClarificationFacade ClarificationFacade
@inject IJSRuntime JS
@inject PageHeaderState PageHeader
@* The SCOPED per-circuit accessor, used by the single ComponentActingUser seam to obtain the
   identity handed to every facade call (and to initialise the accessor once per circuit). It is
   never captured by a singleton. *@
@inject CopilotHive.Security.CircuitUserPrincipalAccessor CircuitPrincipal

<div class="cards">
    <div class="card">
        <div class="label">Uptime</div>
        <div class="value" style="font-size:1rem">@FormatUptime(_info.Uptime)</div>
    </div>
    <div class="card">
        <div class="label">Version</div>
        <div class="value" style="font-size:1rem">@_info.Version</div>
    </div>
    <div class="card">
        <div class="label">SharpCoder</div>
        <div class="value" style="font-size:1rem">@(_info.SharpCoderVersion ?? "—")</div>
    </div>
    <div class="card">
        <div class="label">Server Time</div>
        <div class="value" style="font-size:1rem">@_info.ServerTime.ToString("HH:mm:ss") UTC</div>
    </div>
</div>

<h2 style="margin-top:1.5rem">Model Configuration</h2>
<table>
    <thead>
        <tr><th>Role</th><th>Model</th><th>Reasoning</th><th>Premium Model</th><th>Premium Reasoning</th></tr>
    </thead>
    <tbody>
        <tr>
            <td><span class="badge badge-yellow">brain</span></td>
            <td style="font-family:monospace;font-size:0.85rem">@_info.BrainModel</td>
            <td>@ReasoningEffortOptions.Label(_info.BrainReasoningEffort)</td>
            <td>—</td>
            <td>—</td>
        </tr>
        <tr>
            <td><span class="badge badge-yellow">composer</span></td>
            <td style="font-family:monospace;font-size:0.85rem">@_info.ComposerModel</td>
            <td>@ReasoningEffortOptions.Label(_info.ComposerReasoningEffort)</td>
            <td>—</td>
            <td>—</td>
        </tr>
        @foreach (var role in _info.RoleModels.Keys)
        {
            var roleKey = role.ToLowerInvariant();
            var premiumModel = _info.RolePremiumModels.GetValueOrDefault(roleKey);
            var hasPremium = !string.IsNullOrWhiteSpace(premiumModel);
            <tr>
                <td><span class="badge badge-blue">@role</span></td>
                <td style="font-family:monospace;font-size:0.85rem">@_info.RoleModels.GetValueOrDefault(roleKey)</td>
                <td>@ReasoningEffortOptions.Label(_info.RoleReasoningEfforts.GetValueOrDefault(roleKey))</td>
                <td style="font-family:monospace;font-size:0.85rem">@(hasPremium ? premiumModel : "—")</td>
                <td>@(hasPremium ? ReasoningEffortOptions.Label(_info.RolePremiumReasoningEfforts.GetValueOrDefault(roleKey)) : "—")</td>
            </tr>
        }
        <tr>
            <td><span class="badge badge-green">compaction</span></td>
            <td style="font-family:monospace;font-size:0.85rem">@(string.IsNullOrWhiteSpace(_info.CompactionModel) ? "(use main model)" : _info.CompactionModel)</td>
            <td>—</td>
            <td>—</td>
            <td>—</td>
        </tr>
    </tbody>
</table>

<h2 style="margin-top:1.5rem">Brain</h2>
@if (_stats is not null)
{
    <div class="cards">
        <div class="card">
            <div class="label">Context</div>
            <div class="value" style="color:@ContextColor">@FormatTokens(_stats.ContextTokens)</div>
            <div style="font-size:0.75rem;color:var(--text-muted)">
                @_stats.ContextUsagePercent% of @FormatTokens(_stats.MaxContextTokens)
            </div>
        </div>
        <div class="card">
            <div class="label">Messages</div>
            <div class="value">@_stats.MessageCount</div>
        </div>
        <div class="card">
            <div class="label">Max Steps</div>
            <div class="value">@_stats.MaxSteps</div>
        </div>
    </div>

    <div class="cards" style="margin-top:0.5rem">
        <div class="card">
            <div class="label">Cumulative Input</div>
            <div class="value" style="font-size:1rem">@FormatTokens(_stats.CumulativeInputTokens)</div>
        </div>
        <div class="card">
            <div class="label">Cumulative Output</div>
            <div class="value" style="font-size:1rem">@FormatTokens(_stats.CumulativeOutputTokens)</div>
        </div>
    </div>

    <div style="margin-top:1rem;background:var(--surface);border-radius:8px;padding:0.75rem 1rem">
        <div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:0.25rem">Context Usage</div>
        <div style="background:var(--bg);border-radius:4px;height:1.25rem;overflow:hidden">
            <div style="width:@(_stats.ContextUsagePercent)%;height:100%;background:@ContextColor;transition:width 0.3s"></div>
        </div>
    </div>

    <div style="margin-top:1rem">
        <button class="chat-action-btn chat-action-btn--danger" disabled="@_resettingBrain" @onclick="ResetBrainSessionAsync">
            @(_resettingBrain ? "⏳ Resetting…" : "🔄 Reset Brain Session")
        </button>
    </div>
}
else
{
    <p style="color:var(--text-muted)">Brain not connected.</p>
}

@* The per-user Composer usage section that used to live here is GONE, deliberately: Composer
   statistics (DashboardStateService.GetComposerStats) are a user's PRIVATE usage, so they are not
   part of any shared-read projection and this shared page must not read them directly from the
   trusted dashboard service. A user's own usage is rendered by the Composer's own per-circuit
   runtime binding (ComposerChat), which is private to that circuit. *@

@if (_llmSessions.Count > 0)
{
    <div class="card" style="margin-top:1rem">
        <h2 style="font-size:1rem;font-weight:600;margin-bottom:0.75rem">LLM Sessions</h2>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Goal</th>
                    <th>Model</th>
                    <th>Reasoning</th>
                    <th>Context</th>
                    <th>Status</th>
                    <th>Last Activity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var session in _llmSessions)
                {
                    <tr>
                        <td>@GetSessionTypeIcon(session.SessionType) @session.SessionType</td>
                        <td>
                            @if (session.GoalId is not null)
                            {
                                <a href="/goals/@session.GoalId" class="goal-link">@session.GoalId</a>
                            }
                            else
                            {
                                <span style="color:var(--text-muted)">—</span>
                            }
                        </td>
                        <td>@session.Model</td>
                        <td>@ReasoningEffortOptions.Label(session.ReasoningEffort)</td>
                        <td>
                            <div class="session-context-bar">
                                <div class="session-context-track">
                                    <div class="session-context-fill" style="width:@(session.ContextUsagePercent)%"></div>
                                </div>
                                <span style="font-size:0.8rem;color:var(--text-muted)">@session.ContextUsagePercent% (@FormatTokens(session.CurrentTokens)/@FormatTokens(session.MaxTokens))</span>
                            </div>
                        </td>
                        <td>@session.Status</td>
                        <td>@FormatLastActivity(session.LastActivity)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 style="margin-top:1.5rem">Clarifications</h2>

<div class="cards" style="margin-bottom:1rem">
    <div class="card">
        <div class="label">Total</div>
        <div class="value">@_clarifications.Count</div>
    </div>
    <div class="card">
        <div class="label">Brain</div>
        <div class="value" style="color:var(--accent)">@_clarifications.Count(c => string.Equals(c.Clarification.AnsweredBy, "brain", StringComparison.OrdinalIgnoreCase))</div>
    </div>
    <div class="card">
        <div class="label">Composer</div>
        <div class="value" style="color:var(--yellow)">@_clarifications.Count(c => string.Equals(c.Clarification.AnsweredBy, "composer", StringComparison.OrdinalIgnoreCase))</div>
    </div>
    <div class="card">
        <div class="label">Human</div>
        <div class="value" style="color:var(--green)">@_clarifications.Count(c => string.Equals(c.Clarification.AnsweredBy, "human", StringComparison.OrdinalIgnoreCase))</div>
    </div>
    <div class="card">
        <div class="label">Timeout</div>
        <div class="value" style="color:var(--red)">@_clarifications.Count(c => string.Equals(c.Clarification.AnsweredBy, "timeout", StringComparison.OrdinalIgnoreCase))</div>
    </div>
</div>

@if (_clarifications.Count == 0)
{
    <p style="color:var(--text-muted)">No clarifications recorded yet.</p>
}
else
{
    <div style="overflow-x:auto">
        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Goal</th>
                    <th>Phase</th>
                    <th>Question</th>
                    <th>Answered By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var (goalId, clarif) in _clarifications.Take(10))
                {
                    <tr>
                        <td style="white-space:nowrap;font-size:0.8rem;color:var(--text-muted)">
                            @clarif.Timestamp.ToString("yyyy-MM-dd HH:mm")
                        </td>
                        <td style="font-size:0.85rem">
                            <a href="/goals/@goalId" style="color:var(--accent);text-decoration:none">@goalId</a>
                        </td>
                        <td style="font-size:0.85rem">@clarif.Phase</td>
                        <td style="font-size:0.85rem;max-width:420px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"
                            title="@clarif.Question">
                            @(clarif.Question.Length > 80 ? clarif.Question[..80] + "…" : clarif.Question)
                        </td>
                        <td>
                            <span class="badge @AnsweredByBadgeClass(clarif.AnsweredBy)">@clarif.AnsweredBy</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private BrainStats? _stats;
    private OrchestratorInfo _info = new();
    private bool _resettingBrain;
    private IReadOnlyList<(string GoalId, PersistedClarification Clarification)> _clarifications = [];

    /// <summary>
    /// Monotonic generation of the persisted-clarification read most recently STARTED. Only the newest
    /// read may publish <c>_clarifications</c>, so a held older result can never restore history that
    /// a newer (for example Forbidden) refresh already cleared.
    /// </summary>
    private int _clarificationGeneration;
    private List<CopilotHive.Dashboard.LlmSessionInfo> _llmSessions = [];

    /// <summary>
    /// The circuit's cascading authentication state, handed to every identity-aware facade call.
    /// ABSENT in open mode — <c>Program.cs</c> registers <c>AddCascadingAuthenticationState</c> only
    /// when authentication is enabled — in which case no cascade arrives, the helper yields a null
    /// identity and the resolver answers with the open-mode local operator (which holds every
    /// capability), so the legacy single-operator installation is unchanged and nothing throws.
    /// </summary>
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>
    /// The identity to hand to one identity-aware facade call: this circuit's authenticated
    /// principal, or null when no cascade exists (open mode / signed out). It is an IDENTITY only —
    /// the facade re-resolves current role/enabled state on every operation, so a demoted, disabled
    /// or deleted account is refused on its very next call. This is also the page's MINIMAL circuit
    /// identity acquisition: the scoped
    /// <see cref="CopilotHive.Security.CircuitUserPrincipalAccessor"/> is initialised from the same
    /// cascading state exactly once per circuit.
    /// </summary>
    private ValueTask<ClaimsPrincipal?> ActingUserAsync() =>
        ComponentActingUser.AcquireAsync(AuthenticationState, CircuitPrincipal);

    protected override async Task OnInitializedAsync()
    {
        PageHeader.SetTitle("🎵 Orchestrator");

        // AUTHORIZED SHARED READS: the Brain stats, the orchestrator info, the sanitized
        // non-Composer session list and the persisted clarification history all come from the
        // authorized facades, which re-resolve this circuit user's CURRENT role/enabled state on
        // every call and require shared read. A denial leaves the page's EXISTING surfaces in place
        // ("Brain not connected.", no session table) rather than throwing out of the renderer;
        // denial UI is a separate phase.
        await RefreshAsync();
        State.OnStateChanged += RefreshState;
    }

    /// <summary>
    /// Re-reads every operational projection through the authorized facades.
    /// <para>
    /// A DENIED reflection CLEARS its field. Each of these fields was populated by an AUTHORIZED
    /// read, so a later refresh that the facade now refuses (the account was disabled or demoted
    /// between two renders) must not keep showing the earlier projection: the page re-renders as if
    /// it had never read anything, exactly like a first render for an unauthorized caller. Every
    /// facade-populated projection field below is therefore assigned on BOTH outcomes — the success
    /// value, or the empty/absent state — rather than only on success.
    /// </para>
    /// <para>
    /// The PERSISTED CLARIFICATION HISTORY is part of this refresh (and therefore of every reset /
    /// event notification that reaches <see cref="RefreshState"/>), not just of the first render: it
    /// is a facade-populated projection like the others, so a later SharedRead denial must clear it
    /// and a later authorized refresh must repopulate it.
    /// </para>
    /// </summary>
    private async Task RefreshAsync()
    {
        var brain = await OperationalFacade.GetBrainStatsAsync(
            await ActingUserAsync(), CancellationToken.None);
        _stats = brain.Success ? brain.Value : null;

        var info = await OperationalFacade.GetOrchestratorInfoAsync(
            await ActingUserAsync(), CancellationToken.None);
        _info = info.Success && info.Value is not null ? info.Value : new OrchestratorInfo();

        var sessions = await OperationalFacade.GetSharedLlmSessionsAsync(
            await ActingUserAsync(), CancellationToken.None);
        _llmSessions = sessions.Success && sessions.Value is not null
            ? sessions.Value.OrderByDescending(s => s.LastActivity).ToList()
            : [];

        // PERSISTED CLARIFICATION HISTORY, through the SINGLE new authorized facade operation:
        // authorization runs first inside the facade, so a caller without SharedRead never reaches
        // the goal store. Assigned on BOTH outcomes — "No clarifications recorded yet." on a
        // refusal, exactly like a first render for an unauthorized caller.
        //
        // PUBLICATION ORDER: the generation is taken when THIS read starts and the result is published
        // only while it is still the newest. A refresh that started later has already published (or
        // will publish) fresher state, so an older read that completes afterwards — including an older
        // AUTHORIZED result completing after a newer Forbidden refresh cleared the history — must not
        // overwrite it. Scoped to this projection only.
        var generation = ++_clarificationGeneration;
        var clarifications = await ClarificationFacade.GetPersistedHistoryAsync(
            await ActingUserAsync(), CancellationToken.None);
        if (generation != _clarificationGeneration)
            return;

        _clarifications = clarifications.Success && clarifications.Value is not null
            ? clarifications.Value
            : [];
    }

    private void RefreshState() => InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    private string ContextColor => _stats?.ContextUsagePercent switch
    {
        >= 80 => "var(--red)",
        >= 50 => "var(--accent)",
        _ => "var(--green)",
    };

    private static string FormatTokens(long tokens) => tokens switch
    {
        >= 1_000_000 => $"{(tokens / 1_000_000.0).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}M",
        >= 1_000 => $"{(tokens / 1_000.0).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}k",
        _ => tokens.ToString(System.Globalization.CultureInfo.InvariantCulture),
    };

    private static string FormatUptime(TimeSpan ts) => ts.TotalHours >= 1
        ? $"{(int)ts.TotalHours}h {ts.Minutes}m {ts.Seconds}s"
        : $"{ts.Minutes}m {ts.Seconds}s";

    private static string GetSessionTypeIcon(LlmSessionType type) => type switch
    {
        LlmSessionType.Brain => "🎵",
        LlmSessionType.BrainGoal => "🎵",
        LlmSessionType.Composer => "💬",
        LlmSessionType.GoalReview => "🔍",
        _ => "💬"
    };

    private static string FormatLastActivity(DateTime lastActivity)
    {
        var ago = DateTime.UtcNow - lastActivity;
        if (ago.TotalSeconds < 60) return $"{(int)ago.TotalSeconds}s ago";
        if (ago.TotalMinutes < 60) return $"{(int)ago.TotalMinutes}m ago";
        return $"{(int)ago.TotalHours}h ago";
    }

    public void Dispose() => State.OnStateChanged -= RefreshState;

    private static string AnsweredByBadgeClass(string answeredBy) => answeredBy.ToLowerInvariant() switch
    {
        "brain" => "badge-blue",
        "composer" => "badge-yellow",
        "human" => "badge-green",
        "timeout" => "badge-red",
        _ => "badge-muted",
    };

    private async Task ResetBrainSessionAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "Are you sure you want to reset the Brain session? This clears the master Brain conversation and reloads the system prompt from the current orchestrator.agents.md content. Goals already in progress keep their own sessions and are not affected — the reset applies to goals started afterwards.");
        if (!confirmed)
            return;

        _resettingBrain = true;
        StateHasChanged();
        try
        {
            // AUTHORIZED MUTATION: the reset goes through IOperationalFacade, which re-resolves this
            // circuit user's CURRENT role/enabled state and requires ExecutionOperator BEFORE the
            // Brain is touched — so a Viewer, a Member, a disabled or an unknown account is refused
            // here and the master session is left alone. The confirm flow, the busy state and the
            // refresh are unchanged from the direct-service version; deliberately no new denial UI in
            // this slice (a refusal simply leaves the session untouched and the page re-reads the
            // unchanged state through the same authorized projections).
            await OperationalFacade.ResetBrainSessionAsync(
                await ActingUserAsync(), CancellationToken.None);
            await RefreshAsync();
        }
        finally
        {
            _resettingBrain = false;
            StateHasChanged();
        }
    }
}
